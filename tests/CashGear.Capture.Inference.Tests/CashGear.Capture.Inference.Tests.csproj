<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(CashGearWindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(CashGearMinWindowsVersion)</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CashGear.Capture.Inference\CashGear.Capture.Inference.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!-- The person-finder model for the tests (tools\get-inference-models.ps1); the tests that need it skip otherwise. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\tools\inference')">
    <None Include="$(MSBuildThisFileDirectory)..\..\tools\inference\*" Link="models\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\MachineTurn.cs" Link="MachineTurn.cs" />
  </ItemGroup>

</Project>
