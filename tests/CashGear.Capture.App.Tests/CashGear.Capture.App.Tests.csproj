<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(CashGearWindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(CashGearMinWindowsVersion)</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Same PerMonitorV2 manifest as the app: overlay geometry is only meaningful in physical pixels. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CashGear.Capture.App\CashGear.Capture.App.csproj" />
    <ProjectReference Include="..\..\src\CashGear.Capture.Core\CashGear.Capture.Core.csproj" />
    <ProjectReference Include="..\..\src\CashGear.Capture.Engine\CashGear.Capture.Engine.csproj" />
    <ProjectReference Include="..\..\src\CashGear.Capture.Interop\CashGear.Capture.Interop.csproj" />
    <ProjectReference Include="..\..\src\CashGear.Capture.Recording\CashGear.Capture.Recording.csproj" />
  </ItemGroup>

  <!-- The recording tests run the real ffmpeg when tools\ffmpeg\legacy has it (they skip otherwise). -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\tools\ffmpeg\legacy\ffmpeg.exe')">
    <None Include="$(MSBuildThisFileDirectory)..\..\tools\ffmpeg\legacy\*" Link="ffmpeg\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\CashGear.Capture.Engine.Tests\InteractiveDesktop.cs" Link="InteractiveDesktop.cs" />
    <Compile Include="..\CashGear.Capture.Engine.Tests\Capture\Fakes.cs" Link="Capture\EngineFakes.cs" />
    <Compile Include="..\CashGear.Capture.Core.Tests\Stitching\SyntheticPage.cs" Link="Scrolling\SyntheticPage.cs" />
  </ItemGroup>

</Project>
