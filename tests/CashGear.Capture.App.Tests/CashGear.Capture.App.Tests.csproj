<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(CashGearWindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(CashGearMinWindowsVersion)</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Same PerMonitorV2 manifest as the app: overlay geometry is only meaningful in physical pixels. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CashGear.Capture.App\CashGear.Capture.App.csproj" />
    <ProjectReference Include="..\..\src\CashGear.Capture.Core\CashGear.Capture.Core.csproj" />
    <ProjectReference Include="..\..\src\CashGear.Capture.Engine\CashGear.Capture.Engine.csproj" />
    <ProjectReference Include="..\..\src\CashGear.Capture.Interop\CashGear.Capture.Interop.csproj" />
    <ProjectReference Include="..\..\src\CashGear.Capture.Outputs\CashGear.Capture.Outputs.csproj" />
    <ProjectReference Include="..\..\src\CashGear.Capture.Recording\CashGear.Capture.Recording.csproj" />
  </ItemGroup>

  <!-- The recording tests use the real FFmpeg libraries (and ffmpeg.exe / ffprobe.exe from the same build to check the files) when tools\ffmpeg has them; they skip otherwise. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\tools\ffmpeg\avcodec-63.dll')">
    <None Include="$(MSBuildThisFileDirectory)..\..\tools\ffmpeg\*" Link="ffmpeg\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\CashGear.Capture.Engine.Tests\InteractiveDesktop.cs" Link="InteractiveDesktop.cs" />
    <Compile Include="..\CashGear.Capture.Engine.Tests\Capture\Fakes.cs" Link="Capture\EngineFakes.cs" />
    <Compile Include="..\CashGear.Capture.Core.Tests\Stitching\SyntheticPage.cs" Link="Scrolling\SyntheticPage.cs" />
    <Compile Include="..\CashGear.Capture.Media.Tests\SyntheticRecording.cs" Link="Recording\SyntheticRecording.cs" />
    <Compile Include="..\CashGear.Capture.Media.Tests\TestMedia.cs" Link="Recording\TestMedia.cs" />
    <Compile Include="..\CashGear.Capture.Media.Tests\StampedRecording.cs" Link="VideoEditor\StampedRecording.cs" />
    <Compile Include="..\CashGear.Capture.Media.Tests\GifProbe.cs" Link="VideoEditor\GifProbe.cs" />
    <Compile Include="..\CashGear.Capture.Overlays.Tests\TestInput.cs" Link="Recording\TestInput.cs" />
  </ItemGroup>

  <!-- Noise suppression loads RNNoise from rnnoise\ next to the app (BSD-3-Clause; built from the pinned source by tools\get-rnnoise.ps1). Without it there is no noise suppression. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\tools\rnnoise\rnnoise.dll')">
    <None Include="$(MSBuildThisFileDirectory)..\..\tools\rnnoise\rnnoise.dll;$(MSBuildThisFileDirectory)..\..\tools\rnnoise\COPYING" Link="rnnoise\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
