<Project Sdk="Microsoft.NET.Sdk">

  <!-- Checks a real Velopack update end to end on portable copies (see Program.cs). Never shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(CashGearWindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(CashGearMinWindowsVersion)</SupportedOSPlatformVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" />
  </ItemGroup>

</Project>
