<Project Sdk="Microsoft.NET.Sdk">

  <!-- The recording acceptance test: flashes and beeps on a shared schedule while the real recorder records, then measures sync, drift and CPU in the file. See docs\TESTING.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(CashGearWindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(CashGearMinWindowsVersion)</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="NAudio.Wasapi" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CashGear.Capture.Core\CashGear.Capture.Core.csproj" />
    <ProjectReference Include="..\..\src\CashGear.Capture.Engine\CashGear.Capture.Engine.csproj" />
    <ProjectReference Include="..\..\src\CashGear.Capture.Media\CashGear.Capture.Media.csproj" />
    <ProjectReference Include="..\..\src\CashGear.Capture.Recording\CashGear.Capture.Recording.csproj" />
  </ItemGroup>

  <!-- The same FFmpeg libraries the app ships. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\ffmpeg\avcodec-63.dll')">
    <None Include="$(MSBuildThisFileDirectory)..\ffmpeg\avutil-*.dll;$(MSBuildThisFileDirectory)..\ffmpeg\swresample-*.dll;$(MSBuildThisFileDirectory)..\ffmpeg\swscale-*.dll;$(MSBuildThisFileDirectory)..\ffmpeg\avcodec-*.dll;$(MSBuildThisFileDirectory)..\ffmpeg\avformat-*.dll;$(MSBuildThisFileDirectory)..\ffmpeg\avfilter-*.dll" Link="ffmpeg\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
