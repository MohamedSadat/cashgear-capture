<Project Sdk="Microsoft.NET.Sdk">

  <!-- The timeline video editor's core: the project (an edit list saved as .cgcap), undo, the preview's decoding and playback, the Skia compositor shared by the preview and the export, and the export itself. No WPF: the window lives in App. -->
  <PropertyGroup>
    <TargetFramework>$(CashGearWindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(CashGearMinWindowsVersion)</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="NAudio.Wasapi" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CashGear.Capture.Core\CashGear.Capture.Core.csproj" />
    <ProjectReference Include="..\CashGear.Capture.Editor\CashGear.Capture.Editor.csproj" />
    <ProjectReference Include="..\CashGear.Capture.Media\CashGear.Capture.Media.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CashGear.Capture.VideoEditor.Tests" />
    <InternalsVisibleTo Include="CashGear.Capture.App" />
    <InternalsVisibleTo Include="CashGear.Capture.App.Tests" />
  </ItemGroup>

</Project>
