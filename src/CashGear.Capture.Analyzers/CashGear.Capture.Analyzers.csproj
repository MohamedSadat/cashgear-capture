<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Build-time only: never shipped. Every project under src\ gets it as an analyzer (Directory.Build.props):
    - ResxGenerator turns each .resx into a class of string properties (and methods for strings with placeholders or
      plural forms), and checks every translation against it.
    - HardCodedTextAnalyzer (CG0001) and XamlTextAnalyzer (CG0002) report user-visible text that isn't in a .resx.
    See docs\localization.md.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Release-tracking files (RS2008) are for analyzers published as packages. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CashGear.Capture.Analyzers.Tests" />
  </ItemGroup>

</Project>
