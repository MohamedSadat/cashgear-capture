<Project Sdk="Microsoft.NET.Sdk">

  <!-- Screen recording: a continuous Windows.Graphics.Capture session feeding raw frames to ffmpeg. -->
  <PropertyGroup>
    <TargetFramework>$(CashGearWindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(CashGearMinWindowsVersion)</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CashGear.Capture.Core\CashGear.Capture.Core.csproj" />
    <ProjectReference Include="..\CashGear.Capture.Engine\CashGear.Capture.Engine.csproj" />
    <ProjectReference Include="..\CashGear.Capture.Interop\CashGear.Capture.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CashGear.Capture.App.Tests" />
  </ItemGroup>

</Project>
