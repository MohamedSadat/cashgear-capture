<Project Sdk="Microsoft.NET.Sdk">

  <!-- Sound devices: WASAPI capture (NAudio's Core Audio interop) with the timestamps Windows gives each packet. No WPF here. -->
  <PropertyGroup>
    <TargetFramework>$(CashGearWindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(CashGearMinWindowsVersion)</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="NAudio.Wasapi" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CashGear.Capture.Core\CashGear.Capture.Core.csproj" />
    <ProjectReference Include="..\CashGear.Capture.Interop\CashGear.Capture.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CashGear.Capture.Recording" />
    <InternalsVisibleTo Include="CashGear.Capture.Audio.Tests" />
    <InternalsVisibleTo Include="CashGear.Capture.App.Tests" />
  </ItemGroup>

</Project>
