<Window x:Class="CashGear.Capture.App.Output.BackgroundWorkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:CashGear.Capture.App.Platform"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CashGear.Capture.App.Output"
        xmlns:r="clr-namespace:CashGear.Capture.App.Resources"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:BackgroundWorkViewModel}"
        Title="{x:Static r:SharingText.BackgroundTitle}"
        Width="620" Height="420" MinWidth="420" MinHeight="240"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
  </Window.Resources>
  <!-- Tab goes through each line's buttons; Esc closes (the uploads go on). -->
  <DockPanel Margin="16">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <Button DockPanel.Dock="Right" Content="{x:Static r:SharingText.ClearEnded}" Command="{Binding ClearEndedCommand}" />
      <TextBlock Text="{Binding SummaryText}" VerticalAlignment="Center" p:LiveText.IsLive="True" />
    </DockPanel>
    <Grid>
      <TextBlock Text="{x:Static r:SharingText.EmptyList}" Opacity="0.75" TextWrapping="Wrap"
                 Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
      <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" AutomationProperties.Name="{x:Static r:SharingText.BackgroundTitle}">
          <ItemsControl.ItemContainerStyle>
            <Style TargetType="ContentPresenter">
              <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
            </Style>
          </ItemsControl.ItemContainerStyle>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type local:BackgroundRow}">
              <Border BorderThickness="0,0,0,1" BorderBrush="{p:Chrome Separator}" Padding="0,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                      <Run Text="{x:Static r:SharingText.RowArrow}" />
                      <Run Text="{Binding Where, Mode=OneWay}" />
                    </TextBlock>
                    <ProgressBar Height="6" Margin="0,5" Minimum="0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}" IsIndeterminate="{Binding IsUnknown}"
                                 Visibility="{Binding CanCancel, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding AccessibleName}" />
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Failed}" Value="True">
                              <Setter Property="Foreground" Value="{p:Chrome Error}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="{x:Static r:SharingText.OpenLink}" Command="{Binding OpenLinkCommand}" Margin="4,0,0,0" Visibility="{Binding HasLink, Converter={StaticResource Visible}}"
                            AutomationProperties.HelpText="{Binding AccessibleName}" />
                    <Button Content="{x:Static r:SharingText.CopyLink}" Command="{Binding CopyLinkCommand}" Margin="4,0,0,0" Visibility="{Binding HasLink, Converter={StaticResource Visible}}"
                            AutomationProperties.HelpText="{Binding AccessibleName}" />
                    <Button Content="{x:Static r:SharingText.ShowFile}" Command="{Binding ShowFileCommand}" Margin="4,0,0,0" Visibility="{Binding HasFile, Converter={StaticResource Visible}}"
                            AutomationProperties.HelpText="{Binding AccessibleName}" />
                    <Button Content="{x:Static r:SharingText.Retry}" Command="{Binding RetryCommand}" Margin="4,0,0,0" Visibility="{Binding CanRetry, Converter={StaticResource Visible}}"
                            AutomationProperties.HelpText="{Binding AccessibleName}" />
                    <Button Content="{x:Static r:CommonText.Cancel}" Command="{Binding CancelCommand}" Margin="4,0,0,0" Visibility="{Binding CanCancel, Converter={StaticResource Visible}}"
                            AutomationProperties.HelpText="{Binding AccessibleName}" />
                    <Button Content="{x:Static r:SharingText.Remove}" Command="{Binding RemoveCommand}" Margin="4,0,0,0" Visibility="{Binding CanRemove, Converter={StaticResource Visible}}"
                            AutomationProperties.HelpText="{Binding AccessibleName}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
