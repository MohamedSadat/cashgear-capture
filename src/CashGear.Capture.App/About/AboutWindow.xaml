<Window x:Class="CashGear.Capture.App.About.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:CashGear.Capture.App.Platform"
        xmlns:r="clr-namespace:CashGear.Capture.App.Resources"
        Title="{x:Static r:AboutText.WindowTitle}" Icon="/CashGear.Capture.App;component/Assets/app.ico"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
  <StackPanel Width="320" Margin="24">
    <Image Width="48" Height="48" FlowDirection="LeftToRight"
           Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}" />
    <TextBlock Text="{x:Static r:CommonText.ProductName}" FontSize="20" FontWeight="SemiBold"
               TextAlignment="Center" Margin="0,12,0,8" FlowDirection="LeftToRight" />
    <TextBlock Text="{Binding Source={x:Static p:BuildInfo.Version}, StringFormat={x:Static r:AboutText.VersionFormat}}"
               TextAlignment="Center" FlowDirection="LeftToRight" />
    <TextBlock TextAlignment="Center" Margin="0,12,0,0" FlowDirection="LeftToRight">
      <Hyperlink NavigateUri="https://www.cashgearerp.com" RequestNavigate="OnWebsiteNavigate"
                 AutomationProperties.Name="{x:Static r:AboutText.Website}">
        <Run Text="{x:Static r:AboutText.Website}" />
      </Hyperlink>
    </TextBlock>
    <Button x:Name="CloseButton" Content="{x:Static r:CommonText.Close}" MinWidth="90"
            HorizontalAlignment="Right" Margin="0,24,0,0" IsDefault="True" IsCancel="True" Click="OnCloseClick" />
  </StackPanel>
</Window>
