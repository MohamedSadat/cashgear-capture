<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(CashGearWindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(CashGearMinWindowsVersion)</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyTitle>CashGear Capture</AssemblyTitle>
    <!-- Pinning pooled pixel buffers when handing them to WIC. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Program.Main owns startup (host first, then WPF), so App.xaml is compiled as a Page, not an ApplicationDefinition. -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <StartupObject>CashGear.Capture.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="SkiaSharp.Views.WPF" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <!-- The packaging script passes the release feed the installed app checks for updates (empty: none). -->
  <ItemGroup Condition="'$(UpdateFeedUrl)' != ''">
    <AssemblyMetadata Include="UpdateFeedUrl" Value="$(UpdateFeedUrl)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CashGear.Capture.App.Tests" />
  </ItemGroup>

  <!-- Screen recording loads FFmpeg's libraries from ffmpeg\ next to the app (an LGPL build; see docs\LICENSES.md). tools\get-ffmpeg.ps1 puts the pinned build in tools\ffmpeg; only the six libraries the app uses ship (avfilter evens out loudness), with the licence. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\tools\ffmpeg\avcodec-63.dll')">
    <None Include="$(MSBuildThisFileDirectory)..\..\tools\ffmpeg\avutil-*.dll;$(MSBuildThisFileDirectory)..\..\tools\ffmpeg\swresample-*.dll;$(MSBuildThisFileDirectory)..\..\tools\ffmpeg\swscale-*.dll;$(MSBuildThisFileDirectory)..\..\tools\ffmpeg\avcodec-*.dll;$(MSBuildThisFileDirectory)..\..\tools\ffmpeg\avformat-*.dll;$(MSBuildThisFileDirectory)..\..\tools\ffmpeg\avfilter-*.dll;$(MSBuildThisFileDirectory)..\..\tools\ffmpeg\LICENSE.txt;$(MSBuildThisFileDirectory)..\..\tools\licenses\COPYING.GPLv3" Link="ffmpeg\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CashGear.Capture.Core\CashGear.Capture.Core.csproj" />
    <ProjectReference Include="..\CashGear.Capture.Editor\CashGear.Capture.Editor.csproj" />
    <ProjectReference Include="..\CashGear.Capture.Recording\CashGear.Capture.Recording.csproj" />
    <ProjectReference Include="..\CashGear.Capture.Engine\CashGear.Capture.Engine.csproj" />
    <ProjectReference Include="..\CashGear.Capture.Interop\CashGear.Capture.Interop.csproj" />
    <ProjectReference Include="..\CashGear.Capture.Overlays\CashGear.Capture.Overlays.csproj" />
  </ItemGroup>

  <!-- Noise suppression loads RNNoise from rnnoise\ next to the app (BSD-3-Clause; built from the pinned source by tools\get-rnnoise.ps1). Without it there is no noise suppression. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\tools\rnnoise\rnnoise.dll')">
    <None Include="$(MSBuildThisFileDirectory)..\..\tools\rnnoise\rnnoise.dll;$(MSBuildThisFileDirectory)..\..\tools\rnnoise\COPYING" Link="rnnoise\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
