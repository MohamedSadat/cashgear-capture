<Window x:Class="CashGear.Capture.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CashGear.Capture.App.Settings"
        xmlns:wpf="clr-namespace:CashGear.Capture.App.Wpf"
        xmlns:editor="clr-namespace:CashGear.Capture.App.Editor"
        xmlns:r="clr-namespace:CashGear.Capture.App.Resources"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:SettingsViewModel}"
        Title="{x:Static r:SettingsText.WindowTitle}"
        Width="680" Height="600" MinWidth="560" MinHeight="500"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <local:EnumLabelConverter x:Key="Label" />
    <DataTemplate x:Key="EnumItem">
      <TextBlock Text="{Binding Converter={StaticResource Label}}" />
    </DataTemplate>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Margin" Value="0,12,0,6" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,3,8,3" />
    </Style>
    <editor:NullToVisibilityConverter x:Key="VisibleIfSet" />

    <!-- A workflow: its steps in order (on or off, up, down, remove) and a step to add. -->
    <DataTemplate x:Key="WorkflowList" DataType="{x:Type local:WorkflowListViewModel}">
      <StackPanel>
        <ItemsControl ItemsSource="{Binding Steps}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type local:WorkflowStepRow}">
              <DockPanel Margin="0,1">
                <DockPanel.Style>
                  <Style TargetType="DockPanel">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsMissing}" Value="True">
                        <Setter Property="Opacity" Value="0.6" />
                        <Setter Property="ToolTip" Value="{x:Static r:SettingsText.StepMissingTip}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DockPanel.Style>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Content="↑" ToolTip="{x:Static r:SettingsText.StepEarlier}" MinWidth="28" Margin="4,0,0,0" AutomationProperties.Name="{x:Static r:SettingsText.MoveUp}"
                          Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                  <Button Content="↓" ToolTip="{x:Static r:SettingsText.StepLater}" MinWidth="28" Margin="4,0,0,0" AutomationProperties.Name="{x:Static r:SettingsText.MoveDown}"
                          Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                  <Button Content="✕" ToolTip="{x:Static r:SettingsText.RemoveStep}" MinWidth="28" Margin="4,0,0,0" AutomationProperties.Name="{x:Static r:CommonText.Remove}"
                          Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                </StackPanel>
                <CheckBox IsChecked="{Binding Enabled}" Content="{Binding Name}" VerticalAlignment="Center" />
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <ComboBox ItemsSource="{Binding Addable}" SelectedItem="{Binding ToAdd}" MinWidth="240" AutomationProperties.Name="{x:Static r:SettingsText.StepToAdd}" />
          <Button Content="{x:Static r:SettingsText.AddStep}" Command="{Binding AddCommand}" Margin="8,0,0,0" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <!-- A destination's Test button and what it found. -->
    <DataTemplate x:Key="TestRow" DataType="{x:Type local:TestableViewModel}">
      <DockPanel Margin="0,6,0,0">
        <Button DockPanel.Dock="Left" Content="{x:Static r:CommonText.Test}" Command="{Binding TestCommand}" MinWidth="80" VerticalAlignment="Top"
                ToolTip="{x:Static r:DestinationsText.TestTip}" />
        <TextBlock Text="{Binding TestStatus}" TextWrapping="Wrap" Margin="10,2,0,0">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Style.Triggers>
                <DataTrigger Binding="{Binding TestFailed}" Value="True">
                  <Setter Property="Foreground" Value="#D13438" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </DockPanel>
    </DataTemplate>

    <!-- Word or PowerPoint: a new file each time, or added to one. -->
    <DataTemplate x:Key="OfficeEditor" DataType="{x:Type local:OfficeViewModel}">
      <StackPanel>
        <RadioButton Margin="0,2" IsChecked="{Binding Append, Converter={x:Static local:InverseBooleanConverter.Instance}}">
          <TextBlock Text="{Binding App, Mode=OneWay, StringFormat={x:Static r:DestinationsText.NewFileEachCaptureFormat}}" />
        </RadioButton>
        <RadioButton Margin="0,2" Content="{x:Static r:DestinationsText.AppendToFile}" IsChecked="{Binding Append}" />
        <DockPanel Margin="20,2,0,0" IsEnabled="{Binding Append}">
          <Button DockPanel.Dock="Right" Content="{x:Static r:CommonText.Browse}" Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
          <TextBox Text="{Binding AppendPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:DestinationsText.AppendFileName}" />
        </DockPanel>
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TestRow}" Focusable="False" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <DockPanel Margin="16">
    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Button Content="{x:Static r:SettingsText.ResetToDefaults}" Command="{Binding ResetToDefaultsCommand}" HorizontalAlignment="Left" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="{x:Static r:CommonText.Ok}" IsDefault="True" Command="{Binding SaveCommand}" MinWidth="90" Margin="0,0,8,0" />
        <Button Content="{x:Static r:CommonText.Cancel}" IsCancel="True" Command="{Binding CancelCommand}" MinWidth="90" Margin="0,0,8,0" />
        <Button Content="{x:Static r:CommonText.Apply}" Command="{Binding ApplyCommand}" MinWidth="90" />
      </StackPanel>
    </Grid>

    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Errors}" Foreground="#D13438" TextWrapping="Wrap" Margin="0,10,0,0"
               Visibility="{Binding HasErrors, Converter={StaticResource Visible}}" />

    <TabControl x:Name="Tabs" SelectionChanged="OnTabChanged">
      <!-- ============================== Output ============================== -->
      <TabItem Header="{x:Static r:SettingsText.OutputTab}" x:Name="OutputTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12,4,12,12">
            <TextBlock Style="{StaticResource Section}" Text="{x:Static r:SettingsText.AfterCaptureSection}" />
            <ContentControl Content="{Binding CaptureWorkflow}" ContentTemplate="{StaticResource WorkflowList}" Focusable="False" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="{x:Static r:SettingsText.AfterCaptureHint}" />

            <TextBlock Style="{StaticResource Section}" Text="{x:Static r:SettingsText.AfterRecordingSection}" />
            <ContentControl Content="{Binding RecordingWorkflow}" ContentTemplate="{StaticResource WorkflowList}" Focusable="False" />
            <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:SettingsText.AfterRecordingHint}" />

            <TextBlock Style="{StaticResource Section}" Text="{x:Static r:SettingsText.FolderSection}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="FolderBox" Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:SettingsText.CaptureFolder}" />
              <Button Grid.Column="1" Content="{x:Static r:CommonText.Browse}" Command="{Binding BrowseFolderCommand}" Margin="8,0,0,0" />
              <Button Grid.Column="2" Content="{x:Static r:CommonText.Open}" Command="{Binding OpenCaptureFolderCommand}" Margin="8,0,0,0" />
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Text="{Binding DefaultFolder, Mode=OneWay, StringFormat={x:Static r:SettingsText.DefaultFolderFormat}}" />

            <TextBlock Style="{StaticResource Section}" Text="{x:Static r:SettingsText.FormatSection}" />
            <StackPanel Orientation="Horizontal">
              <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}" ItemTemplate="{StaticResource EnumItem}" MinWidth="160"
                        AutomationProperties.Name="{x:Static r:SettingsText.ImageFormat}" />
              <TextBlock Text="{x:Static r:SettingsText.JpegQuality}" VerticalAlignment="Center" Margin="20,0,8,0"
                         Visibility="{Binding IsJpeg, Converter={StaticResource Visible}}" />
              <Slider Minimum="1" Maximum="100" Value="{Binding JpegQuality}" Width="160" VerticalAlignment="Center"
                      IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.Name="{x:Static r:SettingsText.JpegQuality}"
                      Visibility="{Binding IsJpeg, Converter={StaticResource Visible}}" />
              <TextBlock Text="{Binding JpegQuality}" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="28"
                         Visibility="{Binding IsJpeg, Converter={StaticResource Visible}}" />
            </StackPanel>

            <TextBlock Style="{StaticResource Section}" Text="{x:Static r:SettingsText.FileNameSection}" />
            <TextBox Text="{Binding FileNameTemplate, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:SettingsText.FileNameTemplate}" />
            <TextBlock Style="{StaticResource Hint}">
              <Run Text="{x:Static r:SettingsText.FileNameExample}" />
              <Run Text="{Binding FileNamePreview, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>
            <ItemsControl ItemsSource="{Binding TokenHelp}" Margin="0,8,0,0" Opacity="0.7" FontFamily="Consolas" FontSize="12" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================== Destinations ============================== -->
      <TabItem Header="{x:Static r:DestinationsText.DestinationsTab}" x:Name="DestinationsTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12,4,12,12" DataContext="{Binding Destinations}">
            <TextBlock Style="{StaticResource Hint}"
                       Text="{x:Static r:DestinationsText.Intro}" />

            <!-- Printer -->
            <TextBlock Style="{StaticResource Section}" Text="{x:Static r:DestinationsText.Printer}" />
            <Grid DataContext="{Binding Printer}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static r:DestinationsText.Printer}" />
              <ComboBox Grid.Column="1" Margin="0,3" ItemsSource="{Binding Printers}" SelectedItem="{Binding Printer}" AutomationProperties.Name="{x:Static r:DestinationsText.Printer}" />
              <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{x:Static r:DestinationsText.SizeOnPage}" />
              <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,3" ItemsSource="{Binding Fits}" SelectedItem="{Binding Fit}" ItemTemplate="{StaticResource EnumItem}" AutomationProperties.Name="{x:Static r:DestinationsText.SizeOnPage}" />
              <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{x:Static r:DestinationsText.Orientation}" />
              <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,3" ItemsSource="{Binding Orientations}" SelectedItem="{Binding Orientation}" ItemTemplate="{StaticResource EnumItem}" AutomationProperties.Name="{x:Static r:DestinationsText.Orientation}" />
              <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="{x:Static r:DestinationsText.Margins}" />
              <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                <Slider Minimum="0" Maximum="50" Value="{Binding MarginMm}" Width="200" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" AutomationProperties.Name="{x:Static r:DestinationsText.MarginsInMillimetres}" />
                <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Text="{Binding MarginMm, Mode=OneWay, StringFormat={x:Static r:DestinationsText.MillimetresFormat}}" />
              </StackPanel>
              <CheckBox Grid.Row="4" Grid.Column="1" Margin="0,3" Content="{x:Static r:DestinationsText.ShowPrintDialog}" IsChecked="{Binding ShowDialog}" />
            </Grid>
            <ContentControl Content="{Binding Printer}" ContentTemplate="{StaticResource TestRow}" Focusable="False" />

            <!-- Word and PowerPoint -->
            <TextBlock Style="{StaticResource Section}" Text="{x:Static r:DestinationsText.WordSection}" />
            <ContentControl Content="{Binding Word}" ContentTemplate="{StaticResource OfficeEditor}" Focusable="False" />
            <TextBlock Style="{StaticResource Section}" Text="{x:Static r:DestinationsText.PowerPointSection}" />
            <ContentControl Content="{Binding PowerPoint}" ContentTemplate="{StaticResource OfficeEditor}" Focusable="False" />

            <!-- PDF -->
            <TextBlock Style="{StaticResource Section}" Text="{x:Static r:DestinationsText.PdfSection}" />
            <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:DestinationsText.PdfHint}" />
            <Grid DataContext="{Binding Pdf}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static r:DestinationsText.Paper}" />
              <ComboBox Grid.Column="1" Margin="0,3" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" ItemTemplate="{StaticResource EnumItem}" AutomationProperties.Name="{x:Static r:DestinationsText.Paper}" />
              <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{x:Static r:DestinationsText.SizeOnPage}" />
              <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,3" ItemsSource="{Binding Fits}" SelectedItem="{Binding Fit}" ItemTemplate="{StaticResource EnumItem}" AutomationProperties.Name="{x:Static r:DestinationsText.SizeOnPdfPage}" />
              <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{x:Static r:DestinationsText.Orientation}" />
              <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,3" ItemsSource="{Binding Orientations}" SelectedItem="{Binding Orientation}" ItemTemplate="{StaticResource EnumItem}" AutomationProperties.Name="{x:Static r:DestinationsText.PdfOrientation}" />
              <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="{x:Static r:DestinationsText.Margins}" />
              <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                <Slider Minimum="0" Maximum="50" Value="{Binding MarginMm}" Width="200" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" AutomationProperties.Name="{x:Static r:DestinationsText.PdfMarginsInMillimetres}" />
                <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Text="{Binding MarginMm, Mode=OneWay, StringFormat={x:Static r:DestinationsText.MillimetresFormat}}" />
              </StackPanel>
            </Grid>
            <ContentControl Content="{Binding Pdf}" ContentTemplate="{StaticResource TestRow}" Focusable="False" />

            <!-- Servers -->
            <TextBlock Style="{StaticResource Section}" Text="{x:Static r:DestinationsText.ServersSection}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <DockPanel Margin="0,0,12,0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                  <Button Content="{x:Static r:CommonText.Add}" Command="{Binding AddServerCommand}" MinWidth="70" />
                  <Button Content="{x:Static r:CommonText.Remove}" Command="{Binding RemoveServerCommand}" MinWidth="70" Margin="6,0,0,0" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}" DisplayMemberPath="Label" MinHeight="120" AutomationProperties.Name="{x:Static r:DestinationsText.Servers}" />
              </DockPanel>
              <ContentControl Grid.Column="1" Content="{Binding SelectedServer}" Focusable="False">
                <ContentControl.ContentTemplate>
                  <DataTemplate DataType="{x:Type local:ServerViewModel}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="120" />
                          <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static r:DestinationsText.Name}" />
                        <TextBox Grid.Column="1" Margin="0,3" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:DestinationsText.ServerName}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{x:Static r:DestinationsText.Protocol}" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,3" ItemsSource="{Binding Protocols}" SelectedItem="{Binding Protocol}" ItemTemplate="{StaticResource EnumItem}" AutomationProperties.Name="{x:Static r:DestinationsText.Protocol}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{x:Static r:DestinationsText.Server}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:DestinationsText.ServerAddress}" ToolTip="{x:Static r:DestinationsText.ServerAddressExample}" />
                        <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="{x:Static r:DestinationsText.Port}" />
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                          <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="70" AutomationProperties.Name="{x:Static r:DestinationsText.Port}" />
                          <TextBlock Text="{Binding PortHint}" Opacity="0.7" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="{x:Static r:DestinationsText.UserName}" />
                        <TextBox Grid.Row="4" Grid.Column="1" Margin="0,3" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:DestinationsText.UserName}" ToolTip="{x:Static r:DestinationsText.UserNameTip}" />
                        <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="{x:Static r:DestinationsText.Password}" />
                        <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,3">
                          <PasswordBox Tag="password" PasswordChanged="OnSecretChanged" AutomationProperties.Name="{x:Static r:DestinationsText.Password}" />
                          <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding PasswordState}" Opacity="0.7" VerticalAlignment="Center" />
                            <Button Content="{x:Static r:DestinationsText.Forget}" Command="{Binding ForgetPasswordCommand}" Margin="8,0,0,0" Padding="6,0" />
                          </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="{x:Static r:DestinationsText.KeyFile}" Visibility="{Binding IsSftp, Converter={StaticResource Visible}}" />
                        <DockPanel Grid.Row="6" Grid.Column="1" Margin="0,3" Visibility="{Binding IsSftp, Converter={StaticResource Visible}}">
                          <Button DockPanel.Dock="Right" Content="{x:Static r:CommonText.Browse}" Command="{Binding BrowseKeyFileCommand}" Margin="8,0,0,0" />
                          <TextBox Text="{Binding KeyFile, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:DestinationsText.PrivateKeyFile}" ToolTip="{x:Static r:DestinationsText.KeyFileTip}" />
                        </DockPanel>
                        <TextBlock Grid.Row="7" Style="{StaticResource FieldLabel}" Text="{x:Static r:DestinationsText.KeyPassphrase}" Visibility="{Binding IsSftp, Converter={StaticResource Visible}}" />
                        <StackPanel Grid.Row="7" Grid.Column="1" Margin="0,3" Visibility="{Binding IsSftp, Converter={StaticResource Visible}}">
                          <PasswordBox Tag="passphrase" PasswordChanged="OnSecretChanged" AutomationProperties.Name="{x:Static r:DestinationsText.KeyPassphrase}" />
                          <TextBlock Text="{Binding PassphraseState}" Opacity="0.7" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Row="8" Style="{StaticResource FieldLabel}" Text="{x:Static r:DestinationsText.ServerFolder}" />
                        <TextBox Grid.Row="8" Grid.Column="1" Margin="0,3" Text="{Binding RemoteFolder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:DestinationsText.FolderOnServer}"
                                 ToolTip="{x:Static r:DestinationsText.ServerFolderTip}" />
                        <TextBlock Grid.Row="9" Style="{StaticResource FieldLabel}" Text="{x:Static r:DestinationsText.PublicAddress}" />
                        <TextBox Grid.Row="9" Grid.Column="1" Margin="0,3" Text="{Binding PublicUrl, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:DestinationsText.PublicAddress}"
                                 ToolTip="{x:Static r:DestinationsText.PublicAddressTip}" />
                        <CheckBox Grid.Row="10" Grid.Column="1" Margin="0,3" Content="{x:Static r:DestinationsText.PassiveMode}" IsChecked="{Binding Passive}"
                                  Visibility="{Binding IsFtp, Converter={StaticResource Visible}}" />
                      </Grid>
                      <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding HasTrustedFingerprint, Converter={StaticResource Visible}}">
                        <TextBlock Opacity="0.7" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="330">
                          <Run Text="{x:Static r:DestinationsText.Trusted}" /> <Run Text="{Binding TrustedFingerprint, Mode=OneWay}" />
                        </TextBlock>
                        <Button Content="{x:Static r:DestinationsText.Forget}" Command="{Binding ForgetFingerprintCommand}" Margin="8,0,0,0" Padding="6,0" />
                      </StackPanel>
                      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TestRow}" Focusable="False" />
                      <Button Content="{x:Static r:DestinationsText.TrustIt}" Command="{Binding TrustCommand}" HorizontalAlignment="Left" Margin="90,4,0,0" MinWidth="80"
                              Visibility="{Binding UntrustedFingerprint, Converter={StaticResource VisibleIfSet}}"
                              ToolTip="{x:Static r:DestinationsText.TrustItTip}" />
                    </StackPanel>
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
            </Grid>

            <!-- HTTP uploads -->
            <TextBlock Style="{StaticResource Section}" Text="{x:Static r:DestinationsText.UploadsSection}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <DockPanel Margin="0,0,12,0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                  <Button Content="{x:Static r:CommonText.Add}" Command="{Binding AddUploadCommand}" MinWidth="70" />
                  <Button Content="{x:Static r:CommonText.Remove}" Command="{Binding RemoveUploadCommand}" MinWidth="70" Margin="6,0,0,0" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Uploads}" SelectedItem="{Binding SelectedUpload}" DisplayMemberPath="Label" MinHeight="120" AutomationProperties.Name="{x:Static r:DestinationsText.UploadsSection}" />
              </DockPanel>
              <ContentControl Grid.Column="1" Content="{Binding SelectedUpload}" Focusable="False">
                <ContentControl.ContentTemplate>
                  <DataTemplate DataType="{x:Type local:UploadViewModel}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="120" />
                          <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static r:DestinationsText.Name}" />
                        <TextBox Grid.Column="1" Margin="0,3" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:DestinationsText.UploadName}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{x:Static r:DestinationsText.Address}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:DestinationsText.UploadAddress}" ToolTip="{x:Static r:DestinationsText.UploadAddressTip}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{x:Static r:DestinationsText.FileField}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3" Text="{Binding FileField, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:DestinationsText.FileField}" />
                        <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="{x:Static r:DestinationsText.FormFields}" VerticalAlignment="Top" />
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,3" Text="{Binding FieldsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="44" VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="{x:Static r:DestinationsText.FormFields}" ToolTip="{x:Static r:DestinationsText.FormFieldsTip}" />
                        <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="{x:Static r:DestinationsText.Headers}" VerticalAlignment="Top" />
                        <TextBox Grid.Row="4" Grid.Column="1" Margin="0,3" Text="{Binding HeadersText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="44" VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="{x:Static r:DestinationsText.Headers}" ToolTip="{x:Static r:DestinationsText.HeadersTip}" />
                        <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="{x:Static r:DestinationsText.SecretHeader}" />
                        <TextBox Grid.Row="5" Grid.Column="1" Margin="0,3" Text="{Binding AuthHeader, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:DestinationsText.SecretHeaderName}" ToolTip="{x:Static r:DestinationsText.SecretHeaderTip}" />
                        <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="{x:Static r:DestinationsText.SecretValue}" />
                        <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,3">
                          <PasswordBox Tag="token" PasswordChanged="OnSecretChanged" AutomationProperties.Name="{x:Static r:DestinationsText.SecretHeaderValue}" ToolTip="{x:Static r:DestinationsText.SecretValueTip}" />
                          <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding TokenState}" Opacity="0.7" VerticalAlignment="Center" />
                            <Button Content="{x:Static r:DestinationsText.Forget}" Command="{Binding ForgetTokenCommand}" Margin="8,0,0,0" Padding="6,0" />
                          </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Row="7" Style="{StaticResource FieldLabel}" Text="{x:Static r:DestinationsText.LinkInReply}" />
                        <TextBox Grid.Row="7" Grid.Column="1" Margin="0,3" Text="{Binding LinkPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:DestinationsText.LinkInReplyName}"
                                 ToolTip="{x:Static r:DestinationsText.LinkInReplyTip}" />
                      </Grid>
                      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TestRow}" Focusable="False" />
                      <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:DestinationsText.UploadTestHint}" />
                    </StackPanel>
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
            </Grid>

            <!-- Apps -->
            <TextBlock Style="{StaticResource Section}" Text="{x:Static r:DestinationsText.AppsSection}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <DockPanel Margin="0,0,12,0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                  <Button Content="{x:Static r:CommonText.Add}" Command="{Binding AddAppCommand}" MinWidth="70" />
                  <Button Content="{x:Static r:CommonText.Remove}" Command="{Binding RemoveAppCommand}" MinWidth="70" Margin="6,0,0,0" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Apps}" SelectedItem="{Binding SelectedApp}" DisplayMemberPath="Label" MinHeight="90" AutomationProperties.Name="{x:Static r:DestinationsText.Apps}" />
              </DockPanel>
              <ContentControl Grid.Column="1" Content="{Binding SelectedApp}" Focusable="False">
                <ContentControl.ContentTemplate>
                  <DataTemplate DataType="{x:Type local:ExternalAppViewModel}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="120" />
                          <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static r:DestinationsText.Name}" />
                        <TextBox Grid.Column="1" Margin="0,3" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:DestinationsText.AppName}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{x:Static r:DestinationsText.Program}" />
                        <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,3">
                          <Button DockPanel.Dock="Right" Content="{x:Static r:CommonText.Browse}" Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
                          <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:DestinationsText.Program}" />
                        </DockPanel>
                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{x:Static r:DestinationsText.CommandLine}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3" Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:DestinationsText.CommandLine}"
                                 ToolTip="{x:Static r:DestinationsText.CommandLineTip}" />
                      </Grid>
                      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TestRow}" Focusable="False" />
                    </StackPanel>
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================== Capture ============================== -->
      <TabItem Header="{x:Static r:SettingsText.CaptureTab}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12,4,12,12">
            <TextBlock Style="{StaticResource Section}" Text="{x:Static r:SettingsText.TimingSection}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <TextBlock Text="{x:Static r:SettingsText.CaptureDelay}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding DelayChoices}" SelectedItem="{Binding DelaySeconds}" ItemStringFormat="{x:Static r:CommonText.SecondsFormat}"
                        HorizontalAlignment="Left" MinWidth="120" AutomationProperties.Name="{x:Static r:SettingsText.CaptureDelay}" />
              <TextBlock Grid.Row="1" Text="{x:Static r:SettingsText.WaitForWindowsToHide}" VerticalAlignment="Center" Margin="0,8,0,0" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding HideDelayChoices}" SelectedItem="{Binding HideDelayMs}" ItemStringFormat="{x:Static r:CommonText.MillisecondsFormat}"
                        HorizontalAlignment="Left" MinWidth="120" Margin="0,8,0,0" AutomationProperties.Name="{x:Static r:SettingsText.HideDelay}" />
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:SettingsText.CaptureDelayHint}" />
            <Expander Header="{x:Static r:SettingsText.DelayPerKind}" Margin="0,8,0,0">
              <StackPanel Margin="0,6,0,0">
                <ItemsControl ItemsSource="{Binding ModeDelays}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ModeDelayRow}">
                      <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="220" />
                          <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" SelectedItem="{Binding Choice}" HorizontalAlignment="Left" MinWidth="200"
                                  ItemsSource="{Binding DataContext.ModeDelayChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  AutomationProperties.Name="{Binding Label}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:SettingsText.DelayPerKindHint}" />
              </StackPanel>
            </Expander>

            <TextBlock Style="{StaticResource Section}" Text="{x:Static r:SettingsText.ContentSection}" />
            <CheckBox Margin="0,2" Content="{x:Static r:SettingsText.IncludeCursor}" IsChecked="{Binding IncludeCursor}" />
            <CheckBox Margin="0,2" Content="{x:Static r:SettingsText.IncludeWindowShadow}" IsChecked="{Binding IncludeWindowShadow}" />

            <TextBlock Style="{StaticResource Section}" Text="{x:Static r:SettingsText.CaptureToolbarSection}" />
            <CheckBox Margin="0,2" Content="{x:Static r:SettingsText.ShowToolbarAtStartup}" IsChecked="{Binding ShowToolbarAtStartup}" />
            <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:SettingsText.CaptureToolbarHint}" />

            <TextBlock Style="{StaticResource Section}" Text="{x:Static r:SettingsText.ShapesSection}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <TextBlock Text="{x:Static r:SettingsText.FixedSizeRegion}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding FixedSizeChoices}" IsEditable="True" Text="{Binding FixedRegionSize, UpdateSourceTrigger=PropertyChanged}"
                        HorizontalAlignment="Left" MinWidth="160" AutomationProperties.Name="{x:Static r:SettingsText.FixedSizeRegion}" />
              <TextBlock Grid.Row="1" Text="{x:Static r:SettingsText.RoundedCorners}" VerticalAlignment="Center" Margin="0,8,0,0" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding CornerRadiusChoices}" SelectedItem="{Binding CornerRadius}" ItemStringFormat="{x:Static r:CommonText.PixelsFormat}"
                        HorizontalAlignment="Left" MinWidth="120" Margin="0,8,0,0" AutomationProperties.Name="{x:Static r:SettingsText.CornerRadius}" />
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:SettingsText.ShapesHint}" />

            <TextBlock Style="{StaticResource Section}" Text="{x:Static r:SettingsText.FullScreenSection}" />
            <ComboBox ItemsSource="{Binding FullScreenOutputs}" SelectedItem="{Binding FullScreenOutput}" ItemTemplate="{StaticResource EnumItem}"
                      HorizontalAlignment="Left" MinWidth="260" AutomationProperties.Name="{x:Static r:SettingsText.FullScreenOutput}" />

            <TextBlock Style="{StaticResource Section}" Text="{x:Static r:SettingsText.ScrollingSection}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <TextBlock Text="{x:Static r:SettingsText.WaitAfterScroll}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding ScrollSettleChoices}" SelectedItem="{Binding ScrollSettleMs}" ItemStringFormat="{x:Static r:CommonText.MillisecondsFormat}"
                        HorizontalAlignment="Left" MinWidth="120" AutomationProperties.Name="{x:Static r:SettingsText.WaitAfterScroll}" />
              <TextBlock Grid.Row="1" Text="{x:Static r:SettingsText.StopAtHeight}" VerticalAlignment="Center" Margin="0,8,0,0" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ScrollMaxHeightChoices}" SelectedItem="{Binding ScrollMaxHeight}" ItemStringFormat="{x:Static r:SettingsText.PixelsN0Format}"
                        HorizontalAlignment="Left" MinWidth="120" Margin="0,8,0,0" AutomationProperties.Name="{x:Static r:SettingsText.MaximumHeight}" />
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:SettingsText.ScrollingHint}" />

            <TextBlock Style="{StaticResource Section}" Text="{x:Static r:SettingsText.CaptureMethod}" />
            <ComboBox ItemsSource="{Binding Backends}" SelectedItem="{Binding Backend}" ItemTemplate="{StaticResource EnumItem}"
                      HorizontalAlignment="Left" MinWidth="260" AutomationProperties.Name="{x:Static r:SettingsText.CaptureMethod}" />
            <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:SettingsText.CaptureMethodHint}" />

            <TextBlock Style="{StaticResource Section}" Text="{x:Static r:SettingsText.HdrSection}" />
            <ComboBox ItemsSource="{Binding HdrChoices}" SelectedItem="{Binding Hdr}" ItemTemplate="{StaticResource EnumItem}"
                      HorizontalAlignment="Left" MinWidth="260" AutomationProperties.Name="{x:Static r:SettingsText.HdrSection}" />
            <TextBlock Style="{StaticResource Hint}" Text="{Binding HdrStatus}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================== Recording ============================== -->
      <TabItem Header="{x:Static r:SettingsText.RecordingTab}" x:Name="RecordingTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12,4,12,12">
            <TextBlock Style="{StaticResource Section}" Text="{x:Static r:SettingsText.VideoSection}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <TextBlock Text="{x:Static r:SettingsText.FramesPerSecond}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding FrameRates}" SelectedItem="{Binding RecordingFps}" ItemStringFormat="{x:Static r:CommonText.FpsFormat}"
                        HorizontalAlignment="Left" MinWidth="120" AutomationProperties.Name="{x:Static r:SettingsText.FramesPerSecond}" />
              <TextBlock Grid.Row="1" Text="{x:Static r:SettingsText.Quality}" VerticalAlignment="Center" Margin="0,10,0,0" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding QualityPresets}" SelectedItem="{Binding RecordingQuality}" ItemTemplate="{StaticResource EnumItem}"
                        HorizontalAlignment="Left" MinWidth="260" Margin="0,10,0,0" AutomationProperties.Name="{x:Static r:SettingsText.Quality}" />
              <TextBlock Grid.Row="2" Text="{x:Static r:SettingsText.Encoder}" VerticalAlignment="Center" Margin="0,10,0,0" />
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                <ComboBox ItemsSource="{Binding Encoders}" SelectedItem="{Binding RecordingEncoder}" DisplayMemberPath="Label"
                          MinWidth="260" MaxWidth="420" AutomationProperties.Name="{x:Static r:SettingsText.Encoder}" />
                <Button Content="{x:Static r:SettingsText.CheckAgain}" Command="{Binding RedetectEncodersCommand}" Margin="8,0,0,0" Padding="10,2"
                        ToolTip="{x:Static r:SettingsText.CheckAgainTip}" />
              </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Text="{Binding EncoderStatus}" />
            <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:SettingsText.EncoderHint}" />

            <TextBlock Style="{StaticResource Section}" Text="{x:Static r:SettingsText.MouseSection}" />
            <CheckBox Margin="0,2" Content="{x:Static r:SettingsText.ShowMousePointer}" IsChecked="{Binding RecordingIncludeCursor}" />
            <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:SettingsText.MouseHint}" />

            <TextBlock Style="{StaticResource Section}" Text="{x:Static r:SettingsText.SoundSection}" />
            <CheckBox Margin="0,2" Content="{x:Static r:SettingsText.RecordSystemAudio}" IsChecked="{Binding RecordSystemAudio}" />
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <TextBlock Text="{x:Static r:SettingsText.SystemAudio}" VerticalAlignment="Center" Visibility="{Binding IsAppAudioSupported, Converter={StaticResource Visible}}" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding SystemAudioScopes}" SelectedItem="{Binding RecordingSystemAudioScope}" ItemTemplate="{StaticResource EnumItem}"
                        HorizontalAlignment="Left" MinWidth="260" IsEnabled="{Binding RecordSystemAudio}" AutomationProperties.Name="{x:Static r:SettingsText.WhichSystemAudio}"
                        Visibility="{Binding IsAppAudioSupported, Converter={StaticResource Visible}}" />
              <TextBlock Grid.Row="1" Text="{x:Static r:SettingsText.App}" VerticalAlignment="Center" Margin="0,8,0,0" Visibility="{Binding IsAppAudioSupported, Converter={StaticResource Visible}}" />
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding IsAppAudioSupported, Converter={StaticResource Visible}}">
                <ComboBox ItemsSource="{Binding Apps}" SelectedItem="{Binding RecordingApp}" DisplayMemberPath="Label"
                          MinWidth="260" MaxWidth="420" IsEnabled="{Binding IsAppChoiceEnabled}" AutomationProperties.Name="{x:Static r:SettingsText.App}" />
                <Button Content="{x:Static r:SettingsText.Refresh}" Command="{Binding RefreshAppsCommand}" Margin="8,0,0,0" Padding="10,2" IsEnabled="{Binding IsAppChoiceEnabled}"
                        ToolTip="{x:Static r:SettingsText.RefreshAppsTip}" />
              </StackPanel>
              <TextBlock Grid.Row="2" Text="{x:Static r:SettingsText.SystemAudioFrom}" VerticalAlignment="Center" Margin="0,8,0,0" />
              <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding RecordingOutput}" DisplayMemberPath="Label"
                        HorizontalAlignment="Left" MinWidth="260" MaxWidth="420" Margin="0,8,0,0" IsEnabled="{Binding IsOutputChoiceEnabled}" AutomationProperties.Name="{x:Static r:SettingsText.SystemAudioFrom}" />
              <TextBlock Grid.Row="3" Text="{x:Static r:SettingsText.Microphone}" VerticalAlignment="Center" Margin="0,8,0,0" />
              <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Microphones}" SelectedItem="{Binding RecordingMicrophone}" DisplayMemberPath="Label"
                        HorizontalAlignment="Left" MinWidth="260" MaxWidth="420" Margin="0,8,0,0" AutomationProperties.Name="{x:Static r:SettingsText.Microphone}" />
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Text="{Binding SpeakersStatus}" />

            <TextBlock Text="{x:Static r:SettingsText.MicrophoneProcessing}" FontWeight="SemiBold" Margin="0,12,0,4" />
            <StackPanel IsEnabled="{Binding HasMicrophone}">
              <StackPanel Orientation="Horizontal" Margin="0,2" Visibility="{Binding CanSuppressNoise, Converter={StaticResource Visible}}">
                <CheckBox Content="{x:Static r:SettingsText.NoiseSuppression}" IsChecked="{Binding MicrophoneNoiseSuppression}" VerticalAlignment="Center" />
                <Slider Width="140" Margin="8,0,0,0" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" Value="{Binding NoiseSuppressionStrength}"
                        IsSnapToTickEnabled="True" TickFrequency="5" IsEnabled="{Binding MicrophoneNoiseSuppression}" VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Static r:SettingsText.NoiseSuppressionStrength}" />
                <TextBlock Text="{Binding NoiseSuppressionStrengthText}" Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="44" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,2">
                <CheckBox Content="{x:Static r:SettingsText.NoiseGate}" IsChecked="{Binding MicrophoneGate}" VerticalAlignment="Center" />
                <Slider Width="140" Margin="8,0,0,0" Minimum="{Binding MinGateThresholdDb}" Maximum="{Binding MaxGateThresholdDb}" SmallChange="1" LargeChange="5"
                        Value="{Binding GateThresholdDb}" IsSnapToTickEnabled="True" TickFrequency="1" IsEnabled="{Binding MicrophoneGate}" VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Static r:SettingsText.NoiseGateThreshold}" />
                <TextBlock Text="{Binding GateThresholdText}" Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="44" />
              </StackPanel>
              <CheckBox Margin="0,2" Content="{x:Static r:SettingsText.Compressor}" IsChecked="{Binding MicrophoneCompressor}" />
              <CheckBox Margin="0,2" Content="{x:Static r:SettingsText.Limiter}" IsChecked="{Binding MicrophoneLimiter}" />
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:SettingsText.ProcessingHint}" />

            <StackPanel Visibility="{Binding CanMonitor, Converter={StaticResource Visible}}">
              <TextBlock Text="{x:Static r:SettingsText.LevelsSection}" FontWeight="SemiBold" Margin="0,12,0,4" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="220" />
                  <ColumnDefinition Width="240" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="{x:Static r:SettingsText.MicrophoneProcessed}" VerticalAlignment="Center" />
                <wpf:LevelMeter Grid.Column="1" Height="10" VerticalAlignment="Center" AutomationProperties.Name="{x:Static r:SettingsText.MicrophoneLevel}"
                                Peak="{Binding MicrophoneLevel.Peak}" Rms="{Binding MicrophoneLevel.Rms}" Hold="{Binding MicrophoneLevel.Hold}" Clipping="{Binding MicrophoneLevel.Clipping}" />
                <TextBlock Grid.Column="2" Text="{Binding MicrophoneLevel.Text}" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.75" />
                <TextBlock Grid.Row="1" Text="{x:Static r:SettingsText.SystemAudio}" VerticalAlignment="Center" Margin="0,8,0,0" />
                <wpf:LevelMeter Grid.Row="1" Grid.Column="1" Height="10" VerticalAlignment="Center" Margin="0,8,0,0" AutomationProperties.Name="{x:Static r:SettingsText.SystemAudioLevel}"
                                Peak="{Binding SystemAudioLevel.Peak}" Rms="{Binding SystemAudioLevel.Rms}" Hold="{Binding SystemAudioLevel.Hold}" Clipping="{Binding SystemAudioLevel.Clipping}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SystemAudioLevel.Text}" Margin="10,8,0,0" VerticalAlignment="Center" Opacity="0.75" />
              </Grid>
              <TextBlock Style="{StaticResource Hint}" Text="{Binding MonitorStatus}" Foreground="#D13438" />
              <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:SettingsText.LevelsHint}" />

              <TextBlock Text="{x:Static r:SettingsText.MicrophoneTestSection}" FontWeight="SemiBold" Margin="0,12,0,4" />
              <StackPanel Orientation="Horizontal">
                <Button Content="{x:Static r:SettingsText.Record5Seconds}" Command="{Binding TestMicrophoneCommand}" Padding="10,2" />
                <Button Content="{x:Static r:SettingsText.PlayAsRecorded}" Command="{Binding PlayOriginalCommand}" Padding="10,2" Margin="8,0,0,0" />
                <Button Content="{x:Static r:SettingsText.PlayWithProcessing}" Command="{Binding PlayProcessedCommand}" Padding="10,2" Margin="8,0,0,0" />
                <Button Content="{x:Static r:CommonText.Stop}" Command="{Binding StopPlaybackCommand}" Padding="10,2" Margin="8,0,0,0" />
              </StackPanel>
              <TextBlock Style="{StaticResource Hint}" Text="{Binding MicrophoneTestStatus}" />
            </StackPanel>

            <TextBlock Text="{x:Static r:SettingsText.LoudnessSection}" FontWeight="SemiBold" Margin="0,12,0,4" />
            <CheckBox Margin="0,2" Content="{x:Static r:SettingsText.NormalizeLoudness}" IsChecked="{Binding NormalizeLoudness}" />
            <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:SettingsText.LoudnessHint}" />
            <TextBlock Style="{StaticResource Hint}" Visibility="{Binding IsAppAudioSupported, Converter={StaticResource Visible}}"
                       Text="{x:Static r:SettingsText.AppAudioHint}" />
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Static r:SettingsText.WithBoth}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding TrackLayouts}" SelectedItem="{Binding RecordingTracks}" ItemTemplate="{StaticResource EnumItem}"
                        HorizontalAlignment="Left" MinWidth="260" AutomationProperties.Name="{x:Static r:SettingsText.SoundTracks}" />
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:SettingsText.TracksHint}" />

            <TextBlock Style="{StaticResource Section}" Text="{x:Static r:SettingsText.FfmpegSection}" />
            <TextBlock Text="{Binding FfmpegStatus}" TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Opacity" Value="0.75" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFfmpegMissing}" Value="True">
                      <Setter Property="Foreground" Value="#D13438" />
                      <Setter Property="Opacity" Value="1" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:SettingsText.RecordingHint}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================== Overlays ============================== -->
      <TabItem Header="{x:Static r:OverlaysText.OverlaysTab}" x:Name="OverlaysTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12,4,12,12" DataContext="{Binding Overlays}">
            <TextBlock Style="{StaticResource Section}" Text="{x:Static r:OverlaysText.WhileRecording}" />
            <RadioButton Margin="0,2" Content="{x:Static r:OverlaysText.BurnIn}" IsChecked="{Binding BurnIn}" GroupName="BurnIn" />
            <RadioButton Margin="0,2" Content="{x:Static r:OverlaysText.AddLater}" GroupName="BurnIn"
                         IsChecked="{Binding BurnIn, Converter={x:Static local:InverseBooleanConverter.Instance}}" />
            <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:OverlaysText.AddLaterHint}" />
            <CheckBox Margin="0,8,0,2" Content="{x:Static r:OverlaysText.WriteMetadata}" IsChecked="{Binding WriteMetadata}" />
            <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:OverlaysText.MetadataHint}" />

            <TextBlock Style="{StaticResource Section}" Text="{x:Static r:OverlaysText.ClicksSection}" />
            <CheckBox Margin="0,2" Content="{x:Static r:OverlaysText.ShowClicks}" IsChecked="{Binding ClicksEnabled}" />
            <Grid Margin="0,6,0,0" IsEnabled="{Binding ClicksEnabled}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <TextBlock Text="{x:Static r:OverlaysText.LeftButton}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding Colors}" SelectedItem="{Binding LeftColor}" HorizontalAlignment="Left" MinWidth="160"
                        AutomationProperties.Name="{x:Static r:OverlaysText.LeftButtonColour}" />
              <TextBlock Grid.Row="1" Text="{x:Static r:OverlaysText.RightButton}" VerticalAlignment="Center" Margin="0,6,0,0" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Colors}" SelectedItem="{Binding RightColor}" HorizontalAlignment="Left" MinWidth="160"
                        Margin="0,6,0,0" AutomationProperties.Name="{x:Static r:OverlaysText.RightButtonColour}" />
              <TextBlock Grid.Row="2" Text="{x:Static r:OverlaysText.MiddleButtons}" VerticalAlignment="Center" Margin="0,6,0,0" />
              <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Colors}" SelectedItem="{Binding MiddleColor}" HorizontalAlignment="Left" MinWidth="160"
                        Margin="0,6,0,0" AutomationProperties.Name="{x:Static r:OverlaysText.MiddleButtonColour}" />
              <TextBlock Grid.Row="3" Text="{x:Static r:OverlaysText.RingSize}" VerticalAlignment="Center" Margin="0,6,0,0" />
              <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                <Slider Minimum="16" Maximum="80" Width="200" Value="{Binding ClickSize}" IsSnapToTickEnabled="True" TickFrequency="2"
                        VerticalAlignment="Center" AutomationProperties.Name="{x:Static r:OverlaysText.RingSize}" />
                <TextBlock Text="{Binding ClickSize, StringFormat={x:Static r:OverlaysText.WholePixelsFormat}}" VerticalAlignment="Center" Margin="8,0,0,0" />
              </StackPanel>
            </Grid>
            <CheckBox Margin="0,8,0,2" Content="{x:Static r:OverlaysText.ClickSound}" IsChecked="{Binding ClickSound}" />
            <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:OverlaysText.ClickSoundHint}" />

            <TextBlock Style="{StaticResource Section}" Text="{x:Static r:OverlaysText.PointerSection}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <TextBlock Text="{x:Static r:OverlaysText.Effect}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding PointerEffects}" SelectedItem="{Binding PointerEffect}" ItemTemplate="{StaticResource EnumItem}"
                        HorizontalAlignment="Left" MinWidth="200" AutomationProperties.Name="{x:Static r:OverlaysText.PointerEffect}" />
              <TextBlock Grid.Row="1" Text="{x:Static r:OverlaysText.HaloColour}" VerticalAlignment="Center" Margin="0,6,0,0" Visibility="{Binding IsHalo, Converter={StaticResource Visible}}" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Colors}" SelectedItem="{Binding PointerColor}" HorizontalAlignment="Left" MinWidth="160"
                        Margin="0,6,0,0" AutomationProperties.Name="{x:Static r:OverlaysText.HaloColour}" Visibility="{Binding IsHalo, Converter={StaticResource Visible}}" />
              <TextBlock Grid.Row="2" Text="{x:Static r:OverlaysText.Radius}" VerticalAlignment="Center" Margin="0,6,0,0" Visibility="{Binding HasEffect, Converter={StaticResource Visible}}" />
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding HasEffect, Converter={StaticResource Visible}}">
                <Slider Minimum="20" Maximum="400" Width="200" Value="{Binding PointerRadius}" IsSnapToTickEnabled="True" TickFrequency="5"
                        VerticalAlignment="Center" AutomationProperties.Name="{x:Static r:OverlaysText.EffectRadius}" />
                <TextBlock Text="{Binding PointerRadius, StringFormat={x:Static r:OverlaysText.WholePixelsFormat}}" VerticalAlignment="Center" Margin="8,0,0,0" />
              </StackPanel>
              <TextBlock Grid.Row="3" Text="{x:Static r:OverlaysText.DimBy}" VerticalAlignment="Center" Margin="0,6,0,0" Visibility="{Binding IsSpotlight, Converter={StaticResource Visible}}" />
              <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding IsSpotlight, Converter={StaticResource Visible}}">
                <Slider Minimum="10" Maximum="90" Width="200" Value="{Binding PointerDim}" IsSnapToTickEnabled="True" TickFrequency="5"
                        VerticalAlignment="Center" AutomationProperties.Name="{x:Static r:OverlaysText.SpotlightDimming}" />
                <TextBlock Text="{Binding PointerDim, StringFormat={x:Static r:OverlaysText.WholePercentFormat}}" VerticalAlignment="Center" Margin="8,0,0,0" />
              </StackPanel>
              <TextBlock Grid.Row="4" Text="{x:Static r:OverlaysText.PointerSize}" VerticalAlignment="Center" Margin="0,6,0,0" />
              <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                <Slider Minimum="1" Maximum="3" Width="200" Value="{Binding PointerScale}" IsSnapToTickEnabled="True" TickFrequency="0.25"
                        VerticalAlignment="Center" AutomationProperties.Name="{x:Static r:OverlaysText.PointerSize}" />
                <TextBlock Text="{Binding PointerScaleText}" VerticalAlignment="Center" Margin="8,0,0,0" />
              </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <CheckBox Content="{x:Static r:OverlaysText.HideIdlePointer}" IsChecked="{Binding HideIdlePointer}" VerticalAlignment="Center" />
              <Slider Minimum="1" Maximum="30" Width="120" Margin="8,0,0,0" Value="{Binding IdleSeconds}" IsSnapToTickEnabled="True" TickFrequency="1"
                      VerticalAlignment="Center" IsEnabled="{Binding HideIdlePointer}" AutomationProperties.Name="{x:Static r:OverlaysText.IdleTime}" />
              <TextBlock Text="{Binding IdleSeconds, StringFormat={x:Static r:OverlaysText.WholeSecondsFormat}}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:OverlaysText.PointerHint}" />

            <TextBlock Style="{StaticResource Section}" Text="{x:Static r:OverlaysText.KeystrokesSection}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <TextBlock Text="{x:Static r:OverlaysText.Show}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding KeystrokeModes}" SelectedItem="{Binding KeystrokeMode}" ItemTemplate="{StaticResource EnumItem}"
                        HorizontalAlignment="Left" MinWidth="260" AutomationProperties.Name="{x:Static r:OverlaysText.KeystrokesShown}" />
              <TextBlock Grid.Row="1" Text="{x:Static r:OverlaysText.Where}" VerticalAlignment="Center" Margin="0,6,0,0" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Positions}" SelectedItem="{Binding KeystrokePosition}" ItemTemplate="{StaticResource EnumItem}"
                        HorizontalAlignment="Left" MinWidth="200" Margin="0,6,0,0" IsEnabled="{Binding KeystrokesOn}" AutomationProperties.Name="{x:Static r:OverlaysText.KeystrokePosition}" />
              <TextBlock Grid.Row="2" Text="{x:Static r:OverlaysText.Font}" VerticalAlignment="Center" Margin="0,6,0,0" />
              <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Fonts}" Text="{Binding KeystrokeFont, UpdateSourceTrigger=LostFocus}" IsEditable="True"
                        HorizontalAlignment="Left" MinWidth="200" Margin="0,6,0,0" IsEnabled="{Binding KeystrokesOn}" AutomationProperties.Name="{x:Static r:OverlaysText.KeystrokeFont}" />
              <TextBlock Grid.Row="3" Text="{x:Static r:OverlaysText.Size}" VerticalAlignment="Center" Margin="0,6,0,0" />
              <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0" IsEnabled="{Binding KeystrokesOn}">
                <Slider Minimum="10" Maximum="72" Width="200" Value="{Binding KeystrokeSize}" IsSnapToTickEnabled="True" TickFrequency="1"
                        VerticalAlignment="Center" AutomationProperties.Name="{x:Static r:OverlaysText.KeystrokeSize}" />
                <TextBlock Text="{Binding KeystrokeSize, StringFormat={x:Static r:OverlaysText.WholePointsFormat}}" VerticalAlignment="Center" Margin="8,0,0,0" />
              </StackPanel>
              <TextBlock Grid.Row="4" Text="{x:Static r:OverlaysText.StayAfterLastKey}" VerticalAlignment="Center" Margin="0,6,0,0" />
              <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0" IsEnabled="{Binding KeystrokesOn}">
                <Slider Minimum="0.5" Maximum="10" Width="200" Value="{Binding KeystrokeFade}" IsSnapToTickEnabled="True" TickFrequency="0.5"
                        VerticalAlignment="Center" AutomationProperties.Name="{x:Static r:OverlaysText.KeystrokeTime}" />
                <TextBlock Text="{Binding KeystrokeFade, StringFormat={x:Static r:OverlaysText.SecondsOneDecimalFormat}}" VerticalAlignment="Center" Margin="8,0,0,0" />
              </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:OverlaysText.KeystrokesHint}" />
            <TextBlock Margin="0,10,0,4" Text="{x:Static r:OverlaysText.ExcludedAppsLabel}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ListBox x:Name="ExcludedAppList" ItemsSource="{Binding ExcludedApps}" Height="96" AutomationProperties.Name="{x:Static r:OverlaysText.ExcludedApps}" />
              <Button Grid.Column="1" Content="{x:Static r:CommonText.Remove}" Margin="8,0,0,0" VerticalAlignment="Top" MinWidth="80"
                      Command="{Binding RemoveExcludedAppCommand}" CommandParameter="{Binding SelectedItem, ElementName=ExcludedAppList}" />
            </Grid>
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ComboBox ItemsSource="{Binding RunningApps}" Text="{Binding NewExcludedApp, UpdateSourceTrigger=PropertyChanged}" IsEditable="True"
                        DropDownOpened="OnExcludedAppsOpened" AutomationProperties.Name="{x:Static r:OverlaysText.AppToAdd}" ToolTip="{x:Static r:OverlaysText.AppToAddTip}" />
              <Button Grid.Column="1" Content="{x:Static r:CommonText.Add}" Margin="8,0,0,0" MinWidth="80" Command="{Binding AddExcludedAppCommand}" />
              <Button Grid.Column="2" Content="{x:Static r:SettingsText.Refresh}" Margin="8,0,0,0" Command="{Binding RefreshRunningAppsCommand}" />
            </Grid>

            <TextBlock Style="{StaticResource Section}" Text="{x:Static r:OverlaysText.WebcamSection}" />
            <CheckBox Margin="0,2" Content="{x:Static r:OverlaysText.RecordWebcam}" IsChecked="{Binding WebcamEnabled}" />
            <Grid Margin="0,6,0,0" IsEnabled="{Binding WebcamEnabled}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <TextBlock Text="{x:Static r:OverlaysText.Camera}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding Cameras}" SelectedItem="{Binding Camera}" MinWidth="240" MaxWidth="340" AutomationProperties.Name="{x:Static r:OverlaysText.Camera}" />
                <Button Content="{x:Static r:SettingsText.Refresh}" Command="{Binding RefreshCamerasCommand}" Margin="8,0,0,0" Padding="10,2" />
              </StackPanel>
              <TextBlock Grid.Row="1" Text="{x:Static r:OverlaysText.Picture}" VerticalAlignment="Center" Margin="0,6,0,0" />
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                <ComboBox ItemsSource="{Binding WebcamSizes}" SelectedItem="{Binding WebcamSize}" MinWidth="120" AutomationProperties.Name="{x:Static r:OverlaysText.WebcamPictureSize}" />
                <ComboBox ItemsSource="{Binding WebcamRates}" SelectedItem="{Binding WebcamFps}" ItemStringFormat="{x:Static r:CommonText.FpsFormat}" MinWidth="80" Margin="8,0,0,0"
                          AutomationProperties.Name="{x:Static r:OverlaysText.WebcamFrameRate}" />
              </StackPanel>
              <TextBlock Grid.Row="2" Text="{x:Static r:OverlaysText.Shape}" VerticalAlignment="Center" Margin="0,6,0,0" />
              <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding WebcamShapes}" SelectedItem="{Binding WebcamShape}" ItemTemplate="{StaticResource EnumItem}"
                        HorizontalAlignment="Left" MinWidth="160" Margin="0,6,0,0" AutomationProperties.Name="{x:Static r:OverlaysText.WebcamShape}" />
              <TextBlock Grid.Row="3" Text="{x:Static r:OverlaysText.WebcamSizeLabel}" VerticalAlignment="Center" Margin="0,6,0,0" />
              <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                <Slider Minimum="10" Maximum="60" Width="200" Value="{Binding WebcamHeight}" IsSnapToTickEnabled="True" TickFrequency="1"
                        VerticalAlignment="Center" AutomationProperties.Name="{x:Static r:OverlaysText.WebcamSize}" />
                <TextBlock Text="{Binding WebcamHeight, StringFormat={x:Static r:OverlaysText.WholePercentFormat}}" VerticalAlignment="Center" Margin="8,0,0,0" />
              </StackPanel>
              <TextBlock Grid.Row="4" Text="{x:Static r:OverlaysText.Border}" VerticalAlignment="Center" Margin="0,6,0,0" />
              <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                <ComboBox ItemsSource="{Binding Colors}" SelectedItem="{Binding WebcamBorderColor}" MinWidth="120" AutomationProperties.Name="{x:Static r:OverlaysText.WebcamBorderColour}" />
                <Slider Minimum="0" Maximum="12" Width="120" Margin="8,0,0,0" Value="{Binding WebcamBorderWidth}" IsSnapToTickEnabled="True" TickFrequency="1"
                        VerticalAlignment="Center" AutomationProperties.Name="{x:Static r:OverlaysText.WebcamBorderWidth}" />
                <TextBlock Text="{Binding WebcamBorderWidth, StringFormat={x:Static r:OverlaysText.WholePixelsFormat}}" VerticalAlignment="Center" Margin="8,0,0,0" />
              </StackPanel>
              <CheckBox Grid.Row="5" Grid.Column="1" Margin="0,8,0,0" Content="{x:Static r:OverlaysText.Mirror}" IsChecked="{Binding WebcamMirror}" />
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Text="{Binding WebcamStatus}" />
            <Border x:Name="WebcamArea" Width="320" Height="180" Margin="0,8,0,0" HorizontalAlignment="Left" Background="#FF2B2B2B" ClipToBounds="True"
                    BorderBrush="#60808080" BorderThickness="1" IsEnabled="{Binding WebcamEnabled}">
              <Canvas x:Name="WebcamCanvas">
                <TextBlock Canvas.Left="8" Canvas.Top="6" Text="{x:Static r:OverlaysText.RecordedArea}" Foreground="#A0FFFFFF" FontSize="11" />
                <Border x:Name="WebcamBox" Cursor="SizeAll" MouseLeftButtonDown="OnWebcamDragStart" MouseMove="OnWebcamDrag" MouseLeftButtonUp="OnWebcamDragEnd"
                        AutomationProperties.Name="{x:Static r:OverlaysText.WebcamPlacement}">
                  <Border.Background>
                    <ImageBrush x:Name="WebcamImage" Stretch="UniformToFill" />
                  </Border.Background>
                </Border>
              </Canvas>
            </Border>
            <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:OverlaysText.WebcamHint}" />

            <TextBlock Style="{StaticResource Section}" Text="{x:Static r:OverlaysText.DrawingSection}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <TextBlock Text="{x:Static r:OverlaysText.PenColour}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding Colors}" SelectedItem="{Binding PenColor}" HorizontalAlignment="Left" MinWidth="160"
                        AutomationProperties.Name="{x:Static r:OverlaysText.PenColour}" />
              <TextBlock Grid.Row="1" Text="{x:Static r:OverlaysText.PenWidth}" VerticalAlignment="Center" Margin="0,6,0,0" />
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                <Slider Minimum="1" Maximum="20" Width="200" Value="{Binding PenWidth}" IsSnapToTickEnabled="True" TickFrequency="1"
                        VerticalAlignment="Center" AutomationProperties.Name="{x:Static r:OverlaysText.PenWidth}" />
                <TextBlock Text="{Binding PenWidth, StringFormat={x:Static r:OverlaysText.WholePixelsFormat}}" VerticalAlignment="Center" Margin="8,0,0,0" />
              </StackPanel>
              <TextBlock Grid.Row="2" Text="{x:Static r:OverlaysText.FadeAfter}" VerticalAlignment="Center" Margin="0,6,0,0" />
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                <Slider Minimum="0" Maximum="30" Width="200" Value="{Binding PenFade}" IsSnapToTickEnabled="True" TickFrequency="1"
                        VerticalAlignment="Center" AutomationProperties.Name="{x:Static r:OverlaysText.FadeAfterName}" />
                <TextBlock Text="{Binding PenFadeText}" VerticalAlignment="Center" Margin="8,0,0,0" />
              </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:OverlaysText.DrawingHint}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================== Hotkeys ============================== -->
      <TabItem Header="{x:Static r:SettingsText.HotkeysTab}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12,4,12,12">
          <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,8"
                     Text="{x:Static r:SettingsText.HotkeysHint}" />
          <ItemsControl ItemsSource="{Binding Hotkeys}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:HotkeyRowViewModel}">
                <Grid Margin="0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                  <local:HotkeyBox Grid.Column="1" GestureText="{Binding Text}" AutomationProperties.Name="{Binding Label}"
                                   GotKeyboardFocus="OnHotkeyBoxGotFocus" LostKeyboardFocus="OnHotkeyBoxLostFocus" />
                  <Button Grid.Column="2" Content="{x:Static r:SettingsText.Clear}" Command="{Binding ClearCommand}" Margin="8,0,0,0" />
                  <TextBlock Grid.Column="3" Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Opacity" Value="0.75" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasProblem}" Value="True">
                            <Setter Property="Foreground" Value="#D13438" />
                            <Setter Property="Opacity" Value="1" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Style="{StaticResource Section}" Text="{x:Static r:SettingsText.PushToTalk}" />
          <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="200" />
              <ColumnDefinition Width="220" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static r:SettingsText.HoldToTalk}" VerticalAlignment="Center" />
            <local:HotkeyBox Grid.Column="1" GestureText="{Binding PushToTalkText}" AutomationProperties.Name="{x:Static r:SettingsText.PushToTalk}"
                             GotKeyboardFocus="OnHotkeyBoxGotFocus" LostKeyboardFocus="OnHotkeyBoxLostFocus" />
            <Button Grid.Column="2" Content="{x:Static r:SettingsText.Clear}" Command="{Binding ClearPushToTalkCommand}" Margin="8,0,0,0" />
            <TextBlock Grid.Column="3" Text="{Binding PushToTalkStatus}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Opacity" Value="0.75" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding PushToTalkHasProblem}" Value="True">
                      <Setter Property="Foreground" Value="#D13438" />
                      <Setter Property="Opacity" Value="1" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
          <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:SettingsText.PushToTalkHint}" />
        </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================== General ============================== -->
      <TabItem Header="{x:Static r:SettingsText.GeneralTab}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12,4,12,12">
          <TextBlock Style="{StaticResource Section}" Text="{x:Static r:SettingsText.StartupSection}" />
          <CheckBox Margin="0,2" Content="{x:Static r:SettingsText.StartWithWindows}" IsChecked="{Binding StartWithWindows}" />

          <TextBlock Style="{StaticResource Section}" Text="{x:Static r:SettingsText.OcrSection}" />
          <ComboBox ItemsSource="{Binding OcrLanguages}" SelectedItem="{Binding OcrLanguage}" DisplayMemberPath="Label"
                    HorizontalAlignment="Left" MinWidth="320" AutomationProperties.Name="{x:Static r:SettingsText.OcrLanguage}" />
          <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:SettingsText.OcrHint}" />

          <TextBlock Style="{StaticResource Section}" Text="{x:Static r:SettingsText.ScreenToolsSection}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="220" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition />
              <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="{x:Static r:SettingsText.RulerDpi}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding RulerDpiChoices}" SelectedItem="{Binding RulerDpi}" DisplayMemberPath="Label"
                      HorizontalAlignment="Left" MinWidth="280" AutomationProperties.Name="{x:Static r:SettingsText.RulerDpiName}" />
            <TextBlock Grid.Row="1" Text="{x:Static r:SettingsText.ColorCopyFormat}" VerticalAlignment="Center" Margin="0,8,0,0" />
            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ColorFormats}" SelectedItem="{Binding ColorCopyFormat}" ItemTemplate="{StaticResource EnumItem}"
                      HorizontalAlignment="Left" MinWidth="280" Margin="0,8,0,0" AutomationProperties.Name="{x:Static r:SettingsText.ColorCopyFormat}" />
          </Grid>
          <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:SettingsText.ScreenToolsHint}" />

          <TextBlock Style="{StaticResource Section}" Text="{x:Static r:SettingsText.AppearanceSection}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" MinWidth="120" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition />
              <RowDefinition />
            </Grid.RowDefinitions>
            <Label Content="{x:Static r:SettingsText.ThemeLabel}" Target="{Binding ElementName=ThemeBox}" VerticalAlignment="Center" Padding="0" Margin="0,0,12,0" />
            <ComboBox x:Name="ThemeBox" Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" ItemTemplate="{StaticResource EnumItem}"
                      HorizontalAlignment="Left" MinWidth="220" AutomationProperties.Name="{x:Static r:SettingsText.ThemeName}" />
            <Label Grid.Row="1" Content="{x:Static r:SettingsText.LanguageLabel}" Target="{Binding ElementName=LanguageBox}" VerticalAlignment="Center" Padding="0" Margin="0,8,12,0" />
            <ComboBox x:Name="LanguageBox" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" ItemTemplate="{StaticResource EnumItem}"
                      HorizontalAlignment="Left" MinWidth="220" Margin="0,8,0,0" AutomationProperties.Name="{x:Static r:SettingsText.LanguageName}" />
          </Grid>
          <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:SettingsText.LanguageHint}" />

          <TextBlock Style="{StaticResource Section}" Text="{x:Static r:SettingsText.HistorySection}" />
          <ComboBox ItemsSource="{Binding HistorySizes}" SelectedItem="{Binding HistorySize}" DisplayMemberPath="Label"
                    HorizontalAlignment="Left" MinWidth="220" AutomationProperties.Name="{x:Static r:SettingsText.HistorySize}" />
          <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:SettingsText.HistoryHint}" />

          <TextBlock Style="{StaticResource Section}" Text="{x:Static r:SettingsText.UpdatesSection}" />
          <TextBlock Text="{Binding VersionText}" />
          <CheckBox Margin="0,6,0,2" Content="{x:Static r:SettingsText.CheckForUpdates}"
                    IsChecked="{Binding CheckForUpdates}" IsEnabled="{Binding CanCheckForUpdates}" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button Content="{x:Static r:SettingsText.CheckNow}" Command="{Binding CheckForUpdatesNowCommand}" MinWidth="100" />
            <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0" MaxWidth="440" Opacity="0.8" />
          </StackPanel>
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" MinWidth="120" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Content="{x:Static r:UpdatesText.ChannelLabel}" Target="{Binding ElementName=ChannelBox}" VerticalAlignment="Center" Padding="0" Margin="0,0,12,0" />
            <ComboBox x:Name="ChannelBox" Grid.Column="1" ItemsSource="{Binding UpdateChannels}" SelectedItem="{Binding UpdateChannel}" DisplayMemberPath="Label"
                      HorizontalAlignment="Left" MinWidth="280" IsEnabled="{Binding CanCheckForUpdates}" AutomationProperties.Name="{x:Static r:UpdatesText.ChannelName}" />
          </Grid>
          <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:UpdatesText.ChannelHint}" />
          <Button Content="{x:Static r:UpdatesText.WhatsNew}" Command="{Binding ShowReleaseNotesCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />

          <TextBlock Style="{StaticResource Section}" Text="{x:Static r:CommonText.LicenseSection}" />
          <TextBlock Text="{Binding LicenseText}" TextWrapping="Wrap" />

          <TextBlock Style="{StaticResource Section}" Text="{x:Static r:DiagnosticsText.PrivacySection}" />
          <CheckBox Margin="0,2" Content="{x:Static r:DiagnosticsText.SendCrashReports}" IsChecked="{Binding SendCrashReports}" IsEnabled="{Binding CrashReportsAvailable}" />
          <TextBlock Style="{StaticResource Hint}" Text="{Binding CrashReportsText}" />

          <TextBlock Style="{StaticResource Section}" Text="{x:Static r:SettingsText.SettingsSection}" />
          <TextBlock Text="{Binding PortableText}" TextWrapping="Wrap" Margin="0,0,0,8"
                     Visibility="{Binding PortableText, Converter={StaticResource VisibleIfSet}}" />
          <WrapPanel>
            <Button Content="{x:Static r:SettingsText.ExportSettings}" Command="{Binding ExportSettingsCommand}" Margin="0,0,8,6" />
            <Button Content="{x:Static r:SettingsText.ImportSettings}" Command="{Binding ImportSettingsCommand}" Margin="0,0,8,6" />
            <Button Content="{x:Static r:SettingsText.ResetAllSettings}" Command="{Binding ResetAllSettingsCommand}" Margin="0,0,8,6" />
          </WrapPanel>
          <TextBlock Text="{Binding SettingsFileStatus}" TextWrapping="Wrap" Opacity="0.8" AutomationProperties.LiveSetting="Polite"
                     Visibility="{Binding SettingsFileStatus, Converter={StaticResource VisibleIfSet}}" />
          <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:SettingsText.SettingsTransferHint}" />

          <TextBlock Style="{StaticResource Section}" Text="{x:Static r:SettingsText.AdvancedSection}" />
          <Button Content="{x:Static r:SettingsText.OpenSettingsFile}" Command="{Binding OpenSettingsFileCommand}" HorizontalAlignment="Left" />
          <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:SettingsText.OpenSettingsFileHint}" />
          <Button Content="{x:Static r:SettingsText.ExportDiagnostics}" Command="{Binding ExportDiagnosticsCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
          <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:SettingsText.DiagnosticsHint}" />
        </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
