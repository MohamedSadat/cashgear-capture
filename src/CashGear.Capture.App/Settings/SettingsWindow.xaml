<Window x:Class="CashGear.Capture.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CashGear.Capture.App.Settings"
        xmlns:wpf="clr-namespace:CashGear.Capture.App.Wpf"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:SettingsViewModel}"
        Title="CashGear Capture Settings"
        Width="680" Height="600" MinWidth="560" MinHeight="500"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <local:EnumLabelConverter x:Key="Label" />
    <DataTemplate x:Key="EnumItem">
      <TextBlock Text="{Binding Converter={StaticResource Label}}" />
    </DataTemplate>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Margin" Value="0,12,0,6" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
  </Window.Resources>

  <DockPanel Margin="16">
    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Button Content="Reset to defaults" Command="{Binding ResetToDefaultsCommand}" HorizontalAlignment="Left" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="OK" IsDefault="True" Command="{Binding SaveCommand}" MinWidth="90" Margin="0,0,8,0" />
        <Button Content="Cancel" IsCancel="True" Command="{Binding CancelCommand}" MinWidth="90" Margin="0,0,8,0" />
        <Button Content="Apply" Command="{Binding ApplyCommand}" MinWidth="90" />
      </StackPanel>
    </Grid>

    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Errors}" Foreground="#D13438" TextWrapping="Wrap" Margin="0,10,0,0"
               Visibility="{Binding HasErrors, Converter={StaticResource Visible}}" />

    <TabControl x:Name="Tabs" SelectionChanged="OnTabChanged">
      <!-- ============================== Output ============================== -->
      <TabItem Header="Output">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12,4,12,12">
            <TextBlock Style="{StaticResource Section}" Text="After capture" />
            <CheckBox Margin="0,2" Content="Open in the editor" IsChecked="{Binding OpenEditor}" />
            <CheckBox Margin="0,2" Content="Save to file" IsChecked="{Binding SaveToFile}" />
            <CheckBox Margin="0,2" Content="Copy to clipboard" IsChecked="{Binding CopyToClipboard}" />

            <TextBlock Style="{StaticResource Section}" Text="Folder" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="FolderBox" Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Capture folder" />
              <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseFolderCommand}" Margin="8,0,0,0" />
              <Button Grid.Column="2" Content="Open" Command="{Binding OpenCaptureFolderCommand}" Margin="8,0,0,0" />
            </Grid>
            <TextBlock Style="{StaticResource Hint}">
              <Run Text="Empty means the default:" />
              <Run Text="{Binding DefaultFolder, Mode=OneWay}" />
            </TextBlock>

            <TextBlock Style="{StaticResource Section}" Text="Format" />
            <StackPanel Orientation="Horizontal">
              <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}" ItemTemplate="{StaticResource EnumItem}" MinWidth="160"
                        AutomationProperties.Name="Image format" />
              <TextBlock Text="JPEG quality" VerticalAlignment="Center" Margin="20,0,8,0"
                         Visibility="{Binding IsJpeg, Converter={StaticResource Visible}}" />
              <Slider Minimum="1" Maximum="100" Value="{Binding JpegQuality}" Width="160" VerticalAlignment="Center"
                      IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.Name="JPEG quality"
                      Visibility="{Binding IsJpeg, Converter={StaticResource Visible}}" />
              <TextBlock Text="{Binding JpegQuality}" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="28"
                         Visibility="{Binding IsJpeg, Converter={StaticResource Visible}}" />
            </StackPanel>

            <TextBlock Style="{StaticResource Section}" Text="File name" />
            <TextBox Text="{Binding FileNameTemplate, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="File name template" />
            <TextBlock Style="{StaticResource Hint}">
              <Run Text="Example:" />
              <Run Text="{Binding FileNamePreview, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>
            <ItemsControl ItemsSource="{Binding TokenHelp}" Margin="0,8,0,0" Opacity="0.7" FontFamily="Consolas" FontSize="12" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================== Capture ============================== -->
      <TabItem Header="Capture">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12,4,12,12">
            <TextBlock Style="{StaticResource Section}" Text="Timing" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <TextBlock Text="Capture delay" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding DelayChoices}" SelectedItem="{Binding DelaySeconds}" ItemStringFormat="{}{0} s"
                        HorizontalAlignment="Left" MinWidth="120" AutomationProperties.Name="Capture delay" />
              <TextBlock Grid.Row="1" Text="Wait for app windows to hide" VerticalAlignment="Center" Margin="0,8,0,0" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding HideDelayChoices}" SelectedItem="{Binding HideDelayMs}" ItemStringFormat="{}{0} ms"
                        HorizontalAlignment="Left" MinWidth="120" Margin="0,8,0,0" AutomationProperties.Name="Hide delay" />
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Text="The capture delay gives you time to open a menu or hover a tooltip before the screen is taken." />
            <Expander Header="Delay per kind of capture" Margin="0,8,0,0">
              <StackPanel Margin="0,6,0,0">
                <ItemsControl ItemsSource="{Binding ModeDelays}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ModeDelayRow}">
                      <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="220" />
                          <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" SelectedItem="{Binding Choice}" HorizontalAlignment="Left" MinWidth="200"
                                  ItemsSource="{Binding DataContext.ModeDelayChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  AutomationProperties.Name="{Binding Label}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Hint}" Text="Repeat Last Capture waits as long as the kind of capture it repeats. An open menu is captured 3 seconds after you ask, unless set otherwise: time to open it." />
              </StackPanel>
            </Expander>

            <TextBlock Style="{StaticResource Section}" Text="Content" />
            <CheckBox Margin="0,2" Content="Include the mouse cursor" IsChecked="{Binding IncludeCursor}" />
            <CheckBox Margin="0,2" Content="Add a drop shadow to window captures" IsChecked="{Binding IncludeWindowShadow}" />

            <TextBlock Style="{StaticResource Section}" Text="Capture toolbar" />
            <CheckBox Margin="0,2" Content="Show the capture toolbar when the app starts" IsChecked="{Binding ShowToolbarAtStartup}" />
            <TextBlock Style="{StaticResource Hint}" Text="A small bar with a button for every kind of capture, always on top and never in a capture. Tray › Capture Toolbar shows it now; drag it by its grip, and drop it at the edge of a screen to dock it there." />

            <TextBlock Style="{StaticResource Section}" Text="Shapes" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <TextBlock Text="Fixed-size region" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding FixedSizeChoices}" IsEditable="True" Text="{Binding FixedRegionSize, UpdateSourceTrigger=PropertyChanged}"
                        HorizontalAlignment="Left" MinWidth="160" AutomationProperties.Name="Fixed-size region" />
              <TextBlock Grid.Row="1" Text="Rounded region corners" VerticalAlignment="Center" Margin="0,8,0,0" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding CornerRadiusChoices}" SelectedItem="{Binding CornerRadius}" ItemStringFormat="{}{0} px"
                        HorizontalAlignment="Left" MinWidth="120" Margin="0,8,0,0" AutomationProperties.Name="Corner radius" />
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Text="Any size can be typed (width × height). On the screen, Tab switches between the sizes and the mouse wheel changes the corner radius; the last ones used are kept. Freehand, polygon, rounded and menu captures are transparent outside their shape, so they are saved as PNG whatever the format on the Output tab." />

            <TextBlock Style="{StaticResource Section}" Text="Full screen" />
            <ComboBox ItemsSource="{Binding FullScreenOutputs}" SelectedItem="{Binding FullScreenOutput}" ItemTemplate="{StaticResource EnumItem}"
                      HorizontalAlignment="Left" MinWidth="260" AutomationProperties.Name="Full screen output" />

            <TextBlock Style="{StaticResource Section}" Text="Scrolling capture" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <TextBlock Text="Wait after each scroll" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding ScrollSettleChoices}" SelectedItem="{Binding ScrollSettleMs}" ItemStringFormat="{}{0} ms"
                        HorizontalAlignment="Left" MinWidth="120" AutomationProperties.Name="Wait after each scroll" />
              <TextBlock Grid.Row="1" Text="Stop at a height of" VerticalAlignment="Center" Margin="0,8,0,0" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ScrollMaxHeightChoices}" SelectedItem="{Binding ScrollMaxHeight}" ItemStringFormat="{}{0:N0} px"
                        HorizontalAlignment="Left" MinWidth="120" Margin="0,8,0,0" AutomationProperties.Name="Maximum height" />
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Text="Pick a window, then click where it scrolls. It is scrolled from where it is down to the bottom; Esc cancels. Allow more time for pages that load as they scroll." />

            <TextBlock Style="{StaticResource Section}" Text="Capture method" />
            <ComboBox ItemsSource="{Binding Backends}" SelectedItem="{Binding Backend}" ItemTemplate="{StaticResource EnumItem}"
                      HorizontalAlignment="Left" MinWidth="260" AutomationProperties.Name="Capture method" />
            <TextBlock Style="{StaticResource Hint}" Text="Automatic avoids the yellow capture border on Windows 10 and still captures covered windows correctly." />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================== Recording ============================== -->
      <TabItem Header="Recording" x:Name="RecordingTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12,4,12,12">
            <TextBlock Style="{StaticResource Section}" Text="Video" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <TextBlock Text="Frames per second" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding FrameRates}" SelectedItem="{Binding RecordingFps}" ItemStringFormat="{}{0} fps"
                        HorizontalAlignment="Left" MinWidth="120" AutomationProperties.Name="Frames per second" />
              <TextBlock Grid.Row="1" Text="Quality" VerticalAlignment="Center" Margin="0,10,0,0" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding QualityPresets}" SelectedItem="{Binding RecordingQuality}" ItemTemplate="{StaticResource EnumItem}"
                        HorizontalAlignment="Left" MinWidth="260" Margin="0,10,0,0" AutomationProperties.Name="Quality" />
              <TextBlock Grid.Row="2" Text="Encoder" VerticalAlignment="Center" Margin="0,10,0,0" />
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                <ComboBox ItemsSource="{Binding Encoders}" SelectedItem="{Binding RecordingEncoder}" DisplayMemberPath="Label"
                          MinWidth="260" MaxWidth="420" AutomationProperties.Name="Encoder" />
                <Button Content="Check again" Command="{Binding RedetectEncodersCommand}" Margin="8,0,0,0" Padding="10,2"
                        ToolTip="Test every encoder again (after a driver update or a new graphics card)" />
              </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Text="{Binding EncoderStatus}" />
            <TextBlock Style="{StaticResource Hint}" Text="Automatic uses the graphics card's encoder when it works here, which leaves the CPU free; otherwise the encoder built into Windows. If an encoder stops working during a recording, another takes over and the rest is saved as a second file." />

            <TextBlock Style="{StaticResource Section}" Text="Mouse" />
            <CheckBox Margin="0,2" Content="Show the mouse pointer" IsChecked="{Binding RecordingIncludeCursor}" />
            <TextBlock Style="{StaticResource Hint}" Text="Clicks, pointer effects, keystrokes and the webcam are on the Overlays tab." />

            <TextBlock Style="{StaticResource Section}" Text="Sound" />
            <CheckBox Margin="0,2" Content="Record system audio (what you hear)" IsChecked="{Binding RecordSystemAudio}" />
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <TextBlock Text="System audio" VerticalAlignment="Center" Visibility="{Binding IsAppAudioSupported, Converter={StaticResource Visible}}" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding SystemAudioScopes}" SelectedItem="{Binding RecordingSystemAudioScope}" ItemTemplate="{StaticResource EnumItem}"
                        HorizontalAlignment="Left" MinWidth="260" IsEnabled="{Binding RecordSystemAudio}" AutomationProperties.Name="Which system audio"
                        Visibility="{Binding IsAppAudioSupported, Converter={StaticResource Visible}}" />
              <TextBlock Grid.Row="1" Text="App" VerticalAlignment="Center" Margin="0,8,0,0" Visibility="{Binding IsAppAudioSupported, Converter={StaticResource Visible}}" />
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding IsAppAudioSupported, Converter={StaticResource Visible}}">
                <ComboBox ItemsSource="{Binding Apps}" SelectedItem="{Binding RecordingApp}" DisplayMemberPath="Label"
                          MinWidth="260" MaxWidth="420" IsEnabled="{Binding IsAppChoiceEnabled}" AutomationProperties.Name="App" />
                <Button Content="Refresh" Command="{Binding RefreshAppsCommand}" Margin="8,0,0,0" Padding="10,2" IsEnabled="{Binding IsAppChoiceEnabled}"
                        ToolTip="List the apps running now (start the app first if it isn't listed)" />
              </StackPanel>
              <TextBlock Grid.Row="2" Text="System audio from" VerticalAlignment="Center" Margin="0,8,0,0" />
              <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding RecordingOutput}" DisplayMemberPath="Label"
                        HorizontalAlignment="Left" MinWidth="260" MaxWidth="420" Margin="0,8,0,0" IsEnabled="{Binding IsOutputChoiceEnabled}" AutomationProperties.Name="System audio from" />
              <TextBlock Grid.Row="3" Text="Microphone" VerticalAlignment="Center" Margin="0,8,0,0" />
              <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Microphones}" SelectedItem="{Binding RecordingMicrophone}" DisplayMemberPath="Label"
                        HorizontalAlignment="Left" MinWidth="260" MaxWidth="420" Margin="0,8,0,0" AutomationProperties.Name="Microphone" />
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Text="{Binding SpeakersStatus}" />

            <TextBlock Text="Microphone processing" FontWeight="SemiBold" Margin="0,12,0,4" />
            <StackPanel IsEnabled="{Binding HasMicrophone}">
              <StackPanel Orientation="Horizontal" Margin="0,2" Visibility="{Binding CanSuppressNoise, Converter={StaticResource Visible}}">
                <CheckBox Content="Noise suppression (RNNoise): remove fans, hum and typing, strength" IsChecked="{Binding MicrophoneNoiseSuppression}" VerticalAlignment="Center" />
                <Slider Width="140" Margin="8,0,0,0" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" Value="{Binding NoiseSuppressionStrength}"
                        IsSnapToTickEnabled="True" TickFrequency="5" IsEnabled="{Binding MicrophoneNoiseSuppression}" VerticalAlignment="Center"
                        AutomationProperties.Name="Noise suppression strength" />
                <TextBlock Text="{Binding NoiseSuppressionStrengthText}" Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="44" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,2">
                <CheckBox Content="Noise gate: silence the microphone between words, below" IsChecked="{Binding MicrophoneGate}" VerticalAlignment="Center" />
                <Slider Width="140" Margin="8,0,0,0" Minimum="{Binding MinGateThresholdDb}" Maximum="{Binding MaxGateThresholdDb}" SmallChange="1" LargeChange="5"
                        Value="{Binding GateThresholdDb}" IsSnapToTickEnabled="True" TickFrequency="1" IsEnabled="{Binding MicrophoneGate}" VerticalAlignment="Center"
                        AutomationProperties.Name="Noise gate threshold" />
                <TextBlock Text="{Binding GateThresholdText}" Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="44" />
              </StackPanel>
              <CheckBox Margin="0,2" Content="Compressor: even out loud and quiet speech" IsChecked="{Binding MicrophoneCompressor}" />
              <CheckBox Margin="0,2" Content="Limiter: never let the microphone go above −1 dB (no clipping)" IsChecked="{Binding MicrophoneLimiter}" />
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" Text="Applied to the microphone as it is recorded, in this order. The gate threshold is a peak level: set it between the room's noise and your quietest word. The microphone is held back 2 ms (10 ms more with noise suppression), and the recording takes that out, so it stays in sync." />

            <StackPanel Visibility="{Binding CanMonitor, Converter={StaticResource Visible}}">
              <TextBlock Text="Levels" FontWeight="SemiBold" Margin="0,12,0,4" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="220" />
                  <ColumnDefinition Width="240" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="Microphone (processed)" VerticalAlignment="Center" />
                <wpf:LevelMeter Grid.Column="1" Height="10" VerticalAlignment="Center" AutomationProperties.Name="Microphone level"
                                Peak="{Binding MicrophoneLevel.Peak}" Rms="{Binding MicrophoneLevel.Rms}" Hold="{Binding MicrophoneLevel.Hold}" Clipping="{Binding MicrophoneLevel.Clipping}" />
                <TextBlock Grid.Column="2" Text="{Binding MicrophoneLevel.Text}" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.75" />
                <TextBlock Grid.Row="1" Text="System audio" VerticalAlignment="Center" Margin="0,8,0,0" />
                <wpf:LevelMeter Grid.Row="1" Grid.Column="1" Height="10" VerticalAlignment="Center" Margin="0,8,0,0" AutomationProperties.Name="System audio level"
                                Peak="{Binding SystemAudioLevel.Peak}" Rms="{Binding SystemAudioLevel.Rms}" Hold="{Binding SystemAudioLevel.Hold}" Clipping="{Binding SystemAudioLevel.Clipping}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SystemAudioLevel.Text}" Margin="10,8,0,0" VerticalAlignment="Center" Opacity="0.75" />
              </Grid>
              <TextBlock Style="{StaticResource Hint}" Text="{Binding MonitorStatus}" Foreground="#D13438" />
              <TextBlock Style="{StaticResource Hint}" Text="The meters listen while this page is open, to what a recording would record with the choices above. Speech peaking around −12 dB is right; the mark at the right end turns red when the sound clipped." />

              <TextBlock Text="Microphone test" FontWeight="SemiBold" Margin="0,12,0,4" />
              <StackPanel Orientation="Horizontal">
                <Button Content="Record 5 seconds" Command="{Binding TestMicrophoneCommand}" Padding="10,2" />
                <Button Content="Play as recorded" Command="{Binding PlayOriginalCommand}" Padding="10,2" Margin="8,0,0,0" />
                <Button Content="Play with processing" Command="{Binding PlayProcessedCommand}" Padding="10,2" Margin="8,0,0,0" />
                <Button Content="Stop" Command="{Binding StopPlaybackCommand}" Padding="10,2" Margin="8,0,0,0" />
              </StackPanel>
              <TextBlock Style="{StaticResource Hint}" Text="{Binding MicrophoneTestStatus}" />
            </StackPanel>

            <TextBlock Text="Loudness" FontWeight="SemiBold" Margin="0,12,0,4" />
            <CheckBox Margin="0,2" Content="Even out the loudness to −16 LUFS when a recording is saved" IsChecked="{Binding NormalizeLoudness}" />
            <TextBlock Style="{StaticResource Hint}" Text="Every recording then plays at the same loudness, the usual level for speech online, however loud the microphone or the sound was. Each sound track is measured, then encoded again (EBU R128, FFmpeg's loudnorm in two passes); the video is copied as it is. Peaks are kept below −1.5 dB. A silent track is left alone. Saving takes a few seconds more per 10 minutes." />
            <TextBlock Style="{StaticResource Hint}" Visibility="{Binding IsAppAudioSupported, Converter={StaticResource Visible}}"
                       Text="Only one app records that app's sound (and that of the programs it starts) on whichever device it plays, and nothing else: no notifications, no other apps. All sound except one app leaves out, say, a call or music you don't want in the video. The app is found by its program when the recording starts, and followed if it starts or restarts later." />
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <TextBlock Text="With both" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding TrackLayouts}" SelectedItem="{Binding RecordingTracks}" ItemTemplate="{StaticResource EnumItem}"
                        HorizontalAlignment="Left" MinWidth="260" AutomationProperties.Name="Sound tracks" />
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Text="Sound is saved in the MP4 as AAC. Players play the first track only, so a track per source is for video editors. Volume and mute for each source are on the recording toolbar. Pause pauses the sound too. Without a sound device the video is recorded without sound, and the notification says so." />

            <TextBlock Style="{StaticResource Section}" Text="FFmpeg" />
            <TextBlock Text="{Binding FfmpegStatus}" TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Opacity" Value="0.75" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFfmpegMissing}" Value="True">
                      <Setter Property="Foreground" Value="#D13438" />
                      <Setter Property="Opacity" Value="1" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Style="{StaticResource Hint}" Text="Start and stop a recording from the tray or with the recording hotkey. Recordings are saved as MP4 in the capture folder. While recording, the video is written to a temporary file, so if the app or the PC stops, the recording can be saved from the tray menu afterwards." />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================== Overlays ============================== -->
      <TabItem Header="Overlays" x:Name="OverlaysTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12,4,12,12" DataContext="{Binding Overlays}">
            <TextBlock Style="{StaticResource Section}" Text="While recording" />
            <RadioButton Margin="0,2" Content="Draw the overlays into the video" IsChecked="{Binding BurnIn}" GroupName="BurnIn" />
            <RadioButton Margin="0,2" Content="Keep the video clean, and add the overlays later" GroupName="BurnIn"
                         IsChecked="{Binding BurnIn, Converter={x:Static local:InverseBooleanConverter.Instance}}" />
            <TextBlock Style="{StaticResource Hint}" Text="Added later: tray menu › Add overlays to a recording…, which needs the metadata file. The overlays are drawn the same way either way." />
            <CheckBox Margin="0,8,0,2" Content="Save a metadata file next to each recording (name.cgmeta.json)" IsChecked="{Binding WriteMetadata}" />
            <TextBlock Style="{StaticResource Hint}" Text="The pointer on every frame, the clicks, the keys as the keystroke overlay shows them, and which app was in front, on the video's clock: for adding overlays later and for editing." />

            <TextBlock Style="{StaticResource Section}" Text="Clicks" />
            <CheckBox Margin="0,2" Content="Show clicks with an expanding ring" IsChecked="{Binding ClicksEnabled}" />
            <Grid Margin="0,6,0,0" IsEnabled="{Binding ClicksEnabled}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <TextBlock Text="Left button" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding Colors}" SelectedItem="{Binding LeftColor}" HorizontalAlignment="Left" MinWidth="160"
                        AutomationProperties.Name="Left button colour" />
              <TextBlock Grid.Row="1" Text="Right button" VerticalAlignment="Center" Margin="0,6,0,0" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Colors}" SelectedItem="{Binding RightColor}" HorizontalAlignment="Left" MinWidth="160"
                        Margin="0,6,0,0" AutomationProperties.Name="Right button colour" />
              <TextBlock Grid.Row="2" Text="Middle and side buttons" VerticalAlignment="Center" Margin="0,6,0,0" />
              <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Colors}" SelectedItem="{Binding MiddleColor}" HorizontalAlignment="Left" MinWidth="160"
                        Margin="0,6,0,0" AutomationProperties.Name="Middle button colour" />
              <TextBlock Grid.Row="3" Text="Ring size" VerticalAlignment="Center" Margin="0,6,0,0" />
              <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                <Slider Minimum="16" Maximum="80" Width="200" Value="{Binding ClickSize}" IsSnapToTickEnabled="True" TickFrequency="2"
                        VerticalAlignment="Center" AutomationProperties.Name="Ring size" />
                <TextBlock Text="{Binding ClickSize, StringFormat={}{0:0} px}" VerticalAlignment="Center" Margin="8,0,0,0" />
              </StackPanel>
            </Grid>
            <CheckBox Margin="0,8,0,2" Content="Add a click sound to the recording's sound" IsChecked="{Binding ClickSound}" />
            <TextBlock Style="{StaticResource Hint}" Text="A short tick at each press, mixed into the recording (it isn't played aloud); with a track per source it gets a track of its own." />

            <TextBlock Style="{StaticResource Section}" Text="Pointer" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <TextBlock Text="Effect" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding PointerEffects}" SelectedItem="{Binding PointerEffect}" ItemTemplate="{StaticResource EnumItem}"
                        HorizontalAlignment="Left" MinWidth="200" AutomationProperties.Name="Pointer effect" />
              <TextBlock Grid.Row="1" Text="Halo colour" VerticalAlignment="Center" Margin="0,6,0,0" Visibility="{Binding IsHalo, Converter={StaticResource Visible}}" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Colors}" SelectedItem="{Binding PointerColor}" HorizontalAlignment="Left" MinWidth="160"
                        Margin="0,6,0,0" AutomationProperties.Name="Halo colour" Visibility="{Binding IsHalo, Converter={StaticResource Visible}}" />
              <TextBlock Grid.Row="2" Text="Radius" VerticalAlignment="Center" Margin="0,6,0,0" Visibility="{Binding HasEffect, Converter={StaticResource Visible}}" />
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding HasEffect, Converter={StaticResource Visible}}">
                <Slider Minimum="20" Maximum="400" Width="200" Value="{Binding PointerRadius}" IsSnapToTickEnabled="True" TickFrequency="5"
                        VerticalAlignment="Center" AutomationProperties.Name="Effect radius" />
                <TextBlock Text="{Binding PointerRadius, StringFormat={}{0:0} px}" VerticalAlignment="Center" Margin="8,0,0,0" />
              </StackPanel>
              <TextBlock Grid.Row="3" Text="Dim the rest by" VerticalAlignment="Center" Margin="0,6,0,0" Visibility="{Binding IsSpotlight, Converter={StaticResource Visible}}" />
              <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding IsSpotlight, Converter={StaticResource Visible}}">
                <Slider Minimum="10" Maximum="90" Width="200" Value="{Binding PointerDim}" IsSnapToTickEnabled="True" TickFrequency="5"
                        VerticalAlignment="Center" AutomationProperties.Name="Spotlight dimming" />
                <TextBlock Text="{Binding PointerDim, StringFormat={}{0:0}%}" VerticalAlignment="Center" Margin="8,0,0,0" />
              </StackPanel>
              <TextBlock Grid.Row="4" Text="Pointer size" VerticalAlignment="Center" Margin="0,6,0,0" />
              <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                <Slider Minimum="1" Maximum="3" Width="200" Value="{Binding PointerScale}" IsSnapToTickEnabled="True" TickFrequency="0.25"
                        VerticalAlignment="Center" AutomationProperties.Name="Pointer size" />
                <TextBlock Text="{Binding PointerScaleText}" VerticalAlignment="Center" Margin="8,0,0,0" />
              </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <CheckBox Content="Hide the pointer when it stands still for" IsChecked="{Binding HideIdlePointer}" VerticalAlignment="Center" />
              <Slider Minimum="1" Maximum="30" Width="120" Margin="8,0,0,0" Value="{Binding IdleSeconds}" IsSnapToTickEnabled="True" TickFrequency="1"
                      VerticalAlignment="Center" IsEnabled="{Binding HideIdlePointer}" AutomationProperties.Name="Idle time" />
              <TextBlock Text="{Binding IdleSeconds, StringFormat={}{0:0} s}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" Text="A bigger pointer, or hiding it, means the app draws the pointer itself instead of Windows (a text cursor is drawn black with a white edge). Needs Recording › Show the mouse pointer." />

            <TextBlock Style="{StaticResource Section}" Text="Keystrokes" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <TextBlock Text="Show" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding KeystrokeModes}" SelectedItem="{Binding KeystrokeMode}" ItemTemplate="{StaticResource EnumItem}"
                        HorizontalAlignment="Left" MinWidth="260" AutomationProperties.Name="Keystrokes shown" />
              <TextBlock Grid.Row="1" Text="Where" VerticalAlignment="Center" Margin="0,6,0,0" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Positions}" SelectedItem="{Binding KeystrokePosition}" ItemTemplate="{StaticResource EnumItem}"
                        HorizontalAlignment="Left" MinWidth="200" Margin="0,6,0,0" IsEnabled="{Binding KeystrokesOn}" AutomationProperties.Name="Keystroke position" />
              <TextBlock Grid.Row="2" Text="Font" VerticalAlignment="Center" Margin="0,6,0,0" />
              <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Fonts}" Text="{Binding KeystrokeFont, UpdateSourceTrigger=LostFocus}" IsEditable="True"
                        HorizontalAlignment="Left" MinWidth="200" Margin="0,6,0,0" IsEnabled="{Binding KeystrokesOn}" AutomationProperties.Name="Keystroke font" />
              <TextBlock Grid.Row="3" Text="Size" VerticalAlignment="Center" Margin="0,6,0,0" />
              <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0" IsEnabled="{Binding KeystrokesOn}">
                <Slider Minimum="10" Maximum="72" Width="200" Value="{Binding KeystrokeSize}" IsSnapToTickEnabled="True" TickFrequency="1"
                        VerticalAlignment="Center" AutomationProperties.Name="Keystroke size" />
                <TextBlock Text="{Binding KeystrokeSize, StringFormat={}{0:0} pt}" VerticalAlignment="Center" Margin="8,0,0,0" />
              </StackPanel>
              <TextBlock Grid.Row="4" Text="Stay after the last key" VerticalAlignment="Center" Margin="0,6,0,0" />
              <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0" IsEnabled="{Binding KeystrokesOn}">
                <Slider Minimum="0.5" Maximum="10" Width="200" Value="{Binding KeystrokeFade}" IsSnapToTickEnabled="True" TickFrequency="0.5"
                        VerticalAlignment="Center" AutomationProperties.Name="Keystroke time" />
                <TextBlock Text="{Binding KeystrokeFade, StringFormat={}{0:0.0} s}" VerticalAlignment="Center" Margin="8,0,0,0" />
              </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Text="Keys typed into a password field are never shown or kept, nor keys typed into the apps below. Keys are only in the recording and its metadata file, nowhere else. The toolbar can hide them for a while during a recording." />
            <TextBlock Margin="0,10,0,4" Text="Never show keys typed into" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ListBox x:Name="ExcludedAppList" ItemsSource="{Binding ExcludedApps}" Height="96" AutomationProperties.Name="Apps whose keys are never shown" />
              <Button Grid.Column="1" Content="Remove" Margin="8,0,0,0" VerticalAlignment="Top" MinWidth="80"
                      Command="{Binding RemoveExcludedAppCommand}" CommandParameter="{Binding SelectedItem, ElementName=ExcludedAppList}" />
            </Grid>
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ComboBox ItemsSource="{Binding RunningApps}" Text="{Binding NewExcludedApp, UpdateSourceTrigger=PropertyChanged}" IsEditable="True"
                        DropDownOpened="OnExcludedAppsOpened" AutomationProperties.Name="App to add" ToolTip="A running app, or type a program's file name such as keepass.exe" />
              <Button Grid.Column="1" Content="Add" Margin="8,0,0,0" MinWidth="80" Command="{Binding AddExcludedAppCommand}" />
              <Button Grid.Column="2" Content="Refresh" Margin="8,0,0,0" Command="{Binding RefreshRunningAppsCommand}" />
            </Grid>

            <TextBlock Style="{StaticResource Section}" Text="Webcam" />
            <CheckBox Margin="0,2" Content="Record the webcam: drawn over the recording, and kept as a video track of its own" IsChecked="{Binding WebcamEnabled}" />
            <Grid Margin="0,6,0,0" IsEnabled="{Binding WebcamEnabled}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <TextBlock Text="Camera" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding Cameras}" SelectedItem="{Binding Camera}" MinWidth="240" MaxWidth="340" AutomationProperties.Name="Camera" />
                <Button Content="Refresh" Command="{Binding RefreshCamerasCommand}" Margin="8,0,0,0" Padding="10,2" />
              </StackPanel>
              <TextBlock Grid.Row="1" Text="Picture" VerticalAlignment="Center" Margin="0,6,0,0" />
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                <ComboBox ItemsSource="{Binding WebcamSizes}" SelectedItem="{Binding WebcamSize}" MinWidth="120" AutomationProperties.Name="Webcam picture size" />
                <ComboBox ItemsSource="{Binding WebcamRates}" SelectedItem="{Binding WebcamFps}" ItemStringFormat="{}{0} fps" MinWidth="80" Margin="8,0,0,0"
                          AutomationProperties.Name="Webcam frame rate" />
              </StackPanel>
              <TextBlock Grid.Row="2" Text="Shape" VerticalAlignment="Center" Margin="0,6,0,0" />
              <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding WebcamShapes}" SelectedItem="{Binding WebcamShape}" ItemTemplate="{StaticResource EnumItem}"
                        HorizontalAlignment="Left" MinWidth="160" Margin="0,6,0,0" AutomationProperties.Name="Webcam shape" />
              <TextBlock Grid.Row="3" Text="Size (share of the height)" VerticalAlignment="Center" Margin="0,6,0,0" />
              <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                <Slider Minimum="10" Maximum="60" Width="200" Value="{Binding WebcamHeight}" IsSnapToTickEnabled="True" TickFrequency="1"
                        VerticalAlignment="Center" AutomationProperties.Name="Webcam size" />
                <TextBlock Text="{Binding WebcamHeight, StringFormat={}{0:0}%}" VerticalAlignment="Center" Margin="8,0,0,0" />
              </StackPanel>
              <TextBlock Grid.Row="4" Text="Border" VerticalAlignment="Center" Margin="0,6,0,0" />
              <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                <ComboBox ItemsSource="{Binding Colors}" SelectedItem="{Binding WebcamBorderColor}" MinWidth="120" AutomationProperties.Name="Webcam border colour" />
                <Slider Minimum="0" Maximum="12" Width="120" Margin="8,0,0,0" Value="{Binding WebcamBorderWidth}" IsSnapToTickEnabled="True" TickFrequency="1"
                        VerticalAlignment="Center" AutomationProperties.Name="Webcam border width" />
                <TextBlock Text="{Binding WebcamBorderWidth, StringFormat={}{0:0} px}" VerticalAlignment="Center" Margin="8,0,0,0" />
              </StackPanel>
              <CheckBox Grid.Row="5" Grid.Column="1" Margin="0,8,0,0" Content="Mirror it (its own track stays as the camera sees)" IsChecked="{Binding WebcamMirror}" />
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Text="{Binding WebcamStatus}" />
            <Border x:Name="WebcamArea" Width="320" Height="180" Margin="0,8,0,0" HorizontalAlignment="Left" Background="#FF2B2B2B" ClipToBounds="True"
                    BorderBrush="#60808080" BorderThickness="1" IsEnabled="{Binding WebcamEnabled}">
              <Canvas x:Name="WebcamCanvas">
                <TextBlock Canvas.Left="8" Canvas.Top="6" Text="The recorded area" Foreground="#A0FFFFFF" FontSize="11" />
                <Border x:Name="WebcamBox" Cursor="SizeAll" MouseLeftButtonDown="OnWebcamDragStart" MouseMove="OnWebcamDrag" MouseLeftButtonUp="OnWebcamDragEnd"
                        AutomationProperties.Name="Webcam placement">
                  <Border.Background>
                    <ImageBrush x:Name="WebcamImage" Stretch="UniformToFill" />
                  </Border.Background>
                </Border>
              </Canvas>
            </Border>
            <TextBlock Style="{StaticResource Hint}" Text="Drag the webcam to where it goes. With a camera, its picture shows here while this page is open." />

            <TextBlock Style="{StaticResource Section}" Text="Drawing on the screen" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <TextBlock Text="Pen colour" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding Colors}" SelectedItem="{Binding PenColor}" HorizontalAlignment="Left" MinWidth="160"
                        AutomationProperties.Name="Pen colour" />
              <TextBlock Grid.Row="1" Text="Pen width" VerticalAlignment="Center" Margin="0,6,0,0" />
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                <Slider Minimum="1" Maximum="20" Width="200" Value="{Binding PenWidth}" IsSnapToTickEnabled="True" TickFrequency="1"
                        VerticalAlignment="Center" AutomationProperties.Name="Pen width" />
                <TextBlock Text="{Binding PenWidth, StringFormat={}{0:0} px}" VerticalAlignment="Center" Margin="8,0,0,0" />
              </StackPanel>
              <TextBlock Grid.Row="2" Text="Drawings fade away after" VerticalAlignment="Center" Margin="0,6,0,0" />
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                <Slider Minimum="0" Maximum="30" Width="200" Value="{Binding PenFade}" IsSnapToTickEnabled="True" TickFrequency="1"
                        VerticalAlignment="Center" AutomationProperties.Name="Drawings fade after" />
                <TextBlock Text="{Binding PenFadeText}" VerticalAlignment="Center" Margin="8,0,0,0" />
              </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Text="While recording, the Draw on Screen hotkey (Settings › Hotkeys) or the pen on the toolbar lets you draw over the recorded area; the drawing is recorded, the toolbar isn't. Esc ends drawing, Delete clears, Ctrl+Z undoes, 1 to 4 pick pen, highlighter, arrow or rectangle." />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================== Hotkeys ============================== -->
      <TabItem Header="Hotkeys">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12,4,12,12">
          <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,8"
                     Text="Click a box and press the keys. Backspace clears it. Hotkeys are paused while a box is selected, so PrintScreen can be recorded." />
          <ItemsControl ItemsSource="{Binding Hotkeys}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:HotkeyRowViewModel}">
                <Grid Margin="0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                  <local:HotkeyBox Grid.Column="1" GestureText="{Binding Text}" AutomationProperties.Name="{Binding Label}"
                                   GotKeyboardFocus="OnHotkeyBoxGotFocus" LostKeyboardFocus="OnHotkeyBoxLostFocus" />
                  <Button Grid.Column="2" Content="Clear" Command="{Binding ClearCommand}" Margin="8,0,0,0" />
                  <TextBlock Grid.Column="3" Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Opacity" Value="0.75" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasProblem}" Value="True">
                            <Setter Property="Foreground" Value="#D13438" />
                            <Setter Property="Opacity" Value="1" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Style="{StaticResource Section}" Text="Push to talk" />
          <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="200" />
              <ColumnDefinition Width="220" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Hold to talk while recording" VerticalAlignment="Center" />
            <local:HotkeyBox Grid.Column="1" GestureText="{Binding PushToTalkText}" AutomationProperties.Name="Push to talk"
                             GotKeyboardFocus="OnHotkeyBoxGotFocus" LostKeyboardFocus="OnHotkeyBoxLostFocus" />
            <Button Grid.Column="2" Content="Clear" Command="{Binding ClearPushToTalkCommand}" Margin="8,0,0,0" />
            <TextBlock Grid.Column="3" Text="{Binding PushToTalkStatus}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Opacity" Value="0.75" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding PushToTalkHasProblem}" Value="True">
                      <Setter Property="Foreground" Value="#D13438" />
                      <Setter Property="Opacity" Value="1" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
          <TextBlock Style="{StaticResource Hint}" Text="With a key set, the microphone is silent in recordings except while the key is held (and a quarter of a second after, so words aren't cut). The key isn't taken from other apps, so a key that does nothing in them works best: F13 to F24, Scroll Lock, Pause, or a mouse button mapped to one of those. A key on its own is fine here." />
        </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================== General ============================== -->
      <TabItem Header="General">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12,4,12,12">
          <TextBlock Style="{StaticResource Section}" Text="Startup" />
          <CheckBox Margin="0,2" Content="Start CashGear Capture when I sign in to Windows" IsChecked="{Binding StartWithWindows}" />

          <TextBlock Style="{StaticResource Section}" Text="Capture Text (OCR)" />
          <ComboBox ItemsSource="{Binding OcrLanguages}" SelectedItem="{Binding OcrLanguage}" DisplayMemberPath="Label"
                    HorizontalAlignment="Left" MinWidth="320" AutomationProperties.Name="Text recognition language" />
          <TextBlock Style="{StaticResource Hint}" Text="Automatic reads the area with each of your Windows languages and takes every line from the language that matches its script, so Arabic and English in one area both work. More languages: Windows Settings › Time &amp; language › Language › (language) › Options › Optical character recognition." />

          <TextBlock Style="{StaticResource Section}" Text="Screen tools" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="220" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition />
              <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="Ruler: pixels per inch" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding RulerDpiChoices}" SelectedItem="{Binding RulerDpi}" DisplayMemberPath="Label"
                      HorizontalAlignment="Left" MinWidth="280" AutomationProperties.Name="Ruler pixels per inch" />
            <TextBlock Grid.Row="1" Text="Colour picker copies as" VerticalAlignment="Center" Margin="0,8,0,0" />
            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ColorFormats}" SelectedItem="{Binding ColorCopyFormat}" ItemTemplate="{StaticResource EnumItem}"
                      HorizontalAlignment="Left" MinWidth="280" Margin="0,8,0,0" AutomationProperties.Name="Colour picker copies as" />
          </Grid>
          <TextBlock Style="{StaticResource Hint}" Text="Inches and centimetres on the ruler follow Windows' scale of the monitor it is on. To measure real inches on the glass, set your screen's pixels per inch (its width in pixels divided by its width in inches). Tools are in tray › Tools and on the capture toolbar; set hotkeys for them on the Hotkeys tab." />

          <TextBlock Style="{StaticResource Section}" Text="Appearance" />
          <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" ItemTemplate="{StaticResource EnumItem}"
                    HorizontalAlignment="Left" MinWidth="220" AutomationProperties.Name="Theme" />

          <TextBlock Style="{StaticResource Section}" Text="Capture history" />
          <ComboBox ItemsSource="{Binding HistorySizes}" SelectedItem="{Binding HistorySize}" DisplayMemberPath="Label"
                    HorizontalAlignment="Left" MinWidth="220" AutomationProperties.Name="Captures kept in the history" />
          <TextBlock Style="{StaticResource Hint}" Text="Recent captures are kept (with thumbnails) for tray › Recent Captures and Capture History, even ones you didn't save. Lowering the number removes the oldest straight away." />

          <TextBlock Style="{StaticResource Section}" Text="Updates" />
          <TextBlock Text="{Binding VersionText}" />
          <CheckBox Margin="0,6,0,2" Content="Check for updates automatically (once a day) and download them in the background"
                    IsChecked="{Binding CheckForUpdates}" IsEnabled="{Binding CanCheckForUpdates}" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button Content="Check now" Command="{Binding CheckForUpdatesNowCommand}" MinWidth="100" />
            <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0" MaxWidth="440" Opacity="0.8" />
          </StackPanel>

          <TextBlock Style="{StaticResource Section}" Text="Advanced" />
          <Button Content="Open settings file" Command="{Binding OpenSettingsFileCommand}" HorizontalAlignment="Left" />
          <TextBlock Style="{StaticResource Hint}" Text="Edits saved in the file apply immediately." />
        </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
