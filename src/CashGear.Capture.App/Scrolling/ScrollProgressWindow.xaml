<Window x:Class="CashGear.Capture.App.Scrolling.ScrollProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CashGear.Capture.App.Scrolling"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:ScrollProgressViewModel}"
        Title="Scrolling capture" SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStyle="ToolWindow"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False">
  <StackPanel Margin="16,12,16,14" Width="280">
    <TextBlock FontSize="14" FontWeight="SemiBold">
      <Run Text="{Binding Frames, Mode=OneWay}" /><Run Text=" parts · " /><Run Text="{Binding Height, Mode=OneWay}" /><Run Text=" px" />
    </TextBlock>
    <TextBlock Margin="0,2,0,0" Opacity="0.7">
      <Run Text="Scrolling with" />
      <Run Text="{Binding Method, Mode=OneWay}" />
    </TextBlock>
    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,10,0,0" />
    <TextBlock Margin="0,10,0,0" Opacity="0.7" TextWrapping="Wrap"
               Text="It stops by itself at the bottom. Esc cancels; Finish now keeps what has been captured." />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Finish now" Command="{Binding FinishCommand}" MinWidth="96" Margin="0,0,8,0" />
      <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="80" />
    </StackPanel>
  </StackPanel>
</Window>
