<Window x:Class="CashGear.Capture.App.Scrolling.ScrollProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CashGear.Capture.App.Scrolling"
        xmlns:r="clr-namespace:CashGear.Capture.App.Resources"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:ScrollProgressViewModel}"
        Title="{x:Static r:CapturingText.ScrollingCapture}" SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStyle="ToolWindow"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False">
  <StackPanel Margin="16,12,16,14" Width="280">
    <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Summary, Mode=OneWay}" />
    <TextBlock Margin="0,2,0,0" Opacity="0.7" Text="{Binding MethodText, Mode=OneWay}" />
    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,10,0,0" AutomationProperties.Name="{x:Static r:CapturingText.ScrollingCapture}" />
    <TextBlock Margin="0,10,0,0" Opacity="0.7" TextWrapping="Wrap"
               Text="{x:Static r:CapturingText.ScrollHint}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="{x:Static r:CapturingText.FinishNow}" Command="{Binding FinishCommand}" MinWidth="96" Margin="0,0,8,0" />
      <Button Content="{x:Static r:CommonText.Cancel}" Command="{Binding CancelCommand}" MinWidth="80" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
