<Window x:Class="CashGear.Capture.App.Recording.ScheduleRecordingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:CashGear.Capture.App.Platform"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CashGear.Capture.App.Recording"
        xmlns:settings="clr-namespace:CashGear.Capture.App.Settings"
        xmlns:r="clr-namespace:CashGear.Capture.App.Resources"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:ScheduleRecordingViewModel}"
        Title="{x:Static r:RecordingText.ScheduleWindowTitle}" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
  <Window.Resources>
    <settings:EnumChoicesConverter x:Key="Choices" />
    <BooleanToVisibilityConverter x:Key="Visible" />
  </Window.Resources>
  <StackPanel Margin="16" Width="440">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="140" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>

      <Label Content="{x:Static r:RecordingText.ScheduleWhat}" Target="{Binding ElementName=TargetBox}" VerticalAlignment="Center" Padding="0" />
      <ComboBox x:Name="TargetBox" Grid.Column="1" ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}"
                AutomationProperties.Name="{x:Static r:RecordingText.ScheduleWhatName}" />

      <Label Grid.Row="1" Content="{x:Static r:RecordingText.ScheduleProfile}" Target="{Binding ElementName=ProfileBox}" VerticalAlignment="Center" Margin="0,8,0,0" Padding="0" />
      <ComboBox x:Name="ProfileBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile}"
                AutomationProperties.Name="{x:Static r:RecordingText.ScheduleProfileName}" />

      <CheckBox x:Name="LaterBox" Grid.Row="2" Margin="0,12,0,0" VerticalAlignment="Center" Content="{x:Static r:RecordingText.ScheduleStartAt}" IsChecked="{Binding StartLater}" />
      <TextBox Grid.Row="2" Grid.Column="1" Margin="0,12,0,0" Width="100" HorizontalAlignment="Left" FlowDirection="LeftToRight" Text="{Binding StartTime, UpdateSourceTrigger=PropertyChanged}"
               IsEnabled="{Binding StartLater}" AutomationProperties.Name="{x:Static r:RecordingText.ScheduleStartTimeName}" />

      <Label Grid.Row="3" Content="{x:Static r:RecordingText.ScheduleStop}" Target="{Binding ElementName=StopBox}" VerticalAlignment="Center" Margin="0,12,0,0" Padding="0" />
      <ComboBox x:Name="StopBox" Grid.Row="3" Grid.Column="1" Margin="0,12,0,0" ItemsSource="{Binding Stops, Converter={StaticResource Choices}}" SelectedValuePath="Value" SelectedValue="{Binding Stop}"
                AutomationProperties.Name="{x:Static r:RecordingText.ScheduleStopName}" />

      <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,8,0,0">
        <TextBox Width="100" HorizontalAlignment="Left" FlowDirection="LeftToRight" Text="{Binding Length, UpdateSourceTrigger=PropertyChanged}"
                 Visibility="{Binding StopsAfterLength, Converter={StaticResource Visible}}" AutomationProperties.Name="{x:Static r:RecordingText.ScheduleLengthName}" />
        <TextBox Width="100" HorizontalAlignment="Left" FlowDirection="LeftToRight" Text="{Binding StopTime, UpdateSourceTrigger=PropertyChanged}"
                 Visibility="{Binding StopsAtTime, Converter={StaticResource Visible}}" AutomationProperties.Name="{x:Static r:RecordingText.ScheduleStopTimeName}" />
        <TextBox FlowDirection="LeftToRight" Text="{Binding App, UpdateSourceTrigger=PropertyChanged}"
                 Visibility="{Binding StopsWhenAppCloses, Converter={StaticResource Visible}}" AutomationProperties.Name="{x:Static r:RecordingText.ScheduleAppName}"
                 AutomationProperties.HelpText="{x:Static r:RecordingText.ScheduleAppHelp}" ToolTip="{x:Static r:RecordingText.ScheduleAppHelp}" />
      </StackPanel>
    </Grid>

    <TextBlock Margin="0,10,0,0" Foreground="{p:Chrome Error}" TextWrapping="Wrap" Text="{Binding Problem}" AutomationProperties.LiveSetting="Assertive" />
    <TextBlock Margin="0,8,0,0" Opacity="0.75" TextWrapping="Wrap" Text="{x:Static r:RecordingText.ScheduleHint}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="{Binding ActionText}" Command="{Binding GoCommand}" IsDefault="True" MinWidth="110" Padding="10,3" />
      <Button Content="{x:Static r:CommonText.Cancel}" IsCancel="True" Click="OnCancel" MinWidth="80" Margin="8,0,0,0" Padding="10,3" />
    </StackPanel>
  </StackPanel>
</Window>
