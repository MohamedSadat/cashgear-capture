<Window x:Class="CashGear.Capture.App.Recording.RecordingToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CashGear.Capture.App.Recording"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:RecordingToolbarViewModel}"
        Title="Recording" SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStyle="None"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" BorderThickness="1" BorderBrush="#60808080">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
  </Window.Resources>
  <Border Padding="10,6" MouseLeftButtonDown="OnDrag" Background="Transparent" ToolTip="Drag to move">
    <StackPanel>
    <StackPanel Orientation="Horizontal">
      <Ellipse Width="12" Height="12" Fill="#E81123" VerticalAlignment="Center" Margin="0,0,8,0"
               Visibility="{Binding IsRecordingNow, Converter={StaticResource Visible}}" />
      <Rectangle Width="12" Height="12" Fill="#808080" VerticalAlignment="Center" Margin="0,0,8,0"
                 Visibility="{Binding IsPaused, Converter={StaticResource Visible}}" />
      <TextBlock Text="{Binding ElapsedText}" FontSize="15" FontFamily="Segoe UI Semibold" VerticalAlignment="Center" MinWidth="48" />
      <!-- Sound: a speaker and a level meter, or a crossed-out speaker when sound was asked for but isn't available. -->
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" ToolTip="{Binding SoundToolTip}"
                  Visibility="{Binding HasSound, Converter={StaticResource Visible}}">
        <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0" />
        <ProgressBar Width="44" Height="6" Minimum="0" Maximum="1" Value="{Binding SoundLevel, Mode=OneWay}" VerticalAlignment="Center"
                     AutomationProperties.Name="Sound level" />
      </StackPanel>
      <TextBlock Text="&#xE74F;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.7"
                 ToolTip="{Binding SoundToolTip}" Visibility="{Binding IsSoundMissing, Converter={StaticResource Visible}}" />
      <Button Content="{Binding MicrophoneText}" Command="{Binding ToggleMicrophoneCommand}" Margin="12,0,0,0" MinWidth="90" Focusable="False"
              ToolTip="Silence the microphone in the recording (system audio keeps recording)"
              Visibility="{Binding HasMicrophone, Converter={StaticResource Visible}}" />
      <Button Command="{Binding ToggleSoundPanelCommand}" Margin="6,0,0,0" MinWidth="34" Focusable="False"
              ToolTip="Volume and mute for each sound source" AutomationProperties.Name="Sound settings"
              Visibility="{Binding HasSound, Converter={StaticResource Visible}}">
        <TextBlock Text="&#xE9E9;" FontFamily="Segoe MDL2 Assets" />
      </Button>
      <Button Content="{Binding PauseText}" Command="{Binding PauseCommand}" Margin="12,0,6,0" MinWidth="80" Focusable="False" />
      <Button Content="Stop" Command="{Binding StopCommand}" MinWidth="70" Focusable="False" ToolTip="Stop and save (or press the recording hotkey)" />
    </StackPanel>
    <!-- Inside the toolbar's own window, not a popup: a popup is a window of its own and would be in the recording. -->
    <Grid Margin="0,8,0,2" Visibility="{Binding IsSoundPanelOpen, Converter={StaticResource Visible}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="160" />
        <ColumnDefinition Width="46" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <TextBlock Text="System audio" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="{Binding HasSystemAudio, Converter={StaticResource Visible}}" />
      <Slider Grid.Column="1" Minimum="0" Maximum="200" SmallChange="5" LargeChange="25" Value="{Binding SystemAudioVolume}" Focusable="False"
              VerticalAlignment="Center" AutomationProperties.Name="System audio volume" Visibility="{Binding HasSystemAudio, Converter={StaticResource Visible}}" />
      <TextBlock Grid.Column="2" Text="{Binding SystemAudioVolumeText}" VerticalAlignment="Center" TextAlignment="Right"
                 Visibility="{Binding HasSystemAudio, Converter={StaticResource Visible}}" />
      <CheckBox Grid.Column="3" Content="Mute" IsChecked="{Binding SystemAudioMuted}" Margin="10,0,0,0" VerticalAlignment="Center" Focusable="False"
                Visibility="{Binding HasSystemAudio, Converter={StaticResource Visible}}" />
      <TextBlock Grid.Row="1" Text="Microphone" VerticalAlignment="Center" Margin="0,6,10,0" Visibility="{Binding HasMicrophone, Converter={StaticResource Visible}}" />
      <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="200" SmallChange="5" LargeChange="25" Value="{Binding MicrophoneVolume}" Focusable="False"
              VerticalAlignment="Center" Margin="0,6,0,0" AutomationProperties.Name="Microphone volume" Visibility="{Binding HasMicrophone, Converter={StaticResource Visible}}" />
      <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding MicrophoneVolumeText}" VerticalAlignment="Center" TextAlignment="Right" Margin="0,6,0,0"
                 Visibility="{Binding HasMicrophone, Converter={StaticResource Visible}}" />
      <CheckBox Grid.Row="1" Grid.Column="3" Content="Mute" IsChecked="{Binding MicrophoneMuted}" Margin="10,6,0,0" VerticalAlignment="Center" Focusable="False"
                Visibility="{Binding HasMicrophone, Converter={StaticResource Visible}}" />
    </Grid>
    </StackPanel>
  </Border>
</Window>
