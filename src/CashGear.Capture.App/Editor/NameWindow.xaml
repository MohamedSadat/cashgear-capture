<Window x:Class="CashGear.Capture.App.Editor.NameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CashGear.Capture.App.Editor"
        xmlns:r="clr-namespace:CashGear.Capture.App.Resources"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:NameViewModel}"
        Title="{x:Static r:EditorText.NameTitle}" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="20" Width="320">
    <TextBlock Text="{x:Static r:EditorText.NamePrompt}" TextWrapping="Wrap" />
    <TextBox x:Name="NameBox" Margin="0,6,0,0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:EditorText.NameTitle}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{x:Static r:CommonText.Save}" IsDefault="True" MinWidth="90" Margin="0,0,8,0" Click="OnOk" IsEnabled="{Binding IsValid}" />
      <Button Content="{x:Static r:CommonText.Cancel}" IsCancel="True" MinWidth="90" />
    </StackPanel>
  </StackPanel>
</Window>
