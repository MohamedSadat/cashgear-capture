<Window x:Class="CashGear.Capture.App.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CashGear.Capture.App.Editor"
        xmlns:tools="clr-namespace:CashGear.Capture.Editor.Interaction;assembly=CashGear.Capture.Editor"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:EditorViewModel}"
        Title="{Binding Title}"
        Width="1100" Height="760" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterScreen">
  <Window.InputBindings>
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
    <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyCommand}" />
    <KeyBinding Gesture="Ctrl+D0" Command="{Binding ZoomFitCommand}" />
    <KeyBinding Gesture="Ctrl+NumPad0" Command="{Binding ZoomFitCommand}" />
    <KeyBinding Gesture="Ctrl+D1" Command="{Binding ZoomActualCommand}" />
    <KeyBinding Gesture="Ctrl+NumPad1" Command="{Binding ZoomActualCommand}" />
    <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+Add" Command="{Binding ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Gesture="Ctrl+Subtract" Command="{Binding ZoomOutCommand}" />
  </Window.InputBindings>

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <local:ToolIsConverter x:Key="ToolIs" />
    <local:NullToVisibilityConverter x:Key="VisibleIfSet" />

    <Style x:Key="ToolIcon" TargetType="Path">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Stretch" Value="None" />
      <Setter Property="StrokeThickness" Value="1.6" />
      <Setter Property="StrokeLineJoin" Value="Round" />
      <Setter Property="StrokeStartLineCap" Value="Round" />
      <Setter Property="StrokeEndLineCap" Value="Round" />
      <Setter Property="Stroke" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ToolLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,14,0,6" />
    </Style>

    <DataTemplate x:Key="Swatch" DataType="{x:Type local:ColorSwatch}">
      <Border Width="22" Height="22" Margin="0,0,4,4" CornerRadius="3" Background="{Binding Brush}"
              BorderBrush="#80808080" BorderThickness="1" ToolTip="{Binding Name}" />
    </DataTemplate>
  </Window.Resources>

  <DockPanel>
    <!-- ============================== Toolbar ============================== -->
    <Border DockPanel.Dock="Top" Padding="8,6" BorderThickness="0,0,0,1" BorderBrush="#40808080">
      <WrapPanel>
        <local:ToolButton ToolTip="Select and move (V)"
                     IsChecked="{Binding Tool, Converter={StaticResource ToolIs}, ConverterParameter={x:Static tools:EditorTool.Select}}">
          <StackPanel>
            <Path Style="{StaticResource ToolIcon}" Fill="{Binding Stroke, RelativeSource={RelativeSource Self}}" StrokeThickness="0.8"
                  Data="M6,2 L6,16 L9.5,12.8 L12,18 L14,17 L11.6,11.9 L16,11.6 Z" />
            <TextBlock Style="{StaticResource ToolLabel}" Text="Select" />
          </StackPanel>
        </local:ToolButton>
        <local:ToolButton ToolTip="Arrow (A)"
                     IsChecked="{Binding Tool, Converter={StaticResource ToolIs}, ConverterParameter={x:Static tools:EditorTool.Arrow}}">
          <StackPanel>
            <Path Style="{StaticResource ToolIcon}" Data="M4,16 L15,5 M8.5,4.5 L15.5,4.5 L15.5,11.5" StrokeThickness="2" />
            <TextBlock Style="{StaticResource ToolLabel}" Text="Arrow" />
          </StackPanel>
        </local:ToolButton>
        <local:ToolButton ToolTip="Line (L)"
                     IsChecked="{Binding Tool, Converter={StaticResource ToolIs}, ConverterParameter={x:Static tools:EditorTool.Line}}">
          <StackPanel>
            <Path Style="{StaticResource ToolIcon}" Data="M4,16 L16,4" StrokeThickness="2" />
            <TextBlock Style="{StaticResource ToolLabel}" Text="Line" />
          </StackPanel>
        </local:ToolButton>
        <local:ToolButton ToolTip="Rectangle (R)"
                     IsChecked="{Binding Tool, Converter={StaticResource ToolIs}, ConverterParameter={x:Static tools:EditorTool.Rectangle}}">
          <StackPanel>
            <Path Style="{StaticResource ToolIcon}" Data="M3,5 H17 V15 H3 Z" />
            <TextBlock Style="{StaticResource ToolLabel}" Text="Rectangle" />
          </StackPanel>
        </local:ToolButton>
        <local:ToolButton ToolTip="Ellipse (E)"
                     IsChecked="{Binding Tool, Converter={StaticResource ToolIs}, ConverterParameter={x:Static tools:EditorTool.Ellipse}}">
          <StackPanel>
            <Path Style="{StaticResource ToolIcon}" Data="M2,10 A8,6 0 1 1 18,10 A8,6 0 1 1 2,10 Z" />
            <TextBlock Style="{StaticResource ToolLabel}" Text="Ellipse" />
          </StackPanel>
        </local:ToolButton>
        <local:ToolButton ToolTip="Pen (D)"
                     IsChecked="{Binding Tool, Converter={StaticResource ToolIs}, ConverterParameter={x:Static tools:EditorTool.Freehand}}">
          <StackPanel>
            <Path Style="{StaticResource ToolIcon}" Data="M3,15 C5,5 8,4 10,10 S15,16 17,5" StrokeThickness="1.8" />
            <TextBlock Style="{StaticResource ToolLabel}" Text="Pen" />
          </StackPanel>
        </local:ToolButton>
        <local:ToolButton ToolTip="Highlighter (H)"
                     IsChecked="{Binding Tool, Converter={StaticResource ToolIs}, ConverterParameter={x:Static tools:EditorTool.Highlight}}">
          <StackPanel>
            <Path Style="{StaticResource ToolIcon}" Data="M7,12 L13,3 L17,6 L11,15 Z M7,12 L5,16 L9,16 L11,15 M3,18 H17" />
            <TextBlock Style="{StaticResource ToolLabel}" Text="Highlight" />
          </StackPanel>
        </local:ToolButton>
        <local:ToolButton ToolTip="Text (T)"
                     IsChecked="{Binding Tool, Converter={StaticResource ToolIs}, ConverterParameter={x:Static tools:EditorTool.Text}}">
          <StackPanel>
            <Path Style="{StaticResource ToolIcon}" Data="M4,5 V3.5 H16 V5 M10,3.5 V16.5 M7.5,16.5 H12.5" StrokeThickness="1.8" />
            <TextBlock Style="{StaticResource ToolLabel}" Text="Text" />
          </StackPanel>
        </local:ToolButton>
        <local:ToolButton ToolTip="Step number (N)"
                     IsChecked="{Binding Tool, Converter={StaticResource ToolIs}, ConverterParameter={x:Static tools:EditorTool.StepNumber}}">
          <StackPanel>
            <Path Style="{StaticResource ToolIcon}" Data="M10,2 A8,8 0 1 1 9.99,2 Z M8.5,7.5 L10.5,6 V14" />
            <TextBlock Style="{StaticResource ToolLabel}" Text="Step" />
          </StackPanel>
        </local:ToolButton>
        <local:ToolButton ToolTip="Blur (B)"
                     IsChecked="{Binding Tool, Converter={StaticResource ToolIs}, ConverterParameter={x:Static tools:EditorTool.Blur}}">
          <StackPanel>
            <Path Style="{StaticResource ToolIcon}" Data="M10,2.5 C10,2.5 4.5,9 4.5,12.5 A5.5,5.5 0 0 0 15.5,12.5 C15.5,9 10,2.5 10,2.5 Z" />
            <TextBlock Style="{StaticResource ToolLabel}" Text="Blur" />
          </StackPanel>
        </local:ToolButton>
        <local:ToolButton ToolTip="Pixelate (X)"
                     IsChecked="{Binding Tool, Converter={StaticResource ToolIs}, ConverterParameter={x:Static tools:EditorTool.Pixelate}}">
          <StackPanel>
            <Path Style="{StaticResource ToolIcon}" Fill="{Binding Stroke, RelativeSource={RelativeSource Self}}" StrokeThickness="0"
                  Data="M3,3 H8 V8 H3 Z M12,3 H17 V8 H12 Z M8,8 H12 V12 H8 Z M3,12 H8 V17 H3 Z M12,12 H17 V17 H12 Z" />
            <TextBlock Style="{StaticResource ToolLabel}" Text="Pixelate" />
          </StackPanel>
        </local:ToolButton>
        <local:ToolButton ToolTip="Crop (C)"
                     IsChecked="{Binding Tool, Converter={StaticResource ToolIs}, ConverterParameter={x:Static tools:EditorTool.Crop}}">
          <StackPanel>
            <Path Style="{StaticResource ToolIcon}" Data="M6,2 V14 H18 M2,6 H14 V18" StrokeThickness="1.8" />
            <TextBlock Style="{StaticResource ToolLabel}" Text="Crop" />
          </StackPanel>
        </local:ToolButton>

        <Rectangle Width="1" Margin="8,4" Fill="#40808080" />

        <Button Content="Undo" Command="{Binding UndoCommand}" ToolTip="{Binding UndoTip}" Margin="0,0,4,0" Focusable="False" VerticalAlignment="Center" />
        <Button Content="Redo" Command="{Binding RedoCommand}" ToolTip="{Binding RedoTip}" Margin="0,0,4,0" Focusable="False" VerticalAlignment="Center" />
        <Menu VerticalAlignment="Center" Margin="0,0,4,0" Background="Transparent">
          <MenuItem Header="Image ▾">
            <MenuItem Header="Rotate left" Command="{Binding RotateLeftCommand}" />
            <MenuItem Header="Rotate right" Command="{Binding RotateRightCommand}" />
            <Separator />
            <MenuItem Header="Resize…" Command="{Binding ResizeImageCommand}" />
            <MenuItem Header="Add border…" Command="{Binding AddBorderCommand}" />
            <MenuItem Header="Add shadow" Command="{Binding AddShadowCommand}" />
          </MenuItem>
        </Menu>

        <Rectangle Width="1" Margin="8,4" Fill="#40808080" />

        <Button Content="Copy" Command="{Binding CopyCommand}" ToolTip="Copy the image with its annotations (Ctrl+C)" Margin="0,0,4,0" Focusable="False" VerticalAlignment="Center" />
        <Button Content="Save" Command="{Binding SaveCommand}" ToolTip="Save (Ctrl+S)" Margin="0,0,4,0" Focusable="False" VerticalAlignment="Center" />
        <Button Content="Save as…" Command="{Binding SaveAsCommand}" ToolTip="Save as (Ctrl+Shift+S)" Focusable="False" VerticalAlignment="Center" />
      </WrapPanel>
    </Border>

    <!-- ============================== Status bar ============================== -->
    <Border DockPanel.Dock="Bottom" Padding="10,4" BorderThickness="0,1,0,0" BorderBrush="#40808080">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <TextBlock Text="{Binding PointerText}" VerticalAlignment="Center" MinWidth="90" Opacity="0.75" />
          <TextBlock Text="{Binding ImageSizeText}" VerticalAlignment="Center" Margin="0,0,16,0" Opacity="0.75" />
          <Button Content="−" Command="{Binding ZoomOutCommand}" ToolTip="Zoom out (Ctrl+−)" MinWidth="32" Padding="4,2" Focusable="False" />
          <TextBlock Text="{Binding ZoomText}" VerticalAlignment="Center" MinWidth="52" TextAlignment="Center" />
          <Button Content="+" Command="{Binding ZoomInCommand}" ToolTip="Zoom in (Ctrl++)" MinWidth="32" Padding="4,2" Focusable="False" />
          <Button Content="Fit" Command="{Binding ZoomFitCommand}" ToolTip="Fit in the window (Ctrl+0)" Margin="6,0,0,0" Padding="8,2" Focusable="False" />
          <Button Content="100%" Command="{Binding ZoomActualCommand}" ToolTip="Actual size (Ctrl+1)" Margin="4,0,0,0" Padding="8,2" Focusable="False" />
        </StackPanel>
        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
          <Run Text="{Binding Message, Mode=OneWay}" FontWeight="SemiBold" />
          <Run Text="{Binding ToolHint, Mode=OneWay}" />
        </TextBlock>
      </DockPanel>
    </Border>

    <!-- ============================== Properties ============================== -->
    <Border DockPanel.Dock="Right" Width="236" BorderThickness="1,0,0,0" BorderBrush="#40808080">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="14,4,14,14">
          <TextBlock Text="{Binding PanelTitle}" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0" />

          <StackPanel Visibility="{Binding ShowColor, Converter={StaticResource Visible}}">
            <TextBlock Style="{StaticResource Section}" Text="Colour" />
            <ItemsControl ItemsSource="{Binding Palette}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:ColorSwatch}">
                  <Button Command="{Binding DataContext.SetColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}" Padding="0" MinWidth="0" MinHeight="0" BorderThickness="0" Background="Transparent" Focusable="False">
                    <ContentPresenter ContentTemplate="{StaticResource Swatch}" Content="{Binding}" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel Margin="0,4,0,0">
              <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="4" Background="{Binding ColorBrush}" BorderBrush="#80808080" BorderThickness="1" Margin="0,0,8,0" />
              <TextBox Text="{Binding ColorHex, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Colour (hex)" />
            </DockPanel>
          </StackPanel>

          <StackPanel Visibility="{Binding ShowFill, Converter={StaticResource Visible}}">
            <TextBlock Style="{StaticResource Section}" Text="Fill" />
            <WrapPanel>
              <Button Content="None" Command="{Binding SetFillCommand}" CommandParameter="{x:Null}" Padding="6,1" MinHeight="0" Margin="0,0,4,4" Focusable="False" />
              <Border Width="22" Height="22" CornerRadius="3" Margin="0,0,4,4" Background="{Binding FillBrush}" BorderBrush="#80808080" BorderThickness="1"
                      Visibility="{Binding FillBrush, Converter={StaticResource VisibleIfSet}}" ToolTip="Current fill" />
            </WrapPanel>
            <ItemsControl ItemsSource="{Binding Palette}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:ColorSwatch}">
                  <Button Command="{Binding DataContext.SetFillCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}" Padding="0" MinWidth="0" MinHeight="0" BorderThickness="0" Background="Transparent" Focusable="False">
                    <ContentPresenter ContentTemplate="{StaticResource Swatch}" Content="{Binding}" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Visibility="{Binding ShowStrokeWidth, Converter={StaticResource Visible}}">
            <TextBlock Style="{StaticResource Section}">
              <Run Text="Line width:" />
              <Run Text="{Binding StrokeWidth, Mode=OneWay}" />
            </TextBlock>
            <Slider Minimum="1" Maximum="40" Value="{Binding StrokeWidth}" IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.Name="Line width" />
          </StackPanel>

          <StackPanel Visibility="{Binding ShowFont, Converter={StaticResource Visible}}">
            <TextBlock Style="{StaticResource Section}" Text="Font" />
            <ComboBox ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding FontFamily}" AutomationProperties.Name="Font"
                      VirtualizingPanel.IsVirtualizing="True">
              <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ComboBox.ItemsPanel>
            </ComboBox>
            <CheckBox Content="Bold" IsChecked="{Binding Bold}" Margin="0,6,0,0" Focusable="False" />
          </StackPanel>

          <StackPanel Visibility="{Binding ShowFontSize, Converter={StaticResource Visible}}">
            <TextBlock Style="{StaticResource Section}">
              <Run Text="{Binding FontSizeLabel, Mode=OneWay}" /><Run Text=":" />
              <Run Text="{Binding FontSize, Mode=OneWay}" />
            </TextBlock>
            <Slider Minimum="8" Maximum="120" Value="{Binding FontSize}" IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.Name="Size" />
          </StackPanel>

          <StackPanel Visibility="{Binding ShowStrength, Converter={StaticResource Visible}}">
            <TextBlock Style="{StaticResource Section}">
              <Run Text="{Binding StrengthLabel, Mode=OneWay}" /><Run Text=":" />
              <Run Text="{Binding Strength, Mode=OneWay}" />
            </TextBlock>
            <Slider Minimum="2" Maximum="40" Value="{Binding Strength}" IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.Name="Strength" />
          </StackPanel>

          <StackPanel Visibility="{Binding ShowOpacity, Converter={StaticResource Visible}}">
            <TextBlock Style="{StaticResource Section}">
              <Run Text="Opacity:" />
              <Run Text="{Binding Opacity, Mode=OneWay}" /><Run Text="%" />
            </TextBlock>
            <Slider Minimum="10" Maximum="100" Value="{Binding Opacity}" IsSnapToTickEnabled="True" TickFrequency="5" AutomationProperties.Name="Opacity" />
          </StackPanel>

          <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource Visible}}">
            <TextBlock Style="{StaticResource Section}" Text="Arrange" />
            <WrapPanel>
              <Button Content="Bring to front" Command="{Binding BringToFrontCommand}" Margin="0,0,6,6" Focusable="False" />
              <Button Content="Send to back" Command="{Binding SendToBackCommand}" Margin="0,0,6,6" Focusable="False" />
              <Button Content="Delete" Command="{Binding DeleteCommand}" ToolTip="Delete" Margin="0,0,6,6" Focusable="False" />
            </WrapPanel>
          </StackPanel>

          <StackPanel Visibility="{Binding IsCropping, Converter={StaticResource Visible}}">
            <TextBlock Style="{StaticResource Section}">
              <Run Text="Crop to" />
              <Run Text="{Binding CropSizeText, Mode=OneWay}" />
            </TextBlock>
            <WrapPanel>
              <Button Content="Apply crop" Command="{Binding ApplyCropCommand}" ToolTip="Enter" Margin="0,0,6,6" Focusable="False" />
              <Button Content="Cancel" Command="{Binding CancelCropCommand}" ToolTip="Esc" Margin="0,0,6,6" Focusable="False" />
            </WrapPanel>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- ============================== Canvas ============================== -->
    <Grid>
      <local:EditorCanvas x:Name="Surface" />
      <Canvas x:Name="Overlay" ClipToBounds="True">
        <TextBox x:Name="TextEditor" Visibility="Collapsed" AcceptsReturn="True" MinWidth="40" MinHeight="0"
                 BorderBrush="#0078D4" BorderThickness="1" CaretBrush="Black" FocusVisualStyle="{x:Null}"
                 AutomationProperties.Name="Annotation text">
          <TextBox.Template>
            <ControlTemplate TargetType="TextBox">
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
              </Border>
            </ControlTemplate>
          </TextBox.Template>
        </TextBox>
      </Canvas>
    </Grid>
  </DockPanel>
</Window>
