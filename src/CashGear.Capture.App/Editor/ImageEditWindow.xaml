<Window x:Class="CashGear.Capture.App.Editor.ImageEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:CashGear.Capture.App.Platform"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CashGear.Capture.App.Editor"
        xmlns:r="clr-namespace:CashGear.Capture.App.Resources"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:ParameterDialogViewModel}"
        Title="{Binding Title}" Width="360" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <local:EditParameterTemplates />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <StackPanel Margin="20">
    <ItemsControl ItemsSource="{Binding Parameters}" Focusable="False" />
    <TextBlock Text="{Binding Error}" Foreground="{p:Chrome Error}" TextWrapping="Wrap" Margin="0,8,0,0" />
    <TextBlock Text="{x:Static r:EditorText.PreviewNote}" TextWrapping="Wrap" Opacity="0.75" Margin="0,8,0,0" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{x:Static r:CommonText.Ok}" IsDefault="True" MinWidth="90" Margin="0,0,8,0" Click="OnApply" />
      <Button Content="{x:Static r:CommonText.Cancel}" IsCancel="True" MinWidth="90" />
    </StackPanel>
  </StackPanel>
</Window>
