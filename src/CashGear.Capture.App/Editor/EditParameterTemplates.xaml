<ResourceDictionary x:Class="CashGear.Capture.App.Editor.EditParameterTemplates"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CashGear.Capture.App.Editor"
                    xmlns:r="clr-namespace:CashGear.Capture.App.Resources">
  <!-- One template per kind of setting, for the Effects window and the other image dialogs. No explicit styles on
       inputs: the Fluent theme styles them. -->
  <BooleanToVisibilityConverter x:Key="ParameterVisible" />

  <DataTemplate DataType="{x:Type local:NumberParameter}">
    <StackPanel Margin="0,8,0,0" Visibility="{Binding IsVisible, Converter={StaticResource ParameterVisible}}">
      <TextBlock>
        <Run Text="{Binding Label, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding Value, Mode=OneWay, StringFormat='0.#'}" /><Run Text="{Binding Unit, Mode=OneWay}" />
      </TextBlock>
      <DockPanel Margin="0,2,0,0">
        <TextBox DockPanel.Dock="Right" Width="72" Margin="8,0,0,0" Text="{Binding Value, UpdateSourceTrigger=LostFocus, StringFormat='0.#'}"
                 AutomationProperties.Name="{Binding Label}" />
        <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value}" TickFrequency="{Binding Step}"
                IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="{Binding Label}" />
      </DockPanel>
    </StackPanel>
  </DataTemplate>

  <DataTemplate DataType="{x:Type local:SwitchParameter}">
    <CheckBox Margin="0,8,0,0" Content="{Binding Label}" IsChecked="{Binding Value}"
              Visibility="{Binding IsVisible, Converter={StaticResource ParameterVisible}}" />
  </DataTemplate>

  <DataTemplate DataType="{x:Type local:TextParameter}">
    <StackPanel Margin="0,8,0,0" Visibility="{Binding IsVisible, Converter={StaticResource ParameterVisible}}">
      <TextBlock Text="{Binding Label}" />
      <TextBox Margin="0,2,0,0" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="{Binding Multiline}"
               TextWrapping="Wrap" MinHeight="32" AutomationProperties.Name="{Binding Label}" />
    </StackPanel>
  </DataTemplate>

  <DataTemplate DataType="{x:Type local:ChoiceParameter}">
    <StackPanel Margin="0,8,0,0" Visibility="{Binding IsVisible, Converter={StaticResource ParameterVisible}}">
      <TextBlock Text="{Binding Label}" />
      <ComboBox Margin="0,2,0,0" ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" DisplayMemberPath="Label"
                AutomationProperties.Name="{Binding Label}" />
    </StackPanel>
  </DataTemplate>

  <DataTemplate DataType="{x:Type local:FontParameter}">
    <StackPanel Margin="0,8,0,0" Visibility="{Binding IsVisible, Converter={StaticResource ParameterVisible}}">
      <TextBlock Text="{Binding Label}" />
      <ComboBox Margin="0,2,0,0" ItemsSource="{Binding Families}" SelectedItem="{Binding Value}" AutomationProperties.Name="{Binding Label}"
                VirtualizingPanel.IsVirtualizing="True">
        <ComboBox.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ComboBox.ItemsPanel>
      </ComboBox>
    </StackPanel>
  </DataTemplate>

  <DataTemplate DataType="{x:Type local:ColorParameter}">
    <StackPanel Margin="0,8,0,0" Visibility="{Binding IsVisible, Converter={StaticResource ParameterVisible}}">
      <DockPanel>
        <Border DockPanel.Dock="Right" Width="22" Height="22" CornerRadius="3" Background="{Binding Value.Brush}" BorderBrush="#80808080" BorderThickness="1"
                ToolTip="{Binding Value.Name}" />
        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
      </DockPanel>
      <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Palette}" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type local:ColorSwatch}">
            <Button Command="{Binding DataContext.SetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                    Padding="0" MinWidth="0" MinHeight="0" BorderThickness="0" Background="Transparent" ToolTip="{Binding Name}">
              <Border Width="20" Height="20" Margin="0,0,4,4" CornerRadius="3" Background="{Binding Brush}" BorderBrush="#80808080" BorderThickness="1" />
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Content="{x:Static r:EditorText.NoneTransparent}" Command="{Binding SetTransparentCommand}" HorizontalAlignment="Left" Padding="6,1" MinHeight="0"
              Visibility="{Binding AllowTransparent, Converter={StaticResource ParameterVisible}}" />
    </StackPanel>
  </DataTemplate>

  <DataTemplate DataType="{x:Type local:FileParameter}">
    <StackPanel Margin="0,8,0,0" Visibility="{Binding IsVisible, Converter={StaticResource ParameterVisible}}">
      <TextBlock Text="{Binding Label}" />
      <DockPanel Margin="0,2,0,0">
        <Button DockPanel.Dock="Right" Content="{x:Static r:CommonText.Browse}" Command="{Binding BrowseCommand}" Margin="6,0,0,0" />
        <TextBox Text="{Binding Path, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{Binding Label}" />
      </DockPanel>
    </StackPanel>
  </DataTemplate>

  <DataTemplate DataType="{x:Type local:AnchorParameter}">
    <StackPanel Margin="0,8,0,0" Visibility="{Binding IsVisible, Converter={StaticResource ParameterVisible}}">
      <TextBlock Text="{Binding Label}" />
      <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Cells}" Focusable="False" HorizontalAlignment="Left" FlowDirection="LeftToRight">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="3" Columns="3" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type local:AnchorCell}">
            <RadioButton IsChecked="{Binding IsSelected}" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}" Margin="2" MinWidth="0" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </DataTemplate>

  <DataTemplate DataType="{x:Type local:NoteParameter}">
    <TextBlock Margin="0,8,0,0" Text="{Binding Label}" TextWrapping="Wrap" Opacity="0.75"
               Visibility="{Binding IsVisible, Converter={StaticResource ParameterVisible}}" />
  </DataTemplate>

  <DataTemplate DataType="{x:Type local:ActionParameter}">
    <Button Margin="0,8,0,0" HorizontalAlignment="Left" Content="{Binding Label}" Command="{Binding Command}"
            Visibility="{Binding IsVisible, Converter={StaticResource ParameterVisible}}" />
  </DataTemplate>

  <DataTemplate DataType="{x:Type local:PresetsParameter}">
    <StackPanel Margin="0,4,0,4" Visibility="{Binding IsVisible, Converter={StaticResource ParameterVisible}}">
      <TextBlock Text="{Binding Label}" />
      <DockPanel Margin="0,2,0,0">
        <Button DockPanel.Dock="Right" Content="{x:Static r:CommonText.Delete}" Command="{Binding DeleteCommand}" Margin="6,0,0,0" />
        <Button DockPanel.Dock="Right" Content="{x:Static r:EditorText.SaveAs}" Command="{Binding SaveCommand}" Margin="6,0,0,0" />
        <ComboBox ItemsSource="{Binding Names}" SelectedItem="{Binding Selected}" AutomationProperties.Name="{Binding Label}" />
      </DockPanel>
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>
