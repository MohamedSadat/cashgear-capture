<Window x:Class="CashGear.Capture.App.Tools.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:CashGear.Capture.App.Platform"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CashGear.Capture.App.Tools"
        xmlns:settings="clr-namespace:CashGear.Capture.App.Settings"
        xmlns:r="clr-namespace:CashGear.Capture.App.Resources"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:ColorPickerViewModel}"
        Title="{x:Static r:ToolsText.ColorPicker}" SizeToContent="WidthAndHeight" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <settings:EnumChoicesConverter x:Key="Choices" />
  </Window.Resources>
  <StackPanel Margin="16" Width="400">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Border Width="72" Height="72" Background="{Binding Swatch}" BorderBrush="{p:Chrome Border}" BorderThickness="1" CornerRadius="4"
              AutomationProperties.Name="{x:Static r:ToolsText.TheColor}" />
      <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
        <Button Content="{x:Static r:ToolsText.PickFromScreen}" Command="{Binding PickCommand}" HorizontalAlignment="Left" MinWidth="170" IsDefault="True"
                ToolTip="{x:Static r:ToolsText.PickFromScreenTip}" AutomationProperties.HelpText="{x:Static r:ToolsText.PickFromScreenTip}" />
        <TextBlock Text="{Binding Status}" Margin="0,8,0,0" Opacity="0.75" TextTrimming="CharacterEllipsis" p:LiveText.IsLive="True" />
      </StackPanel>
    </Grid>

    <ItemsControl ItemsSource="{Binding Formats}" Margin="0,14,0,0">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type local:ColorText}">
          <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="44" />
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontWeight="SemiBold" />
            <TextBox FlowDirection="LeftToRight" Grid.Column="1" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" VerticalAlignment="Center"
                     AutomationProperties.Name="{Binding Label}" />
            <Button Grid.Column="2" Content="{x:Static r:CommonText.Copy}" Command="{Binding CopyCommand}" Margin="8,0,0,0" MinWidth="64"
                    AutomationProperties.Name="{Binding Label, StringFormat={x:Static r:ToolsText.CopyAsFormat}}" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
      <TextBlock Text="{x:Static r:ToolsText.CopyWhenPickedAs}" VerticalAlignment="Center" Margin="0,0,10,0" />
      <ComboBox ItemsSource="{Binding CopyFormats, Converter={StaticResource Choices}}" SelectedValuePath="Value" SelectedValue="{Binding CopyFormat}" MinWidth="150" AutomationProperties.Name="{x:Static r:ToolsText.CopyWhenPickedAs}" />
    </StackPanel>

    <TextBlock Text="{x:Static r:ToolsText.PickedBefore}" Margin="0,14,0,6" FontWeight="SemiBold" />
    <ItemsControl ItemsSource="{Binding History}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type local:PickedColor}">
          <Button Width="24" Height="24" Margin="0,0,5,5" Padding="0" MinWidth="0" MinHeight="0" ToolTip="{Binding Hex}" AutomationProperties.Name="{Binding Hex}"
                  Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
            <Border Background="{Binding Brush}" Width="22" Height="22" BorderBrush="{p:Chrome Border}" BorderThickness="1" />
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</Window>
