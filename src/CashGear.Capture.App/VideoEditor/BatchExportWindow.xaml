<Window x:Class="CashGear.Capture.App.VideoEditor.BatchExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CashGear.Capture.App.VideoEditor"
        xmlns:r="clr-namespace:CashGear.Capture.App.Resources"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:BatchExportViewModel}"
        Title="{x:Static r:VideoEditorText.BatchTitle}"
        Width="580" Height="520" MinWidth="440" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=ProjectsList}">
  <DockPanel Margin="16">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="{x:Static r:VideoEditorText.BatchStart}" Command="{Binding StartCommand}" IsDefault="True" MinWidth="88" Margin="0,0,8,0" />
        <Button Content="{x:Static r:CommonText.Close}" Command="{Binding CloseCommand}" IsCancel="True" MinWidth="88" />
      </StackPanel>
      <TextBlock Text="{Binding CountText}" VerticalAlignment="Center" />
    </DockPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock x:Name="FolderLabel" DockPanel.Dock="Left" Text="{x:Static r:VideoEditorText.BatchFolder}" VerticalAlignment="Center" Margin="0,0,12,0" />
      <Button DockPanel.Dock="Right" Content="{x:Static r:CommonText.Browse}" Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
      <TextBox FlowDirection="LeftToRight" Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.LabeledBy="{Binding ElementName=FolderLabel}" />
    </DockPanel>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,6">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="{x:Static r:VideoEditorText.BatchAddProjects}" Command="{Binding AddProjectsCommand}" Margin="0,0,8,0" />
          <Button Content="{x:Static r:VideoEditorText.BatchRemoveProject}" Command="{Binding RemoveProjectCommand}" />
        </StackPanel>
        <TextBlock x:Name="ProjectsLabel" Text="{x:Static r:VideoEditorText.BatchProjects}" VerticalAlignment="Center" FontWeight="SemiBold" />
      </DockPanel>
      <ListBox x:Name="ProjectsList" Grid.Row="1" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" DisplayMemberPath="Name"
               AutomationProperties.LabeledBy="{Binding ElementName=ProjectsLabel}" />
      <TextBlock x:Name="PresetsLabel" Grid.Row="2" Text="{x:Static r:VideoEditorText.BatchPresets}" Margin="0,12,0,6" FontWeight="SemiBold" />
      <ListBox Grid.Row="3" ItemsSource="{Binding Presets}" KeyboardNavigation.TabNavigation="Continue" AutomationProperties.LabeledBy="{Binding ElementName=PresetsLabel}">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="IsTabStop" Value="False" />
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type local:BatchPreset}">
            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChosen}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </DockPanel>
</Window>
