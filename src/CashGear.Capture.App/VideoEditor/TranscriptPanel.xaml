<UserControl x:Class="CashGear.Capture.App.VideoEditor.TranscriptPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:CashGear.Capture.App.Platform"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:CashGear.Capture.App.VideoEditor"
             xmlns:r="clr-namespace:CashGear.Capture.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:TranscriptPanelViewModel}"
             KeyboardNavigation.TabNavigation="Local">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <Style x:Key="Tool" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Margin" Value="0,0,6,4" />
      <Setter Property="Padding" Value="8,2" />
    </Style>
  </UserControl.Resources>
  <DockPanel>
    <!-- Above the words: what can be done with them. -->
    <StackPanel DockPanel.Dock="Top" Margin="10,8,10,4">
      <TextBlock Text="{x:Static r:VideoEditorText.TranscriptTitle}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" />
      <WrapPanel>
        <Button Style="{StaticResource Tool}" Content="{Binding MakeButtonText}" Command="{Binding MakeTranscriptCommand}" ToolTip="{x:Static r:VideoEditorText.MakeTranscriptTip}" />
        <Button Style="{StaticResource Tool}" Content="{x:Static r:VideoEditorText.CutWordsButton}" Command="{Binding CutSelectedCommand}" ToolTip="{x:Static r:VideoEditorText.CutWordsTip}"
                Visibility="{Binding HasTranscript, Converter={StaticResource Visible}}" />
        <Button Style="{StaticResource Tool}" Content="{x:Static r:VideoEditorText.RestoreWordsButton}" Command="{Binding RestoreSelectedCommand}" ToolTip="{x:Static r:VideoEditorText.RestoreWordsTip}"
                Visibility="{Binding HasTranscript, Converter={StaticResource Visible}}" />
        <Button Style="{StaticResource Tool}" Content="{x:Static r:VideoEditorText.SilencesButton}" Command="{Binding ShowSilencesCommand}" ToolTip="{x:Static r:VideoEditorText.SilencesTip}" />
        <Button Style="{StaticResource Tool}" Content="{x:Static r:VideoEditorText.FillersButton}" Command="{Binding ShowFillersCommand}" ToolTip="{x:Static r:VideoEditorText.FillersTip}"
                Visibility="{Binding HasTranscript, Converter={StaticResource Visible}}" />
        <Button Style="{StaticResource Tool}" Content="{x:Static r:VideoEditorText.CaptionsFromTranscriptButton}" Command="{Binding MakeCaptionsCommand}" ToolTip="{x:Static r:VideoEditorText.CaptionsFromTranscriptTip}"
                Visibility="{Binding HasTranscript, Converter={StaticResource Visible}}" />
      </WrapPanel>
      <CheckBox Content="{x:Static r:VideoEditorText.ShowCutWords}" IsChecked="{Binding ShowCut}" Margin="0,2,0,4"
                Visibility="{Binding HasTranscript, Converter={StaticResource Visible}}" />

      <!-- What a transcript can come from, when there is none yet. -->
      <TextBlock Text="{x:Static r:VideoEditorText.TranscriptNone}" TextWrapping="Wrap" Opacity="0.8" Margin="0,4,0,6"
                 Visibility="{Binding ShowsEmpty, Converter={StaticResource Visible}}" />
      <StackPanel Visibility="{Binding HasOffers, Converter={StaticResource Visible}}">
        <TextBlock Text="{x:Static r:VideoEditorText.OfferCaptionWords}" TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,4" />
        <ItemsControl ItemsSource="{Binding Offers}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type local:CaptionWordsOffer}">
              <Button Content="{Binding Text}" HorizontalAlignment="Left" Padding="8,2" Margin="0,0,0,4"
                      Command="{Binding DataContext.UseCaptionWordsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- What the two ways of changing the words do is plain to see. -->
      <TextBlock x:Name="Hint" Text="{x:Static r:VideoEditorText.TranscriptHint}" TextWrapping="Wrap" FontSize="11" Opacity="0.8"
                 Visibility="{Binding HasTranscript, Converter={StaticResource Visible}}" />
      <TextBlock Text="{x:Static r:VideoEditorText.BySentenceNote}" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"
                 Visibility="{Binding ShowsSentenceNote, Converter={StaticResource Visible}}" />
      <TextBlock x:Name="EditNote" Text="{x:Static r:VideoEditorText.CorrectingNote}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="11" Margin="0,2,0,0" Visibility="Collapsed"
                 AutomationProperties.LiveSetting="Polite" />
    </StackPanel>

    <!-- The review lists, under the words. -->
    <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{p:Chrome Separator}" MaxHeight="280"
            Visibility="{Binding ShowsSilences, Converter={StaticResource Visible}}">
      <DockPanel Margin="10,6">
        <StackPanel DockPanel.Dock="Top">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="{x:Static r:CommonText.Close}" Command="{Binding CloseReviewCommand}" Padding="8,1" />
            <TextBlock Text="{x:Static r:VideoEditorText.SilencesTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>
          <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="LongerLabel" Text="{x:Static r:VideoEditorText.SilencesLonger}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <Slider Grid.Column="1" Minimum="0.3" Maximum="3" SmallChange="0.05" LargeChange="0.25" Value="{Binding SilenceLonger}" AutomationProperties.LabeledBy="{Binding ElementName=LongerLabel}" />
            <TextBlock Grid.Column="2" Text="{Binding SilenceLonger, StringFormat={x:Static r:VideoEditorText.SecondsTenthsFormat}}" VerticalAlignment="Center" Margin="4,0,0,0" />
            <TextBlock x:Name="ShortenLabel" Grid.Row="1" Text="{x:Static r:VideoEditorText.SilencesShortenTo}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" Value="{Binding SilenceShortenTo}" AutomationProperties.LabeledBy="{Binding ElementName=ShortenLabel}" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SilenceShortenTo, StringFormat={x:Static r:VideoEditorText.SecondsTenthsFormat}}" VerticalAlignment="Center" Margin="4,0,0,0" />
          </Grid>
          <Button Content="{x:Static r:VideoEditorText.ShortenAllButton}" Command="{Binding ShortenAllCommand}" HorizontalAlignment="Left" Padding="8,2" Margin="0,6,0,4" />
          <TextBlock Text="{x:Static r:VideoEditorText.NoSilences}" Opacity="0.8" Visibility="{Binding HasNoSilences, Converter={StaticResource Visible}}" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <ItemsControl ItemsSource="{Binding Silences}" Focusable="False" VirtualizingPanel.IsVirtualizing="True">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:SilenceRow}">
                <DockPanel Margin="0,1">
                  <Button DockPanel.Dock="Right" Content="{x:Static r:VideoEditorText.KeepButton}" Command="{Binding KeepCommand}" AutomationProperties.Name="{Binding KeepName}" Padding="6,0" Margin="4,0,0,0" />
                  <Button DockPanel.Dock="Right" Content="{x:Static r:VideoEditorText.ShortenButton}" Command="{Binding ActCommand}" AutomationProperties.Name="{Binding ActName}" Padding="6,0" Margin="4,0,0,0" />
                  <Button DockPanel.Dock="Right" Content="{x:Static r:VideoEditorText.PlayRowButton}" Command="{Binding PlayCommand}" AutomationProperties.Name="{Binding PlayName}" Padding="6,0" Margin="4,0,0,0" />
                  <TextBlock Text="{Binding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{p:Chrome Separator}" MaxHeight="280"
            Visibility="{Binding ShowsFillers, Converter={StaticResource Visible}}">
      <DockPanel Margin="10,6">
        <StackPanel DockPanel.Dock="Top">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="{x:Static r:CommonText.Close}" Command="{Binding CloseReviewCommand}" Padding="8,1" />
            <TextBlock Text="{x:Static r:VideoEditorText.FillersTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>
          <CheckBox Content="{x:Static r:VideoEditorText.CountYani}" IsChecked="{Binding CountYani}" Margin="0,4,0,0" />
          <Button Content="{x:Static r:VideoEditorText.RemoveAllButton}" Command="{Binding RemoveAllFillersCommand}" HorizontalAlignment="Left" Padding="8,2" Margin="0,6,0,4" />
          <TextBlock Text="{x:Static r:VideoEditorText.NoFillers}" Opacity="0.8" Visibility="{Binding HasNoFillers, Converter={StaticResource Visible}}" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <ItemsControl ItemsSource="{Binding Fillers}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:FillerRow}">
                <DockPanel Margin="0,1">
                  <Button DockPanel.Dock="Right" Content="{x:Static r:VideoEditorText.KeepButton}" Command="{Binding KeepCommand}" AutomationProperties.Name="{Binding KeepName}" Padding="6,0" Margin="4,0,0,0" />
                  <Button DockPanel.Dock="Right" Content="{x:Static r:VideoEditorText.RemoveButton}" Command="{Binding ActCommand}" AutomationProperties.Name="{Binding ActName}" Padding="6,0" Margin="4,0,0,0" />
                  <Button DockPanel.Dock="Right" Content="{x:Static r:VideoEditorText.PlayRowButton}" Command="{Binding PlayCommand}" AutomationProperties.Name="{Binding PlayName}" Padding="6,0" Margin="4,0,0,0" />
                  <TextBlock Text="{Binding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Read out as the arrow keys move. -->
    <TextBlock x:Name="CaretLine" DockPanel.Dock="Bottom" Text="{Binding CaretText, NotifyOnTargetUpdated=True}" FontSize="11" Opacity="0.75" Margin="10,2" TextTrimming="CharacterEllipsis"
               AutomationProperties.LiveSetting="Polite" Binding.TargetUpdated="OnLiveTextUpdated" />

    <!-- The words: they run in their own language's direction, whatever the window's. -->
    <Grid FlowDirection="LeftToRight">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <local:TranscriptControl x:Name="Words" />
      <ScrollBar x:Name="WordsScroll" Grid.Column="1" Orientation="Vertical" Visibility="Collapsed" Minimum="0"
                 AutomationProperties.Name="{x:Static r:VideoEditorText.TranscriptScrollName}" />
      <Canvas x:Name="EditorLayer" IsHitTestVisible="True" Visibility="Collapsed">
        <TextBox x:Name="WordEditor" Padding="1,0" BorderThickness="2" BorderBrush="{p:Chrome Error}"
                 AutomationProperties.Name="{x:Static r:VideoEditorText.WordEditorName}"
                 PreviewKeyDown="OnEditorKeyDown" LostKeyboardFocus="OnEditorLostFocus" />
      </Canvas>
    </Grid>
  </DockPanel>
</UserControl>
