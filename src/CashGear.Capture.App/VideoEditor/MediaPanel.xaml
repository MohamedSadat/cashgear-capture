<UserControl x:Class="CashGear.Capture.App.VideoEditor.MediaPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:CashGear.Capture.App.VideoEditor"
             xmlns:r="clr-namespace:CashGear.Capture.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:MediaPanelViewModel}"
             KeyboardNavigation.TabNavigation="Local">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
  </UserControl.Resources>
  <DockPanel Margin="10,8,10,8">
    <TextBlock DockPanel.Dock="Top" Text="{x:Static r:VideoEditorText.MediaPanelTitle}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" />
    <WrapPanel DockPanel.Dock="Top">
      <Button Margin="0,0,6,4" Padding="8,2" Content="{x:Static r:VideoEditorText.ImportMediaButton}" Command="{Binding ImportCommand}" ToolTip="{x:Static r:VideoEditorText.ImportMediaTip}" />
      <Button Margin="0,0,6,4" Padding="8,2" Content="{x:Static r:VideoEditorText.AddColourButton}" Command="{Binding AddColourCommand}" ToolTip="{x:Static r:VideoEditorText.AddColourTip}" />
    </WrapPanel>
    <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
      <Button Margin="0,0,6,0" Padding="8,2" Content="{x:Static r:VideoEditorText.AddToTimelineButton}" Command="{Binding AddToTimelineCommand}" ToolTip="{x:Static r:VideoEditorText.AddToTimelineTip}" />
      <Button Padding="8,2" Content="{x:Static r:VideoEditorText.RemoveMediaButton}" Command="{Binding RemoveCommand}" ToolTip="{x:Static r:VideoEditorText.RemoveMediaTip}" />
    </WrapPanel>
    <TextBlock DockPanel.Dock="Top" Text="{x:Static r:VideoEditorText.MediaNone}" TextWrapping="Wrap" Opacity="0.8" Margin="0,4,0,6"
               Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
    <ListBox x:Name="List" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             AutomationProperties.Name="{x:Static r:VideoEditorText.MediaListName}"
             PreviewMouseLeftButtonDown="OnListPress" PreviewMouseMove="OnListMove" PreviewKeyDown="OnListKey" MouseDoubleClick="OnListDoubleClick">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
          <Setter Property="ToolTip" Value="{Binding Details}" />
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate DataType="{x:Type local:MediaItemViewModel}">
          <DockPanel Margin="0,2">
            <Border DockPanel.Dock="Left" Width="64" Height="36" Margin="0,0,8,0" BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" Opacity="0.85">
              <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Details}" FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DockPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
