<Window x:Class="CashGear.Capture.App.VideoEditor.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CashGear.Capture.App.VideoEditor"
        xmlns:r="clr-namespace:CashGear.Capture.App.Resources"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:ExportViewModel}"
        Title="{x:Static r:VideoEditorText.Export}"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
  </Window.Resources>
  <StackPanel Margin="20">
    <Grid IsEnabled="{Binding IsIdle}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Text="{x:Static r:VideoEditorText.FileFormat}" VerticalAlignment="Center" Margin="0,0,12,8" />
      <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name" Margin="0,0,0,8" />

      <TextBlock Grid.Row="1" Text="{x:Static r:VideoEditorText.Quality}" VerticalAlignment="Center" Margin="0,0,12,8" Visibility="{Binding HasQuality, Converter={StaticResource Visible}}" />
      <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding Qualities}" SelectedItem="{Binding Quality}" DisplayMemberPath="Name" Margin="0,0,0,8" Visibility="{Binding HasQuality, Converter={StaticResource Visible}}" />

      <Grid Grid.Row="1" Grid.ColumnSpan="3" Visibility="{Binding IsGif, Converter={StaticResource Visible}}" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{x:Static r:VideoEditorText.FramesASecond}" VerticalAlignment="Center" Margin="0,0,12,8" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding GifRates}" SelectedItem="{Binding GifFps}" Margin="0,0,12,8" />
        <TextBlock Grid.Column="2" Text="{x:Static r:VideoEditorText.WidthPixels}" VerticalAlignment="Center" Margin="0,0,12,8" />
        <ComboBox Grid.Column="3" ItemsSource="{Binding GifWidths}" SelectedItem="{Binding GifWidth}" Margin="0,0,0,8" />
        <TextBlock Grid.Row="1" Text="{x:Static r:VideoEditorText.Dithering}" VerticalAlignment="Center" Margin="0,0,12,8" />
        <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" ItemsSource="{Binding GifDithers}" SelectedItem="{Binding GifDithering}" DisplayMemberPath="Name" Margin="0,0,0,8" />
        <TextBlock Grid.Row="2" Text="{x:Static r:VideoEditorText.KeepItUnder}" VerticalAlignment="Center" Margin="0,0,12,0" />
        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding GifLimits}" SelectedItem="{Binding GifLimit}" DisplayMemberPath="Name" Margin="0,0,12,0" />
        <CheckBox Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Content="{x:Static r:VideoEditorText.PlayOverAndOver}" IsChecked="{Binding GifLoop}" VerticalAlignment="Center" />
      </Grid>

      <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SizeText}" Opacity="0.75" Margin="0,0,0,8" />

      <TextBlock Grid.Row="3" Text="{x:Static r:VideoEditorText.File}" VerticalAlignment="Center" Margin="0,0,12,0" />
      <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
      <Button Grid.Row="3" Grid.Column="2" Content="{x:Static r:CommonText.Browse}" Command="{Binding BrowseCommand}" Margin="8,0,0,0" />

      <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
        <CheckBox Content="{Binding RangeText}" IsChecked="{Binding OnlyRange}" Visibility="{Binding HasRange, Converter={StaticResource Visible}}" Margin="0,0,0,4" />
        <StackPanel Visibility="{Binding HasCaptions, Converter={StaticResource Visible}}">
          <CheckBox Content="{x:Static r:VideoEditorText.BurnCaptions}" IsChecked="{Binding BurnCaptions}" Margin="0,0,0,4" />
          <CheckBox Content="{x:Static r:VideoEditorText.SaveSrt}" IsChecked="{Binding SaveSrt}" Margin="0,0,0,4" />
          <CheckBox Content="{x:Static r:VideoEditorText.SaveVtt}" IsChecked="{Binding SaveVtt}" />
        </StackPanel>
      </StackPanel>
    </Grid>

    <ProgressBar Height="6" Margin="0,18,0,6" Minimum="0" Maximum="1" Value="{Binding Progress}" />
    <TextBlock Text="{Binding ProgressText}" TextWrapping="Wrap" MinHeight="18" />
    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="#D13438" Margin="0,6,0,0" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{x:Static r:CommonText.Open}" Command="{Binding OpenCommand}" Visibility="{Binding IsDone, Converter={StaticResource Visible}}" Margin="0,0,8,0" />
      <Button Content="{x:Static r:VideoEditorText.ShowInFolder}" Command="{Binding ShowInFolderCommand}" Visibility="{Binding IsDone, Converter={StaticResource Visible}}" Margin="0,0,8,0" />
      <Button Content="{x:Static r:VideoEditorText.Export}" Command="{Binding StartCommand}" IsDefault="True" MinWidth="88" Margin="0,0,8,0" />
      <Button x:Name="CancelButton" Command="{Binding CancelCommand}" MinWidth="88" />
    </StackPanel>
  </StackPanel>
</Window>
