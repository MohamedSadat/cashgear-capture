<Window x:Class="CashGear.Capture.App.VideoEditor.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:CashGear.Capture.App.Platform"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CashGear.Capture.App.VideoEditor"
        xmlns:r="clr-namespace:CashGear.Capture.App.Resources"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:ExportViewModel}"
        Title="{x:Static r:VideoEditorText.Export}"
        Width="600" SizeToContent="Height" ResizeMode="NoResize" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=FormatBox}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
  </Window.Resources>
  <!-- Enter exports (the default button), Esc cancels a running export or closes (the cancel button); the buttons come last for Tab. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
  <StackPanel Margin="20">
    <DockPanel IsEnabled="{Binding IsIdle}" Margin="0,0,0,8">
      <TextBlock x:Name="NamedLabel" DockPanel.Dock="Left" Text="{x:Static r:VideoEditorText.ExportPresetLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
      <Button DockPanel.Dock="Right" Content="{x:Static r:VideoEditorText.DeleteExportPreset}" Command="{Binding DeleteNamedExportCommand}" Margin="8,0,0,0" />
      <Button DockPanel.Dock="Right" Content="{x:Static r:VideoEditorText.SaveExportPreset}" Command="{Binding SaveNamedExportCommand}" Margin="8,0,0,0" />
      <ComboBox ItemsSource="{Binding NamedExports}" SelectedItem="{Binding SelectedNamedExport}" DisplayMemberPath="Name"
                AutomationProperties.LabeledBy="{Binding ElementName=NamedLabel}" />
    </DockPanel>
    <Grid IsEnabled="{Binding IsIdle}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock x:Name="FormatLabel" Grid.Row="0" Text="{x:Static r:VideoEditorText.FileFormat}" VerticalAlignment="Center" Margin="0,0,12,8" />
      <ComboBox x:Name="FormatBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name" Margin="0,0,0,8"
                AutomationProperties.LabeledBy="{Binding ElementName=FormatLabel}" />

      <TextBlock x:Name="QualityLabel" Grid.Row="1" Text="{x:Static r:VideoEditorText.Quality}" VerticalAlignment="Center" Margin="0,0,12,8" Visibility="{Binding HasQuality, Converter={StaticResource Visible}}" />
      <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding Qualities}" SelectedItem="{Binding Quality}" DisplayMemberPath="Name" Margin="0,0,0,8" Visibility="{Binding HasQuality, Converter={StaticResource Visible}}"
                AutomationProperties.LabeledBy="{Binding ElementName=QualityLabel}" />

      <Grid Grid.Row="1" Grid.ColumnSpan="3" Visibility="{Binding IsGif, Converter={StaticResource Visible}}" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="FpsLabel" Text="{x:Static r:VideoEditorText.FramesASecond}" VerticalAlignment="Center" Margin="0,0,12,8" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding GifRates}" SelectedItem="{Binding GifFps}" Margin="0,0,12,8"
                  AutomationProperties.LabeledBy="{Binding ElementName=FpsLabel}" />
        <TextBlock x:Name="WidthLabel" Grid.Column="2" Text="{x:Static r:VideoEditorText.WidthPixels}" VerticalAlignment="Center" Margin="0,0,12,8" />
        <ComboBox Grid.Column="3" ItemsSource="{Binding GifWidths}" SelectedItem="{Binding GifWidth}" Margin="0,0,0,8"
                  AutomationProperties.LabeledBy="{Binding ElementName=WidthLabel}" />
        <TextBlock x:Name="DitheringLabel" Grid.Row="1" Text="{x:Static r:VideoEditorText.Dithering}" VerticalAlignment="Center" Margin="0,0,12,8" />
        <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" ItemsSource="{Binding GifDithers}" SelectedItem="{Binding GifDithering}" DisplayMemberPath="Name" Margin="0,0,0,8"
                  AutomationProperties.LabeledBy="{Binding ElementName=DitheringLabel}" />
        <TextBlock x:Name="LimitLabel" Grid.Row="2" Text="{x:Static r:VideoEditorText.KeepItUnder}" VerticalAlignment="Center" Margin="0,0,12,0" />
        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding GifLimits}" SelectedItem="{Binding GifLimit}" DisplayMemberPath="Name" Margin="0,0,12,0"
                  AutomationProperties.LabeledBy="{Binding ElementName=LimitLabel}" />
        <CheckBox Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Content="{x:Static r:VideoEditorText.PlayOverAndOver}" IsChecked="{Binding GifLoop}" VerticalAlignment="Center" />
      </Grid>

      <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SizeText}" Opacity="0.75" Margin="0,0,0,8" />

      <TextBlock x:Name="FileLabel" Grid.Row="3" Text="{x:Static r:VideoEditorText.File}" VerticalAlignment="Center" Margin="0,0,12,0" />
      <TextBox FlowDirection="LeftToRight" Grid.Row="3" Grid.Column="1" Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"
               AutomationProperties.LabeledBy="{Binding ElementName=FileLabel}" />
      <Button Grid.Row="3" Grid.Column="2" Content="{x:Static r:CommonText.Browse}" Command="{Binding BrowseCommand}" Margin="8,0,0,0" />

      <TextBlock x:Name="LoudnessLabel" Grid.Row="4" Text="{x:Static r:VideoEditorText.ExportLoudnessLabel}" VerticalAlignment="Center" Margin="0,8,12,0" Visibility="{Binding HasSoundChoices, Converter={StaticResource Visible}}" />
      <ComboBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding Loudnesses}" SelectedItem="{Binding Loudness}" DisplayMemberPath="Name" Margin="0,8,0,0" Visibility="{Binding HasSoundChoices, Converter={StaticResource Visible}}"
                AutomationProperties.LabeledBy="{Binding ElementName=LoudnessLabel}" />

      <TextBlock x:Name="TracksLabel" Grid.Row="5" Text="{x:Static r:VideoEditorText.ExportTracksLabel}" VerticalAlignment="Center" Margin="0,8,12,0" Visibility="{Binding ChoosesTracks, Converter={StaticResource Visible}}" />
      <ComboBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding TracksOutChoices}" SelectedItem="{Binding TracksOut}" DisplayMemberPath="Name" Margin="0,8,0,0" Visibility="{Binding ChoosesTracks, Converter={StaticResource Visible}}"
                AutomationProperties.LabeledBy="{Binding ElementName=TracksLabel}" />

      <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
        <CheckBox Content="{Binding RangeText}" IsChecked="{Binding OnlyRange}" Visibility="{Binding HasRange, Converter={StaticResource Visible}}" Margin="0,0,0,4" />
        <StackPanel Visibility="{Binding HasMarkers, Converter={StaticResource Visible}}" Margin="0,0,0,4">
          <CheckBox Content="{x:Static r:VideoEditorText.ChaptersInFile}" IsChecked="{Binding ChaptersInFile}" IsEnabled="{Binding CanHoldChapters}" Margin="0,0,0,4" />
          <CheckBox Content="{x:Static r:VideoEditorText.ChaptersVttFile}" IsChecked="{Binding ChaptersVtt}" />
        </StackPanel>
        <StackPanel Visibility="{Binding HasCaptions, Converter={StaticResource Visible}}">
          <CheckBox Content="{x:Static r:VideoEditorText.BurnCaptions}" IsChecked="{Binding BurnCaptions}" Margin="0,0,0,4" />
          <StackPanel Orientation="Horizontal" Margin="20,0,0,4" Visibility="{Binding ChoosesCaptionTrack, Converter={StaticResource Visible}}">
            <TextBlock x:Name="BurnWhichLabel" Text="{x:Static r:VideoEditorText.BurnWhichCaptions}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox MinWidth="180" ItemsSource="{Binding CaptionTracks}" SelectedItem="{Binding BurnTrack}" DisplayMemberPath="Name" IsEnabled="{Binding BurnCaptions}"
                      AutomationProperties.LabeledBy="{Binding ElementName=BurnWhichLabel}" />
          </StackPanel>
          <CheckBox Content="{x:Static r:VideoEditorText.SaveSrt}" IsChecked="{Binding SaveSrt}" Margin="0,0,0,4" />
          <CheckBox Content="{x:Static r:VideoEditorText.SaveVtt}" IsChecked="{Binding SaveVtt}" />
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- Where the file goes when it is done. What YouTube asks for shows when it goes there. -->
    <StackPanel IsEnabled="{Binding IsIdle}" Visibility="{Binding CanSend, Converter={StaticResource Visible}}" Margin="0,12,0,0">
      <DockPanel>
        <TextBlock x:Name="SendLabel" DockPanel.Dock="Left" Text="{x:Static r:VideoEditorText.SendToLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
        <ComboBox ItemsSource="{Binding SendTargets}" SelectedItem="{Binding SendTo}" DisplayMemberPath="Name"
                  AutomationProperties.LabeledBy="{Binding ElementName=SendLabel}" />
      </DockPanel>
      <Grid Margin="0,8,0,0" Visibility="{Binding IsYouTube, Converter={StaticResource Visible}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="YtTitleLabel" Text="{x:Static r:VideoEditorText.YouTubeTitle}" VerticalAlignment="Center" Margin="0,0,12,6" />
        <TextBox Grid.Column="1" Text="{Binding YouTubeTitle, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Margin="0,0,0,6" AutomationProperties.LabeledBy="{Binding ElementName=YtTitleLabel}" />
        <TextBlock x:Name="YtDescriptionLabel" Grid.Row="1" Text="{x:Static r:VideoEditorText.YouTubeDescription}" Margin="0,0,12,6" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding YouTubeDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinLines="3" MaxLines="5" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6" AutomationProperties.LabeledBy="{Binding ElementName=YtDescriptionLabel}" />
        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" Visibility="{Binding HasMarkers, Converter={StaticResource Visible}}">
          <CheckBox Content="{x:Static r:VideoEditorText.ChaptersInDescription}" IsChecked="{Binding ChaptersInDescription}" />
          <TextBlock Text="{Binding ChaptersPreview}" TextWrapping="Wrap" Opacity="0.75" Margin="20,2,0,0" FlowDirection="LeftToRight" NumberSubstitution.Substitution="European" />
          <TextBlock Text="{Binding ChaptersNote}" TextWrapping="Wrap" Foreground="{p:Chrome Error}" Margin="20,2,0,0" />
        </StackPanel>
        <TextBlock x:Name="YtTagsLabel" Grid.Row="3" Text="{x:Static r:VideoEditorText.YouTubeTags}" VerticalAlignment="Center" Margin="0,0,12,6" />
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding YouTubeTags, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" AutomationProperties.LabeledBy="{Binding ElementName=YtTagsLabel}" />
        <TextBlock x:Name="YtPrivacyLabel" Grid.Row="4" Text="{x:Static r:VideoEditorText.YouTubePrivacy}" VerticalAlignment="Center" Margin="0,0,12,6" />
        <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding Privacies}" SelectedItem="{Binding Privacy}" DisplayMemberPath="Name" Margin="0,0,0,6" AutomationProperties.LabeledBy="{Binding ElementName=YtPrivacyLabel}" />
        <TextBlock x:Name="YtPlaylistLabel" Grid.Row="5" Text="{x:Static r:VideoEditorText.YouTubePlaylist}" VerticalAlignment="Center" Margin="0,0,12,6" />
        <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding Playlists}" SelectedItem="{Binding Playlist}" DisplayMemberPath="Name" Margin="0,0,0,6" AutomationProperties.LabeledBy="{Binding ElementName=YtPlaylistLabel}" />
        <TextBlock x:Name="YtThumbnailLabel" Grid.Row="6" Text="{x:Static r:VideoEditorText.YouTubeThumbnail}" VerticalAlignment="Center" Margin="0,0,12,0" />
        <DockPanel Grid.Row="6" Grid.Column="1">
          <Button DockPanel.Dock="Right" Content="{x:Static r:VideoEditorText.MakeThumbnail}" Command="{Binding ChooseThumbnailCommand}" Margin="8,0,0,0" AutomationProperties.LabeledBy="{Binding ElementName=YtThumbnailLabel}" />
          <TextBlock Text="{Binding ThumbnailText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </Grid>
    </StackPanel>

    <ProgressBar Height="6" Margin="0,18,0,6" Minimum="0" Maximum="1" Value="{Binding Progress}"
                 AutomationProperties.Name="{x:Static r:VideoEditorText.ExportProgressName}" />
    <TextBlock Text="{Binding ProgressText, NotifyOnTargetUpdated=True}" TextWrapping="Wrap" MinHeight="18"
               AutomationProperties.LiveSetting="Polite" Binding.TargetUpdated="OnLiveTextUpdated" />
    <TextBlock Text="{Binding Error, NotifyOnTargetUpdated=True}" TextWrapping="Wrap" Foreground="{p:Chrome Error}" Margin="0,6,0,0"
               AutomationProperties.LiveSetting="Assertive" Binding.TargetUpdated="OnLiveTextUpdated" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{x:Static r:CommonText.Open}" Command="{Binding OpenCommand}" Visibility="{Binding IsDone, Converter={StaticResource Visible}}" Margin="0,0,8,0" />
      <Button Content="{x:Static r:VideoEditorText.ShowInFolder}" Command="{Binding ShowInFolderCommand}" Visibility="{Binding IsDone, Converter={StaticResource Visible}}" Margin="0,0,8,0" />
      <Button Content="{x:Static r:VideoEditorText.Export}" Command="{Binding StartCommand}" IsDefault="True" MinWidth="88" Margin="0,0,8,0" />
      <Button x:Name="CancelButton" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="88" />
    </StackPanel>
  </StackPanel>
  </ScrollViewer>
</Window>
