<Window x:Class="CashGear.Capture.App.VideoEditor.TranslateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:CashGear.Capture.App.Platform"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CashGear.Capture.App.VideoEditor"
        xmlns:r="clr-namespace:CashGear.Capture.App.Resources"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:TranslateViewModel}"
        Title="{x:Static r:VideoEditorText.TranslateTitle}"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=ChoiceBox}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
  </Window.Resources>
  <!-- Enter translates (the default button), Esc cancels or closes (the cancel button); the buttons come last for Tab. -->
  <StackPanel Margin="20">
    <TextBlock TextWrapping="Wrap" Margin="0,0,0,14" Opacity="0.8" Text="{x:Static r:VideoEditorText.TranslateIntro}" />
    <Grid IsEnabled="{Binding IsIdle}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock x:Name="ChoiceLabel" Text="{x:Static r:VideoEditorText.TranslateWhat}" VerticalAlignment="Center" Margin="0,0,12,8" />
      <ComboBox x:Name="ChoiceBox" Grid.Column="1" ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice}" DisplayMemberPath="Name" Margin="0,0,0,8"
                AutomationProperties.LabeledBy="{Binding ElementName=ChoiceLabel}" />
      <CheckBox Grid.Row="1" Grid.Column="1" Content="{x:Static r:VideoEditorText.UseGpu}" IsChecked="{Binding UseGpu}" Visibility="{Binding ShowsGpu, Converter={StaticResource Visible}}" />
    </Grid>
    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Opacity="0.8" Margin="0,4,0,0" />
    <ProgressBar Height="6" Margin="0,14,0,6" Minimum="0" Maximum="1" Value="{Binding Progress}"
                 AutomationProperties.Name="{x:Static r:VideoEditorText.TranslateProgressName}" />
    <TextBlock Text="{Binding Status, NotifyOnTargetUpdated=True}" TextWrapping="Wrap" MinHeight="18"
               AutomationProperties.LiveSetting="Polite" Binding.TargetUpdated="OnLiveTextUpdated" />
    <TextBlock Text="{Binding Error, NotifyOnTargetUpdated=True}" TextWrapping="Wrap" Foreground="{p:Chrome Error}" Margin="0,6,0,0"
               AutomationProperties.LiveSetting="Assertive" Binding.TargetUpdated="OnLiveTextUpdated" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{x:Static r:VideoEditorText.TranslateStart}" Command="{Binding StartCommand}" IsDefault="True" MinWidth="110" Margin="0,0,8,0" />
      <Button x:Name="CancelButton" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="88" />
    </StackPanel>
  </StackPanel>
</Window>
