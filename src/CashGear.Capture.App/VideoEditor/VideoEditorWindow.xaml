<Window x:Class="CashGear.Capture.App.VideoEditor.VideoEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CashGear.Capture.App.VideoEditor"
        xmlns:editor="clr-namespace:CashGear.Capture.App.Editor"
        xmlns:r="clr-namespace:CashGear.Capture.App.Resources"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:VideoEditorViewModel}"
        Title="{Binding Title}"
        Width="1280" Height="840" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <Window.InputBindings>
    <KeyBinding Key="S" Command="{Binding SplitCommand}" />
    <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
    <KeyBinding Gesture="Shift+Delete" Command="{Binding RippleDeleteCommand}" />
    <KeyBinding Key="I" Command="{Binding MarkInCommand}" />
    <KeyBinding Key="O" Command="{Binding MarkOutCommand}" />
    <KeyBinding Key="Escape" Command="{Binding ClearSelectionCommand}" />
    <KeyBinding Key="Left" Command="{Binding StepBackCommand}" />
    <KeyBinding Key="Right" Command="{Binding StepForwardCommand}" />
    <KeyBinding Key="Home" Command="{Binding GoToStartCommand}" />
    <KeyBinding Key="End" Command="{Binding GoToEndCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveProjectCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveProjectAsCommand}" />
    <KeyBinding Gesture="Ctrl+E" Command="{Binding ExportCommand}" />
    <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+Add" Command="{Binding ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Gesture="Ctrl+Subtract" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Gesture="Ctrl+D0" Command="{Binding ZoomFitCommand}" />
    <KeyBinding Gesture="Ctrl+NumPad0" Command="{Binding ZoomFitCommand}" />
  </Window.InputBindings>

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <editor:EditParameterTemplates />
      </ResourceDictionary.MergedDictionaries>
    <BooleanToVisibilityConverter x:Key="Visible" />

    <DataTemplate x:Key="TrackHeader" DataType="{x:Type local:TrackHeaderViewModel}">
      <Border Height="{Binding Height}" BorderThickness="0,0,0,1" BorderBrush="#30808080" Padding="8,3,4,3" Background="Transparent">
        <Border.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{x:Static r:VideoEditorText.DeleteTrack}" Command="{Binding DeleteCommand}" />
          </ContextMenu>
        </Border.ContextMenu>
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <ToggleButton Content="M" Width="26" Height="24" Padding="0" Margin="2,0" ToolTip="{x:Static r:VideoEditorText.MuteTip}"
                          IsChecked="{Binding IsMuted}" Visibility="{Binding HasSound, Converter={StaticResource Visible}}" />
            <ToggleButton Content="S" Width="26" Height="24" Padding="0" Margin="2,0" ToolTip="{x:Static r:VideoEditorText.SoloTip}"
                          IsChecked="{Binding IsSolo}" Visibility="{Binding HasSound, Converter={StaticResource Visible}}" />
            <CheckBox ToolTip="{x:Static r:VideoEditorText.ShownTip}" IsChecked="{Binding IsShown}" MinWidth="0" Margin="2,0"
                      Visibility="{Binding HasPictures, Converter={StaticResource Visible}}" />
            <ToggleButton Content="L" Width="26" Height="24" Padding="0" Margin="2,0" ToolTip="{x:Static r:VideoEditorText.LockTip}"
                          IsChecked="{Binding IsLocked}" />
          </StackPanel>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Kind}" FontSize="11" Opacity="0.7"
                       Visibility="{Binding HasPictures, Converter={StaticResource Visible}}" />
            <Slider Minimum="0" Maximum="200" Value="{Binding Volume}" Width="64" HorizontalAlignment="Left" Margin="0,-2,0,0"
                    ToolTip="{Binding Volume}" ToolTipService.ShowDuration="2000" AutomationProperties.Name="{x:Static r:VideoEditorText.TrackVolume}"
                    Visibility="{Binding HasSound, Converter={StaticResource Visible}}" />
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="{x:Static r:VideoEditorText.MenuFile}">
        <MenuItem Header="{x:Static r:VideoEditorText.AddRecordingMenu}" Command="{Binding AddRecordingCommand}" />
        <MenuItem Header="{x:Static r:VideoEditorText.AddMusicMenu}" Command="{Binding AddMusicCommand}" ToolTip="{x:Static r:VideoEditorText.AddMusicTip}" />
        <Separator />
        <MenuItem Header="{x:Static r:VideoEditorText.SaveProjectMenu}" Command="{Binding SaveProjectCommand}" InputGestureText="Ctrl+S" />
        <MenuItem Header="{x:Static r:VideoEditorText.SaveProjectAsMenu}" Command="{Binding SaveProjectAsCommand}" InputGestureText="Ctrl+Shift+S" />
        <MenuItem Header="{x:Static r:VideoEditorText.SaveWithMediaMenu}" Command="{Binding SaveWithMediaCommand}" ToolTip="{x:Static r:VideoEditorText.SaveWithMediaTip}" />
        <Separator />
        <MenuItem Header="{x:Static r:VideoEditorText.ImportCaptionsMenu}" Command="{Binding ImportCaptionsCommand}" ToolTip="{x:Static r:VideoEditorText.ImportCaptionsTip}" />
        <MenuItem Header="{x:Static r:VideoEditorText.SaveCaptionsMenu}" Command="{Binding SaveCaptionsCommand}" ToolTip="{x:Static r:VideoEditorText.SaveCaptionsTip}" />
        <Separator />
        <MenuItem Header="{x:Static r:VideoEditorText.ExportMenu}" Command="{Binding ExportCommand}" InputGestureText="Ctrl+E" />
        <Separator />
        <MenuItem Header="{x:Static r:VideoEditorText.CloseMenu}" Click="OnCloseClick" />
      </MenuItem>
      <MenuItem Header="{x:Static r:VideoEditorText.MenuEdit}">
        <MenuItem Header="{Binding UndoText}" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z" />
        <MenuItem Header="{Binding RedoText}" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y" />
        <Separator />
        <MenuItem Header="{x:Static r:VideoEditorText.SplitMenu}" Command="{Binding SplitCommand}" InputGestureText="S" />
        <MenuItem Header="{x:Static r:VideoEditorText.DeleteMenu}" Command="{Binding DeleteCommand}" InputGestureText="Del" ToolTip="{x:Static r:VideoEditorText.DeleteMenuTip}" />
        <MenuItem Header="{x:Static r:VideoEditorText.RippleDeleteMenu}" Command="{Binding RippleDeleteCommand}" InputGestureText="Shift+Del" ToolTip="{x:Static r:VideoEditorText.RippleDeleteTip}" />
        <Separator />
        <MenuItem Header="{x:Static r:VideoEditorText.FreezeFrameMenu}" Command="{Binding FreezeFrameCommand}" ToolTip="{x:Static r:VideoEditorText.FreezeFrameTip}" />
        <MenuItem Header="{x:Static r:VideoEditorText.CrossfadeMenu}" Command="{Binding CrossfadeCommand}" ToolTip="{x:Static r:VideoEditorText.CrossfadeTip}" />
        <Separator />
        <MenuItem Header="{x:Static r:VideoEditorText.MarkInMenu}" Command="{Binding MarkInCommand}" InputGestureText="I" />
        <MenuItem Header="{x:Static r:VideoEditorText.MarkOutMenu}" Command="{Binding MarkOutCommand}" InputGestureText="O" />
        <MenuItem Header="{x:Static r:VideoEditorText.ClearSelectionMenu}" Command="{Binding ClearSelectionCommand}" InputGestureText="Esc" />
      </MenuItem>
      <MenuItem Header="{x:Static r:VideoEditorText.MenuInsert}">
        <MenuItem Header="{x:Static r:VideoEditorText.InsertTextMenu}" Command="{Binding InsertTextCommand}" />
        <MenuItem Header="{x:Static r:VideoEditorText.InsertArrowMenu}" Command="{Binding InsertArrowCommand}" />
        <MenuItem Header="{x:Static r:VideoEditorText.InsertLineMenu}" Command="{Binding InsertLineCommand}" />
        <MenuItem Header="{x:Static r:VideoEditorText.InsertRectangleMenu}" Command="{Binding InsertRectangleCommand}" />
        <MenuItem Header="{x:Static r:VideoEditorText.InsertEllipseMenu}" Command="{Binding InsertEllipseCommand}" />
        <MenuItem Header="{x:Static r:VideoEditorText.InsertHighlightMenu}" Command="{Binding InsertHighlightCommand}" />
        <Separator />
        <MenuItem Header="{x:Static r:VideoEditorText.InsertBlurMenu}" Command="{Binding InsertBlurCommand}" />
        <MenuItem Header="{x:Static r:VideoEditorText.InsertPixelateMenu}" Command="{Binding InsertPixelateCommand}" />
        <Separator />
        <MenuItem Header="{x:Static r:VideoEditorText.InsertClicksMenu}" Command="{Binding InsertClicksCommand}" ToolTip="{x:Static r:VideoEditorText.InsertClicksTip}" />
        <MenuItem Header="{x:Static r:VideoEditorText.InsertKeystrokesMenu}" Command="{Binding InsertKeystrokesCommand}" ToolTip="{x:Static r:VideoEditorText.InsertKeystrokesTip}" />
        <MenuItem Header="{x:Static r:VideoEditorText.InsertPointerMenu}" Command="{Binding InsertPointerCommand}" ToolTip="{x:Static r:VideoEditorText.InsertPointerTip}" />
        <Separator />
        <MenuItem Header="{x:Static r:VideoEditorText.InsertZoomMenu}" Command="{Binding InsertZoomCommand}" ToolTip="{x:Static r:VideoEditorText.InsertZoomTip}" />
        <MenuItem Header="{x:Static r:VideoEditorText.AutoZoomMenu}" Command="{Binding MakeAutoZoomsCommand}" ToolTip="{x:Static r:VideoEditorText.AutoZoomTip}" />
        <Separator />
        <MenuItem Header="{x:Static r:VideoEditorText.InsertCaptionMenu}" Command="{Binding InsertCaptionCommand}" ToolTip="{x:Static r:VideoEditorText.InsertCaptionTip}" />
        <MenuItem Header="{x:Static r:VideoEditorText.TranscribeMenu}" Command="{Binding TranscribeCommand}" ToolTip="{x:Static r:VideoEditorText.TranscribeMenuTip}" />
      </MenuItem>
      <MenuItem Header="{x:Static r:VideoEditorText.MenuView}">
        <MenuItem Header="{x:Static r:VideoEditorText.ZoomInMenu}" Command="{Binding ZoomInCommand}" InputGestureText="Ctrl++" />
        <MenuItem Header="{x:Static r:VideoEditorText.ZoomOutMenu}" Command="{Binding ZoomOutCommand}" InputGestureText="Ctrl+-" />
        <MenuItem Header="{x:Static r:VideoEditorText.FitTimelineMenu}" Command="{Binding ZoomFitCommand}" InputGestureText="Ctrl+0" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Bottom" Padding="10,4" BorderThickness="0,1,0,0" BorderBrush="#40808080">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Opacity="0.75" />
        <TextBlock x:Name="SelectionLine" Text="{Binding SelectionText}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- The selected item's settings -->
    <Border DockPanel.Dock="Right" Width="250" BorderThickness="1,0,0,0" BorderBrush="#40808080">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,10,12,12">
          <TextBlock Text="{Binding PropertiesTitle}" FontWeight="SemiBold" FontSize="14" />
          <TextBlock Text="{x:Static r:VideoEditorText.NothingSelected}" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasProperties}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <ItemsControl ItemsSource="{Binding Properties}" Focusable="False" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="160" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="5" />
        <RowDefinition Height="270" MinHeight="120" />
      </Grid.RowDefinitions>

      <local:PreviewHost x:Name="Preview" Grid.Row="0" />

      <!-- Transport -->
      <Border Grid.Row="1" Padding="10,6" BorderThickness="0,1,0,1" BorderBrush="#40808080">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="{x:Static r:VideoEditorText.TextButton}" Command="{Binding InsertTextCommand}" ToolTip="{x:Static r:VideoEditorText.TextButtonTip}" Margin="4,0" />
            <Button Content="{x:Static r:VideoEditorText.ArrowButton}" Command="{Binding InsertArrowCommand}" ToolTip="{x:Static r:VideoEditorText.ArrowButtonTip}" Margin="4,0" />
            <Button Content="{x:Static r:VideoEditorText.BlurButton}" Command="{Binding InsertBlurCommand}" ToolTip="{x:Static r:VideoEditorText.BlurButtonTip}" Margin="4,0" />
            <Button Content="{x:Static r:VideoEditorText.ZoomButton}" Command="{Binding InsertZoomCommand}" ToolTip="{x:Static r:VideoEditorText.InsertZoomTip}" Margin="4,0" />
            <Button Content="{x:Static r:VideoEditorText.CaptionsButton}" Command="{Binding TranscribeCommand}" ToolTip="{x:Static r:VideoEditorText.CaptionsButtonTip}" Margin="4,0,16,0" />
            <Button Content="{x:Static r:VideoEditorText.SplitButton}" Command="{Binding SplitCommand}" ToolTip="{x:Static r:VideoEditorText.SplitButtonTip}" Margin="4,0" />
            <Button Content="{x:Static r:CommonText.Delete}" Command="{Binding DeleteCommand}" ToolTip="{x:Static r:VideoEditorText.DeleteButtonTip}" Margin="4,0" />
            <Button Content="{x:Static r:VideoEditorText.ExportButton}" Command="{Binding ExportCommand}" ToolTip="{x:Static r:VideoEditorText.ExportButtonTip}" Margin="4,0" />
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <Button Content="⏮" Command="{Binding GoToStartCommand}" ToolTip="{x:Static r:VideoEditorText.GoToStartTip}" Width="40" Margin="0,0,4,0" />
            <Button Content="◀" Command="{Binding StepBackCommand}" ToolTip="{x:Static r:VideoEditorText.StepBackTip}" Width="40" Margin="0,0,4,0" />
            <Button x:Name="PlayButton" Command="{Binding PlayPauseCommand}" ToolTip="{x:Static r:VideoEditorText.PlayPauseTip}" Width="56" Margin="0,0,4,0" />
            <Button Content="▶" Command="{Binding StepForwardCommand}" ToolTip="{x:Static r:VideoEditorText.StepForwardTip}" Width="40" Margin="0,0,4,0" />
            <Button Content="⏭" Command="{Binding GoToEndCommand}" ToolTip="{x:Static r:VideoEditorText.GoToEndTip}" Width="40" Margin="0,0,12,0" />
            <TextBlock Text="{Binding TimeText}" VerticalAlignment="Center" FontFamily="Consolas" FontSize="14" />
          </StackPanel>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" ResizeDirection="Rows" Background="Transparent" />

      <!-- Timeline: track headers on the left, the rows drawn with Skia on the right -->
      <Grid Grid.Row="3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="190" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="#40808080" ClipToBounds="True">
          <ItemsControl x:Name="Headers" ItemsSource="{Binding Tracks}" ItemTemplate="{StaticResource TrackHeader}" Margin="0,26,0,0" Focusable="False">
            <ItemsControl.RenderTransform>
              <TranslateTransform Y="{Binding RowsOffset}" />
            </ItemsControl.RenderTransform>
          </ItemsControl>
        </Border>
        <local:TimelineControl x:Name="TimelineSurface" Grid.Column="1" />
      </Grid>
    </Grid>
  </DockPanel>
</Window>
