<Window x:Class="CashGear.Capture.App.History.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CashGear.Capture.App.History"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:HistoryViewModel}"
        Title="Capture History"
        Width="860" Height="580" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
  </Window.Resources>

  <DockPanel Margin="16">
    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal">
        <Button Content="Open in Editor" Command="{Binding OpenCommand}" MinWidth="110" Margin="0,0,8,0" />
        <Button Content="Copy" Command="{Binding CopyCommand}" MinWidth="80" Margin="0,0,8,0" />
        <Button Content="Show in Folder" Command="{Binding ShowInFolderCommand}" MinWidth="110" Margin="0,0,8,0" />
        <Button Content="Save As…" Command="{Binding SaveAsCommand}" MinWidth="90" Margin="0,0,8,0" />
        <Button Content="Remove" Command="{Binding RemoveCommand}" MinWidth="80" />
      </StackPanel>
      <Button Content="Clear History…" Command="{Binding ClearCommand}" HorizontalAlignment="Right" MinWidth="110" />
    </Grid>

    <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Opacity="0.75" Margin="0,0,0,10" />

    <Grid>
      <ListBox x:Name="List" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OnDoubleClick"
               AutomationProperties.Name="Captures">
        <ListBox.InputBindings>
          <KeyBinding Key="Return" Command="{Binding OpenCommand}" />
          <KeyBinding Key="Delete" Command="{Binding RemoveCommand}" />
          <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyCommand}" />
        </ListBox.InputBindings>
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type local:HistoryItem}">
            <StackPanel Width="200" Margin="4" ToolTip="{Binding Entry.SavedPath}">
              <Border Height="134" Background="#18808080">
                <Image Source="{Binding Thumbnail}" Stretch="Uniform" StretchDirection="DownOnly"
                       RenderOptions.BitmapScalingMode="HighQuality" />
              </Border>
              <TextBlock Text="{Binding When}" FontWeight="SemiBold" Margin="0,6,0,0" />
              <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" Opacity="0.75" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Text="Nothing here yet." HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"
                 Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
    </Grid>
  </DockPanel>
</Window>
