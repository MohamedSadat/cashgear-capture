<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf">

  <tb:TaskbarIcon x:Key="TrayIcon"
                  ToolTipText="CashGear Capture"
                  MenuActivation="LeftOrRightClick"
                  NoLeftClickDelay="True">
    <tb:TaskbarIcon.IconSource>
      <tb:GeneratedIconSource Text="CG"
                              Foreground="White"
                              Background="#1E6FD9"
                              FontWeight="Bold" />
    </tb:TaskbarIcon.IconSource>

    <tb:TaskbarIcon.ContextMenu>
      <ContextMenu>
        <MenuItem Header="Capture _Region" Command="{Binding CaptureRegionCommand}" InputGestureText="{Binding RegionHotkey}" />
        <MenuItem Header="Capture _Window" Command="{Binding CaptureWindowCommand}" />
        <MenuItem Header="Capture _Full Screen" Command="{Binding CaptureFullScreenCommand}" InputGestureText="{Binding FullScreenHotkey}" />
        <MenuItem Header="_Scrolling Capture" Command="{Binding CaptureScrollingCommand}" InputGestureText="{Binding ScrollingHotkey}" />
        <MenuItem Header="Capture _Text" Command="{Binding CaptureTextCommand}" InputGestureText="{Binding TextHotkey}" />
        <Separator />
        <MenuItem Header="{Binding RecordText}" Command="{Binding ToggleRecordingCommand}" InputGestureText="{Binding RecordHotkey}" />
        <Separator />
        <MenuItem Header="_Settings…" Command="{Binding OpenSettingsCommand}" />
        <Separator />
        <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
      </ContextMenu>
    </tb:TaskbarIcon.ContextMenu>
  </tb:TaskbarIcon>

</ResourceDictionary>
