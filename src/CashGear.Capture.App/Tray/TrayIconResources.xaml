<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf">

  <BooleanToVisibilityConverter x:Key="TrayVisible" />

  <!-- The icon itself is set in TrayIconHost (the app icon at the notification area's size). -->
  <tb:TaskbarIcon x:Key="TrayIcon"
                  ToolTipText="CashGear Capture"
                  MenuActivation="LeftOrRightClick"
                  NoLeftClickDelay="True">

    <tb:TaskbarIcon.ContextMenu>
      <ContextMenu>
        <MenuItem Header="Capture _Region" Command="{Binding CaptureRegionCommand}" InputGestureText="{Binding RegionHotkey}" />
        <MenuItem Header="Capture _Window" Command="{Binding CaptureWindowCommand}" InputGestureText="{Binding WindowHotkey}" />
        <MenuItem Header="Capture _Full Screen" Command="{Binding CaptureFullScreenCommand}" InputGestureText="{Binding FullScreenHotkey}" />
        <MenuItem Header="_Scrolling Capture" Command="{Binding CaptureScrollingCommand}" InputGestureText="{Binding ScrollingHotkey}" />
        <MenuItem Header="Capture _Text" Command="{Binding CaptureTextCommand}" InputGestureText="{Binding TextHotkey}" />
        <MenuItem Header="_More Captures">
          <MenuItem Header="_Fixed-Size Region" Command="{Binding CaptureFixedRegionCommand}" InputGestureText="{Binding FixedRegionHotkey}" />
          <MenuItem Header="F_reehand Region" Command="{Binding CaptureFreehandCommand}" InputGestureText="{Binding FreehandHotkey}" />
          <MenuItem Header="_Polygon Region" Command="{Binding CapturePolygonCommand}" InputGestureText="{Binding PolygonHotkey}" />
          <MenuItem Header="R_ounded Region" Command="{Binding CaptureRoundedRegionCommand}" InputGestureText="{Binding RoundedRegionHotkey}" />
          <Separator />
          <MenuItem Header="O_bject (Part of a Window)" Command="{Binding CaptureObjectCommand}" InputGestureText="{Binding ObjectHotkey}" />
          <MenuItem Header="Open _Menu" Command="{Binding CaptureMenuCommand}" InputGestureText="{Binding MenuHotkey}" />
        </MenuItem>
        <MenuItem Header="Repeat _Last Capture" Command="{Binding RepeatLastCaptureCommand}" InputGestureText="{Binding RepeatHotkey}" />
        <MenuItem Header="Capture _Toolbar" IsCheckable="True" IsChecked="{Binding IsToolbarVisible, Mode=OneWay}"
                  Command="{Binding ToggleToolbarCommand}" InputGestureText="{Binding ToolbarHotkey}" />
        <MenuItem Header="T_ools">
          <MenuItem Header="_Magnifier" Command="{Binding ToggleMagnifierCommand}" InputGestureText="{Binding MagnifierHotkey}" />
          <MenuItem Header="_Colour Picker" Command="{Binding PickColorCommand}" InputGestureText="{Binding ColorPickerHotkey}" />
          <MenuItem Header="Screen _Ruler" IsCheckable="True" IsChecked="{Binding IsRulerVisible, Mode=OneWay}" Command="{Binding ToggleRulerCommand}" InputGestureText="{Binding RulerHotkey}" />
          <MenuItem Header="Cross_hair" IsCheckable="True" IsChecked="{Binding IsCrosshairVisible, Mode=OneWay}" Command="{Binding ToggleCrosshairCommand}" InputGestureText="{Binding CrosshairHotkey}" />
          <Separator />
          <MenuItem Header="_Batch Process…" Command="{Binding BatchProcessCommand}" />
          <MenuItem Header="Com_bine Images…" Command="{Binding CombineImagesCommand}" />
          <MenuItem Header="Images to _PDF…" Command="{Binding ImagesToPdfCommand}" />
        </MenuItem>
        <MenuItem Header="{Binding DelayHeader}" ItemsSource="{Binding DelayChoices}">
          <MenuItem.ItemContainerStyle>
            <Style TargetType="MenuItem">
              <Setter Property="Header" Value="{Binding Label}" />
              <Setter Property="IsChecked" Value="{Binding IsChecked, Mode=OneWay}" />
              <Setter Property="Command" Value="{Binding SelectCommand}" />
            </Style>
          </MenuItem.ItemContainerStyle>
        </MenuItem>
        <Separator />
        <MenuItem Header="{Binding RecordText}" Command="{Binding ToggleRecordingCommand}" InputGestureText="{Binding RecordHotkey}" />
        <MenuItem Header="Add _Overlays to a Recording…" Command="{Binding AddOverlaysCommand}" />
        <MenuItem Header="_Video Editor">
          <MenuItem Header="_Open a Recording or Project…" Command="{Binding OpenVideoEditorCommand}" />
          <MenuItem Header="{Binding EditLastRecordingText}" Command="{Binding EditLastRecordingCommand}" IsEnabled="{Binding HasLastRecording}" />
        </MenuItem>
        <MenuItem Header="Save _Interrupted Recordings" Command="{Binding RecoverRecordingsCommand}"
                  Visibility="{Binding HasInterruptedRecordings, Converter={StaticResource TrayVisible}}" />
        <Separator />
        <MenuItem Header="Recent _Captures" ItemsSource="{Binding RecentCaptures}" IsEnabled="{Binding HasRecentCaptures}">
          <MenuItem.ItemContainerStyle>
            <Style TargetType="MenuItem">
              <Setter Property="Command" Value="{Binding Open}" />
              <Setter Property="HeaderTemplate">
                <Setter.Value>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                      <Border Width="64" Height="40" Background="#18808080" Margin="0,0,10,0">
                        <Image Source="{Binding Item.Thumbnail}" Stretch="Uniform" StretchDirection="DownOnly"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                      </Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Item.When}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Item.Description}" Opacity="0.75" />
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </MenuItem.ItemContainerStyle>
        </MenuItem>
        <MenuItem Header="Capture _History…" Command="{Binding OpenHistoryCommand}" />
        <Separator />
        <MenuItem Header="{Binding UpdateText}" Command="{Binding RestartToUpdateCommand}"
                  Visibility="{Binding IsUpdateReady, Converter={StaticResource TrayVisible}}" />
        <MenuItem Header="_Settings…" Command="{Binding OpenSettingsCommand}" />
        <MenuItem Header="Export _Diagnostics…" Command="{Binding ExportDiagnosticsCommand}" />
        <Separator />
        <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
      </ContextMenu>
    </tb:TaskbarIcon.ContextMenu>
  </tb:TaskbarIcon>

</ResourceDictionary>
