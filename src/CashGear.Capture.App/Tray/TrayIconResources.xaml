<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:p="clr-namespace:CashGear.Capture.App.Platform"
                    xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
                    xmlns:r="clr-namespace:CashGear.Capture.App.Resources">

  <BooleanToVisibilityConverter x:Key="TrayVisible" />

  <!-- The icon itself is set in TrayIconHost (the app icon at the notification area's size). -->
  <tb:TaskbarIcon x:Key="TrayIcon"
                  ToolTipText="{x:Static r:CommonText.ProductName}"
                  MenuActivation="LeftOrRightClick"
                  NoLeftClickDelay="True">

    <tb:TaskbarIcon.ContextMenu>
      <ContextMenu>
        <MenuItem Header="{x:Static r:TrayText.CaptureRegion}" Command="{Binding CaptureRegionCommand}" InputGestureText="{Binding RegionHotkey}" />
        <MenuItem Header="{x:Static r:TrayText.CaptureWindow}" Command="{Binding CaptureWindowCommand}" InputGestureText="{Binding WindowHotkey}" />
        <MenuItem Header="{x:Static r:TrayText.CaptureFullScreen}" Command="{Binding CaptureFullScreenCommand}" InputGestureText="{Binding FullScreenHotkey}" />
        <MenuItem Header="{x:Static r:TrayText.CaptureScrolling}" Command="{Binding CaptureScrollingCommand}" InputGestureText="{Binding ScrollingHotkey}" />
        <MenuItem Header="{x:Static r:TrayText.CaptureText}" Command="{Binding CaptureTextCommand}" InputGestureText="{Binding TextHotkey}" />
        <MenuItem Header="{x:Static r:TrayText.MoreCaptures}">
          <MenuItem Header="{x:Static r:TrayText.FixedRegion}" Command="{Binding CaptureFixedRegionCommand}" InputGestureText="{Binding FixedRegionHotkey}" />
          <MenuItem Header="{x:Static r:TrayText.FreehandRegion}" Command="{Binding CaptureFreehandCommand}" InputGestureText="{Binding FreehandHotkey}" />
          <MenuItem Header="{x:Static r:TrayText.PolygonRegion}" Command="{Binding CapturePolygonCommand}" InputGestureText="{Binding PolygonHotkey}" />
          <MenuItem Header="{x:Static r:TrayText.RoundedRegion}" Command="{Binding CaptureRoundedRegionCommand}" InputGestureText="{Binding RoundedRegionHotkey}" />
          <Separator />
          <MenuItem Header="{x:Static r:TrayText.ObjectCapture}" Command="{Binding CaptureObjectCommand}" InputGestureText="{Binding ObjectHotkey}" />
          <MenuItem Header="{x:Static r:TrayText.OpenMenu}" Command="{Binding CaptureMenuCommand}" InputGestureText="{Binding MenuHotkey}" />
        </MenuItem>
        <MenuItem Header="{x:Static r:TrayText.RepeatLastCapture}" Command="{Binding RepeatLastCaptureCommand}" InputGestureText="{Binding RepeatHotkey}" />
        <MenuItem Header="{x:Static r:TrayText.CaptureToolbar}" IsCheckable="True" IsChecked="{Binding IsToolbarVisible, Mode=OneWay}"
                  Command="{Binding ToggleToolbarCommand}" InputGestureText="{Binding ToolbarHotkey}" />
        <MenuItem Header="{x:Static r:TrayText.Tools}">
          <MenuItem Header="{x:Static r:TrayText.Magnifier}" Command="{Binding ToggleMagnifierCommand}" InputGestureText="{Binding MagnifierHotkey}" />
          <MenuItem Header="{x:Static r:TrayText.ColorPicker}" Command="{Binding PickColorCommand}" InputGestureText="{Binding ColorPickerHotkey}" />
          <MenuItem Header="{x:Static r:TrayText.ScreenRuler}" IsCheckable="True" IsChecked="{Binding IsRulerVisible, Mode=OneWay}" Command="{Binding ToggleRulerCommand}" InputGestureText="{Binding RulerHotkey}" />
          <MenuItem Header="{x:Static r:TrayText.Crosshair}" IsCheckable="True" IsChecked="{Binding IsCrosshairVisible, Mode=OneWay}" Command="{Binding ToggleCrosshairCommand}" InputGestureText="{Binding CrosshairHotkey}" />
          <Separator />
          <MenuItem Header="{x:Static r:TrayText.BatchProcess}" Command="{Binding BatchProcessCommand}" />
          <MenuItem Header="{x:Static r:TrayText.CombineImages}" Command="{Binding CombineImagesCommand}" />
          <MenuItem Header="{x:Static r:TrayText.ImagesToPdf}" Command="{Binding ImagesToPdfCommand}" />
        </MenuItem>
        <MenuItem Header="{Binding DelayHeader}" ItemsSource="{Binding DelayChoices}">
          <MenuItem.ItemContainerStyle>
            <Style TargetType="MenuItem">
              <Setter Property="Header" Value="{Binding Label}" />
              <Setter Property="IsChecked" Value="{Binding IsChecked, Mode=OneWay}" />
              <Setter Property="Command" Value="{Binding SelectCommand}" />
            </Style>
          </MenuItem.ItemContainerStyle>
        </MenuItem>
        <Separator />
        <MenuItem Header="{Binding RecordText}" Command="{Binding ToggleRecordingCommand}" InputGestureText="{Binding RecordHotkey}" />
        <MenuItem Header="{x:Static r:TrayText.AddOverlays}" Command="{Binding AddOverlaysCommand}" />
        <MenuItem Header="{x:Static r:TrayText.VideoEditor}">
          <MenuItem Header="{x:Static r:TrayText.OpenRecordingOrProject}" Command="{Binding OpenVideoEditorCommand}" />
          <MenuItem Header="{Binding EditLastRecordingText}" Command="{Binding EditLastRecordingCommand}" IsEnabled="{Binding HasLastRecording}" />
        </MenuItem>
        <MenuItem Header="{x:Static r:TrayText.SaveInterruptedRecordings}" Command="{Binding RecoverRecordingsCommand}"
                  Visibility="{Binding HasInterruptedRecordings, Converter={StaticResource TrayVisible}}" />
        <Separator />
        <MenuItem Header="{x:Static r:TrayText.RecentCaptures}" ItemsSource="{Binding RecentCaptures}" IsEnabled="{Binding HasRecentCaptures}">
          <MenuItem.ItemContainerStyle>
            <Style TargetType="MenuItem">
              <Setter Property="Command" Value="{Binding Open}" />
              <!-- The header is a picture and two lines (the item itself would be read as its type's name): a screen reader gets when and what. -->
              <Setter Property="AutomationProperties.Name" Value="{Binding Item.Label}" />
              <Setter Property="HeaderTemplate">
                <Setter.Value>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                      <Border Width="64" Height="40" Background="{p:Chrome Subtle}" Margin="0,0,10,0">
                        <Image FlowDirection="LeftToRight" Source="{Binding Item.Thumbnail}" Stretch="Uniform" StretchDirection="DownOnly"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                      </Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Item.When}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Item.Description}" Opacity="0.75" />
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </MenuItem.ItemContainerStyle>
        </MenuItem>
        <MenuItem Header="{x:Static r:TrayText.CaptureHistory}" Command="{Binding OpenHistoryCommand}" />
        <Separator />
        <MenuItem Header="{Binding UpdateText}" Command="{Binding RestartToUpdateCommand}"
                  Visibility="{Binding IsUpdateReady, Converter={StaticResource TrayVisible}}" />
        <MenuItem Header="{x:Static r:TrayText.Settings}" Command="{Binding OpenSettingsCommand}" />
        <MenuItem Header="{x:Static r:TrayText.ExportDiagnostics}" Command="{Binding ExportDiagnosticsCommand}" />
        <Separator />
        <MenuItem Header="{x:Static r:TrayText.Exit}" Command="{Binding ExitCommand}" />
      </ContextMenu>
    </tb:TaskbarIcon.ContextMenu>
  </tb:TaskbarIcon>

</ResourceDictionary>
