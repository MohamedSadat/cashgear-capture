<local:ImageToolWindow x:Class="CashGear.Capture.App.ImageTools.CombineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:CashGear.Capture.App.Platform"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CashGear.Capture.App.ImageTools"
        xmlns:editor="clr-namespace:CashGear.Capture.App.Editor"
        xmlns:r="clr-namespace:CashGear.Capture.App.Resources"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:CombineViewModel}"
        Title="{x:Static r:ImageToolsText.CombineTitle}" Width="980" Height="640" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <local:ImageListTemplate />
        <editor:EditParameterTemplates />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="Visible" />
    </ResourceDictionary>
  </Window.Resources>

  <!-- In Tab order: the content, then the buttons at the bottom. -->
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>

      <ContentControl Content="{Binding List}" Focusable="False" x:Name="ListHost" />

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel>
          <TextBlock Text="{x:Static r:ImageToolsText.Layout}" />
          <ComboBox Margin="0,2,0,0" ItemsSource="{Binding Layouts}" SelectedItem="{Binding Layout}" DisplayMemberPath="Label" AutomationProperties.Name="{x:Static r:ImageToolsText.Layout}" />
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding ShowColumns, Converter={StaticResource Visible}}">
            <TextBlock Text="{x:Static r:ImageToolsText.Columns}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Text="{Binding Columns}" Width="60" AutomationProperties.Name="{x:Static r:ImageToolsText.Columns}" />
          </StackPanel>
          <TextBlock Text="{x:Static r:ImageToolsText.Aligned}" Margin="0,8,0,0" />
          <ComboBox Margin="0,2,0,0" ItemsSource="{Binding Alignments}" SelectedItem="{Binding Alignment}" DisplayMemberPath="Label" AutomationProperties.Name="{x:Static r:ImageToolsText.Aligned}" />
          <TextBlock Margin="0,8,0,0" Text="{Binding Spacing, Mode=OneWay, StringFormat={x:Static r:ImageToolsText.SpaceBetweenFormat}}" />
          <Slider Minimum="0" Maximum="100" Value="{Binding Spacing}" IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.Name="{x:Static r:ImageToolsText.SpaceBetween}" />
          <TextBlock Margin="0,8,0,0" Text="{Binding Margin, Mode=OneWay, StringFormat={x:Static r:ImageToolsText.BorderAroundFormat}}" />
          <Slider Minimum="0" Maximum="100" Value="{Binding Margin}" IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.Name="{x:Static r:ImageToolsText.BorderAround}" />
          <ContentControl Content="{Binding Background}" Focusable="False" />
        </StackPanel>
      </ScrollViewer>

      <DockPanel Grid.Column="4">
        <TextBlock DockPanel.Dock="Top" Text="{Binding SizeText}" Margin="0,0,0,6" Opacity="0.8" />
        <Border BorderBrush="{p:Chrome Separator}" BorderThickness="1">
          <Image FlowDirection="LeftToRight" Source="{Binding Preview}" Stretch="Uniform" StretchDirection="DownOnly" Margin="8" />
        </Border>
      </DockPanel>
    </Grid>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <TextBlock Text="{Binding Error}" Foreground="{p:Chrome Error}" VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="460" TextWrapping="Wrap" p:LiveText.IsLive="True" />
      <Button Content="{x:Static r:EditorText.SaveAs}" Command="{Binding SaveAsCommand}" MinWidth="90" Margin="0,0,8,0" />
      <Button Content="{x:Static r:ImageToolsText.OpenInEditor}" Command="{Binding OpenInEditorCommand}" IsDefault="True" FontWeight="SemiBold" />
    </StackPanel>
  </Grid>
</local:ImageToolWindow>
