<local:ImageToolWindow x:Class="CashGear.Capture.App.ImageTools.BatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:CashGear.Capture.App.Platform"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CashGear.Capture.App.ImageTools"
        xmlns:r="clr-namespace:CashGear.Capture.App.Resources"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:BatchViewModel}"
        Title="{x:Static r:ImageToolsText.BatchTitle}" Width="860" Height="640" MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <local:ImageListTemplate />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="Visible" />
      <Style x:Key="Section" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,12,0,4" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <!-- In Tab order: the content, then the buttons at the bottom. -->
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>

      <ContentControl Content="{Binding List}" Focusable="False" x:Name="ListHost" />

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="0,0,8,0">
          <TextBlock Style="{StaticResource Section}" Text="{x:Static r:ImageToolsText.SectionSize}" Margin="0,0,0,4" />
          <ComboBox ItemsSource="{Binding ResizeModes}" SelectedItem="{Binding Resize}" DisplayMemberPath="Label" AutomationProperties.Name="{x:Static r:ImageToolsText.Size}" />
          <WrapPanel Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowPercent, Converter={StaticResource Visible}}" Margin="0,0,12,0">
              <TextBox Text="{Binding Percent}" Width="60" AutomationProperties.Name="{x:Static r:ImageToolsText.Percent}" />
              <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowWidth, Converter={StaticResource Visible}}" Margin="0,0,12,0">
              <TextBlock Text="{x:Static r:ImageToolsText.Width}" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBox Text="{Binding Width}" Width="70" AutomationProperties.Name="{x:Static r:ImageToolsText.Width}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowHeight, Converter={StaticResource Visible}}" Margin="0,0,12,0">
              <TextBlock Text="{x:Static r:ImageToolsText.Height}" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBox Text="{Binding Height}" Width="70" AutomationProperties.Name="{x:Static r:ImageToolsText.Height}" />
            </StackPanel>
          </WrapPanel>
          <CheckBox Content="{x:Static r:ImageToolsText.NeverLarger}" IsChecked="{Binding OnlyShrink}" Margin="0,6,0,0"
                    Visibility="{Binding ShowOnlyShrink, Converter={StaticResource Visible}}" />

          <TextBlock Style="{StaticResource Section}" Text="{x:Static r:ImageToolsText.SectionEffects}" />
          <ComboBox ItemsSource="{Binding EffectPresets}" SelectedItem="{Binding EffectsPreset}" AutomationProperties.Name="{x:Static r:ImageToolsText.EffectsPreset}" />

          <TextBlock Style="{StaticResource Section}" Text="{x:Static r:ImageToolsText.SectionWatermark}" />
          <ComboBox ItemsSource="{Binding WatermarkPresets}" SelectedItem="{Binding WatermarkPreset}" AutomationProperties.Name="{x:Static r:ImageToolsText.WatermarkPreset}" />

          <TextBlock Style="{StaticResource Section}" Text="{x:Static r:ImageToolsText.SectionFormat}" />
          <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}" DisplayMemberPath="Label" AutomationProperties.Name="{x:Static r:ImageToolsText.FileFormat}" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding ShowJpegQuality, Converter={StaticResource Visible}}">
            <TextBlock Text="{x:Static r:ImageToolsText.JpegQuality}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Slider Minimum="1" Maximum="100" Value="{Binding JpegQuality}" Width="180" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" AutomationProperties.Name="{x:Static r:ImageToolsText.JpegQuality}" />
            <TextBlock Text="{Binding JpegQuality}" VerticalAlignment="Center" Margin="8,0,0,0" />
          </StackPanel>

          <TextBlock Style="{StaticResource Section}" Text="{x:Static r:ImageToolsText.SectionNames}" />
          <TextBox FlowDirection="LeftToRight" Text="{Binding NameTemplate, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:ImageToolsText.NameTemplate}" />
          <TextBlock Margin="0,4,0,0" Opacity="0.8" TextWrapping="Wrap">
            <Run Text="{x:Static r:ImageToolsText.ForExample}" /> <Run Text="{Binding NameExample, Mode=OneWay}" />
          </TextBlock>
          <TextBlock Text="{Binding NameError}" Foreground="{p:Chrome Error}" TextWrapping="Wrap" p:LiveText.IsLive="True" />
          <TextBlock Margin="0,4,0,0" Opacity="0.7" TextWrapping="Wrap"
                     Text="{x:Static r:ImageToolsText.TokensHelp}" />

          <TextBlock Style="{StaticResource Section}" Text="{x:Static r:ImageToolsText.SectionOutput}" />
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="{x:Static r:CommonText.Browse}" Command="{Binding BrowseOutputCommand}" Margin="6,0,0,0" />
            <TextBox FlowDirection="LeftToRight" Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:ImageToolsText.OutputFolder}" />
          </DockPanel>
          <DockPanel Margin="0,6,0,0">
            <TextBlock Text="{x:Static r:ImageToolsText.WhenNameTaken}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding ExistingChoices}" SelectedItem="{Binding Existing}" DisplayMemberPath="Label" AutomationProperties.Name="{x:Static r:ImageToolsText.WhenNameTaken}" />
          </DockPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Progress and the buttons -->
    <StackPanel Grid.Row="1" Margin="0,12,0,0">
      <ProgressBar Height="6" Maximum="100" Value="{Binding Progress}" AutomationProperties.Name="{x:Static r:ImageToolsText.Progress}" />
      <TextBlock Text="{Binding Status}" Margin="0,6,0,0" TextWrapping="Wrap" p:LiveText.IsLive="True" />
      <ItemsControl ItemsSource="{Binding Failures}" MaxHeight="90" Margin="0,4,0,0" Foreground="{p:Chrome Error}">
        <ItemsControl.Template>
          <ControlTemplate TargetType="ItemsControl">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsPresenter />
            </ScrollViewer>
          </ControlTemplate>
        </ItemsControl.Template>
      </ItemsControl>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
        <Button Content="{x:Static r:ImageToolsText.ShowResults}" Command="{Binding OpenOutputCommand}" Margin="0,0,8,0" />
        <Button Content="{x:Static r:CommonText.Cancel}" Command="{Binding CancelCommand}" MinWidth="90" Margin="0,0,8,0" />
        <Button Content="{x:Static r:ImageToolsText.Start}" Command="{Binding StartCommand}" MinWidth="90" IsDefault="True" FontWeight="SemiBold" />
      </StackPanel>
    </StackPanel>
  </Grid>
</local:ImageToolWindow>
