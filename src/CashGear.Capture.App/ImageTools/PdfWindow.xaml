<local:ImageToolWindow x:Class="CashGear.Capture.App.ImageTools.PdfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CashGear.Capture.App.ImageTools"
        xmlns:settings="clr-namespace:CashGear.Capture.App.Settings"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:PdfToolViewModel}"
        Title="Images to PDF – CashGear Capture" Width="780" Height="580" MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <local:ImageListTemplate />
      </ResourceDictionary.MergedDictionaries>
      <settings:EnumLabelConverter x:Key="Label" />
      <DataTemplate x:Key="EnumItem">
        <TextBlock Text="{Binding Converter={StaticResource Label}}" />
      </DataTemplate>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <ProgressBar Height="6" Maximum="100" Value="{Binding Progress}" />
      <TextBlock Text="{Binding Status}" Margin="0,6,0,0" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
        <Button Content="Open the PDF" Command="{Binding OpenCommand}" Margin="0,0,8,0" />
        <Button Content="Show in folder" Command="{Binding ShowInFolderCommand}" Margin="0,0,8,0" />
        <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="90" Margin="0,0,8,0" />
        <Button Content="Make the PDF…" Command="{Binding MakeCommand}" IsDefault="True" FontWeight="SemiBold" />
      </StackPanel>
    </StackPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>

      <ContentControl Content="{Binding List}" Focusable="False" x:Name="ListHost" />

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="0,0,8,0">
          <TextBlock Text="Paper" />
          <ComboBox Margin="0,2,0,8" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" ItemTemplate="{StaticResource EnumItem}" AutomationProperties.Name="Paper" />
          <TextBlock Text="Orientation" />
          <ComboBox Margin="0,2,0,8" ItemsSource="{Binding Orientations}" SelectedItem="{Binding Orientation}" ItemTemplate="{StaticResource EnumItem}" AutomationProperties.Name="Orientation" />
          <TextBlock Text="Size on the page" />
          <ComboBox Margin="0,2,0,8" ItemsSource="{Binding Fits}" SelectedItem="{Binding Fit}" ItemTemplate="{StaticResource EnumItem}" AutomationProperties.Name="Size on the page" />
          <TextBlock><Run Text="Margins: " /><Run Text="{Binding MarginMm, Mode=OneWay}" /><Run Text=" mm" /></TextBlock>
          <Slider Minimum="0" Maximum="50" Value="{Binding MarginMm}" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,2,0,8" AutomationProperties.Name="Margins in millimetres" />
          <TextBlock Text="{Binding PerPageText}" />
          <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
            <TextBlock Text="Across" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Text="{Binding Columns}" Width="50" AutomationProperties.Name="Pictures across" />
            <TextBlock Text="Down" VerticalAlignment="Center" Margin="16,0,6,0" />
            <TextBox Text="{Binding Rows}" Width="50" AutomationProperties.Name="Pictures down" />
          </StackPanel>
          <TextBlock><Run Text="Space between pictures: " /><Run Text="{Binding SpacingMm, Mode=OneWay}" /><Run Text=" mm" /></TextBlock>
          <Slider Minimum="0" Maximum="30" Value="{Binding SpacingMm}" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,2,0,8" AutomationProperties.Name="Space between pictures" />
          <CheckBox Content="Smaller file (pictures stored as JPEG)" IsChecked="{Binding SmallerFile}" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</local:ImageToolWindow>
