<ResourceDictionary x:Class="CashGear.Capture.App.ImageTools.ImageListTemplate"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CashGear.Capture.App.ImageTools">
  <!-- The list of pictures every image tool starts with: add files or a folder, drag them in, order them. -->
  <DataTemplate DataType="{x:Type local:ImageListViewModel}">
    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="{Binding CountText}" Margin="0,0,0,4" TextWrapping="Wrap" />
      <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
        <Button Content="Add files…" Command="{Binding AddFilesCommand}" Margin="0,0,4,4" />
        <Button Content="Add a folder…" Command="{Binding AddFolderCommand}" Margin="0,0,4,4" />
        <Button Content="Remove" Command="{Binding RemoveCommand}" Margin="0,0,4,4" />
        <Button Content="↑" Command="{Binding MoveUpCommand}" ToolTip="Earlier" AutomationProperties.Name="Move up" MinWidth="32" Margin="0,0,4,4" />
        <Button Content="↓" Command="{Binding MoveDownCommand}" ToolTip="Later" AutomationProperties.Name="Move down" MinWidth="32" Margin="0,0,4,4" />
        <Button Content="Clear" Command="{Binding ClearCommand}" Margin="0,0,4,4" />
        <CheckBox Content="With subfolders" IsChecked="{Binding IncludeSubfolders}" VerticalAlignment="Center" Margin="4,0,0,4" />
      </WrapPanel>
      <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding Selected}" AllowDrop="True" AutomationProperties.Name="Pictures"
               VirtualizingPanel.IsVirtualizing="True">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type local:ImageFileItem}">
            <TextBlock Text="{Binding Name}" ToolTip="{Binding Path}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </DataTemplate>
</ResourceDictionary>
