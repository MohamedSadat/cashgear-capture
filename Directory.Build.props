<Project>

  <PropertyGroup>
    <!-- Single source of truth for the Windows TFM. Keep the 4th revision at .0 (CsWinRT 2.x projection). -->
    <CashGearWindowsTfm>net10.0-windows10.0.22621.0</CashGearWindowsTfm>
    <CashGearMinWindowsVersion>10.0.19041.0</CashGearMinWindowsVersion>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <Company>CashGear</Company>
    <Product>CashGear Capture</Product>
    <Version>1.1.0</Version>

    <!-- A new security advisory on a package must never break the build. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <!--
    Localization (docs\localization.md): every project under src\ turns its .resx files into classes and is checked
    for user-visible text outside them (CG0001 in C#, CG0002 in XAML) and for missing or mismatched translations.
  -->
  <PropertyGroup>
    <CashGearLocalized Condition="'$(CashGearLocalized)' == '' and $(MSBuildProjectDirectory.Contains('\src\')) and '$(MSBuildProjectName)' != 'CashGear.Capture.Analyzers'">true</CashGearLocalized>
  </PropertyGroup>

  <ItemGroup Condition="'$(CashGearLocalized)' == 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src\CashGear.Capture.Analyzers\CashGear.Capture.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <AdditionalFiles Include="**\*.resx;**\*.xaml" Exclude="bin\**;obj\**" />
    <CompilerVisibleProperty Include="RootNamespace" />
    <CompilerVisibleProperty Include="MSBuildProjectDirectory" />
  </ItemGroup>

  <!-- Until every string is in a .resx file: build with -p:CashGearStringCheck=true to list what is left. -->
  <PropertyGroup Condition="'$(CashGearLocalized)' == 'true' and '$(CashGearStringCheck)' != 'true'">
    <NoWarn>$(NoWarn);CG0001;CG0002</NoWarn>
  </PropertyGroup>

</Project>
