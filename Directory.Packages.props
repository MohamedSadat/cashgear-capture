<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Hosting / DI / logging">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup Label="UI">
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageVersion Include="Velopack" Version="1.2.161" />
    <!-- Crash reports, only when the user agrees and the build has an address (docs\LICENSES.md). -->
    <PackageVersion Include="Sentry" Version="6.12.1" />
  </ItemGroup>

  <ItemGroup Label="Capture">
    <PackageVersion Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageVersion Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageVersion Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup Label="Recording">
    <PackageVersion Include="NAudio.Wasapi" Version="3.1.0" />
    <!-- Must match the FFmpeg major version in tools\ffmpeg (9.0); FfmpegRuntime refuses to run on a mismatch. -->
    <PackageVersion Include="FFmpeg.AutoGen.Abstractions" Version="9.0.1.1" />
    <PackageVersion Include="FFmpeg.AutoGen.Bindings.DynamicallyLoaded" Version="9.0.1.1" />
  </ItemGroup>

  <ItemGroup Label="Output destinations">
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageVersion Include="FluentFTP" Version="55.0.0" />
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <!-- Ed25519 for licences; the version SSH.NET already brings. -->
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Transcription">
    <!-- whisper.cpp for .NET (MIT): the CPU runtime and the Vulkan one for graphics cards; models are downloaded on demand. -->
    <PackageVersion Include="Whisper.net" Version="1.9.1" />
    <PackageVersion Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageVersion Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
  </ItemGroup>

  <ItemGroup Label="Editor">
    <PackageVersion Include="SkiaSharp" Version="4.153.1" />
    <!-- Text shaping (Arabic letters joined, right-to-left runs); must match SkiaSharp's version. -->
    <PackageVersion Include="SkiaSharp.HarfBuzz" Version="4.153.1" />
    <PackageVersion Include="SkiaSharp.Views.WPF" Version="4.153.1" />
  </ItemGroup>

  <ItemGroup Label="Build">
    <!-- The localization analyzer and .resx generator (src\CashGear.Capture.Analyzers); no newer than the SDK's compiler. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <!-- An SSH server with SFTP, so the SFTP tests have a server of their own. -->
    <PackageVersion Include="FxSsh" Version="1.4.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
